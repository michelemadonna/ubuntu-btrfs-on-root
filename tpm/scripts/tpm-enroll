#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

TPM_CONFIG="${TPM_CONFIG:-/etc/tpm.conf}"

log.info() {
	printf '\033[1;36mℹ [INFO]\033[0m %s\n' "$*"
}

log.warn() {
	printf '\033[1;33m⚠ [WARN]\033[0m %s\n' "$*" >&2
}

log.success() {
	printf '\033[1;32m✔ [SUCCESS]\033[0m %s\n' "$*"
}

log.section() {
	printf '\n\033[1;35m◆ ========== %s ==========\033[0m\n' "$*"
}

log.die() {
	local previous_status=$?
	local message=${1:-Fatal error}
	local command_error=${2:-}
	local status=${3:-$previous_status}
	[[ $status =~ ^[0-9]+$ ]] || status=1
	printf '\033[1;31m✖ [ERROR]\033[0m %s\n' "$message" >&2
	((status == 0)) || printf '\033[1;31m✖ [ERROR]\033[0m Command exit status: %s\n' "$status" >&2
	[[ -z $command_error ]] || printf '\033[1;31m✖ [ERROR]\033[0m Command error: %s\n' "$command_error" >&2
	((status != 0)) || status=1
	exit "$status"
}

tpm-enroll.require_root() {
	((EUID == 0)) || log.die "Must be run as root."
}

tpm-enroll.require_file() {
	local path=$1 description=$2
	[[ -r $path ]] || log.die "$description not found or not readable: $path"
}

tpm-enroll.require_nonempty() {
	local name=$1 value=${2:-}
	[[ -n $value ]] || log.die "$name must be configured."
}

tpm-enroll.require_commands() {
	local command_name
	for command_name in "$@"; do
		command -v "$command_name" >/dev/null 2>&1 || log.die "Required command not found: $command_name"
	done
}

tpm-enroll.validate_configuration() {
	tpm-enroll.require_file "$TPM_CONFIG" "TPM configuration"
	# shellcheck source=/dev/null
	source "$TPM_CONFIG"
	tpm-enroll.require_nonempty LUKS_DEVICE "${LUKS_DEVICE:-}"
	tpm-enroll.require_nonempty TPM_DEVICE "${TPM_DEVICE:-}"
	tpm-enroll.require_nonempty TPM_LITERAL_PCRS "${TPM_LITERAL_PCRS:-}"
	tpm-enroll.require_nonempty TPM_SIGNED_PCRS "${TPM_SIGNED_PCRS:-}"
	tpm-enroll.require_nonempty PCR_PUBLIC_KEY "${PCR_PUBLIC_KEY:-}"
	tpm-enroll.require_nonempty LUKS_HEADER_BACKUP_DIR "${LUKS_HEADER_BACKUP_DIR:-}"
	case $TPM_USE_PIN in true | false) ;; *) log.die "TPM_USE_PIN must be true or false." ;; esac
}

tpm-enroll.build_arguments() {
	local wipe_existing=$1
	local -a arguments=(
		"$LUKS_DEVICE"
		"--tpm2-device=$TPM_DEVICE"
		"--tpm2-pcrs=$TPM_LITERAL_PCRS"
		"--tpm2-public-key=$PCR_PUBLIC_KEY"
		"--tpm2-public-key-pcrs=$TPM_SIGNED_PCRS"
		"--tpm2-with-pin=$TPM_USE_PIN"
	)
	case $wipe_existing in
	yes) arguments+=("--wipe-slot=tpm2") ;;
	no) ;;
	*) log.die "wipe_existing must be either yes or no." ;;
	esac
	printf '%s\n' "${arguments[@]}"
}

tpm-enroll.create_header_backup() {
	local backup_directory backup_file
	install -d -m 0700 "$LUKS_HEADER_BACKUP_DIR"
	backup_directory="$(mktemp -d "$LUKS_HEADER_BACKUP_DIR/$(basename "$LUKS_DEVICE")-$(date +%Y%m%d-%H%M%S).XXXXXX")"
	backup_file="$backup_directory/header.img"
	log.info "Back up the LUKS header to $backup_file"
	cryptsetup luksHeaderBackup "$LUKS_DEVICE" --header-backup-file "$backup_file"
	chmod 0600 "$backup_file"
}

tpm-enroll.run() {
	local wipe_existing=""
	local -a enroll_arguments=()
	tpm-enroll.require_root
	tpm-enroll.require_commands basename cryptsetup date grep install mktemp systemd-cryptenroll
	tpm-enroll.validate_configuration

	case ${1:-} in
	'') wipe_existing=no ;;
	--wipe-existing-tpm2) wipe_existing=yes ;;
	*) log.die "Usage: tpm-enroll [--wipe-existing-tpm2]" ;;
	esac
	[[ -b $LUKS_DEVICE ]] || log.die "LUKS_DEVICE is not a block device: $LUKS_DEVICE"
	tpm-enroll.require_file "$PCR_PUBLIC_KEY" "PCR public key"
	cryptsetup isLuks "$LUKS_DEVICE" || log.die "Configured device is not a valid LUKS volume."

	log.section "TPM2 LUKS enrollment"
	tpm-enroll.create_header_backup
	mapfile -t enroll_arguments < <(tpm-enroll.build_arguments "$wipe_existing")
	if [[ $wipe_existing == yes ]]; then
		log.warn "Explicitly removing every existing systemd TPM2 token before enrollment."
	else
		log.info "Preserve all existing password, recovery and TPM2 enrollments."
	fi
	log.info "Enroll literal PCR policy $TPM_LITERAL_PCRS and signed PCR policy $TPM_SIGNED_PCRS"
	systemd-cryptenroll "${enroll_arguments[@]}"
	cryptsetup luksDump "$LUKS_DEVICE" | grep -qi systemd-tpm2 || log.die "No systemd-tpm2 token found after enrollment."
	log.success "TPM enrollment completed and verified"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	tpm-enroll.run "$@"
fi
