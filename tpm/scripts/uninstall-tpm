#!/usr/bin/env bash
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || {
    echo "Run uninstall-tpm as root." >&2
    exit 1
}

rm -f \
    /usr/local/sbin/tpm-enroll \
    /usr/local/sbin/tpm-reseal \
    /usr/local/sbin/tpm-status \
    /usr/local/sbin/uninstall-tpm

echo "TPM helper scripts were removed."
echo "The following items were intentionally preserved:"
echo "  /etc/ubuntu-uki/tpm.conf"
echo "  the TPM token stored in the LUKS header"
echo "  LUKS header backups"