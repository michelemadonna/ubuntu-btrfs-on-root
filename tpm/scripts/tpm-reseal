#!/usr/bin/env bash

set -Eeuo pipefail

log.warn() {
	printf 'WARN: %s\n' "$*" >&2
}

log.die() {
	printf 'ERROR: %s\n' "$*" >&2
	exit 1
}

tpm-reseal.require_root() {
	((EUID == 0)) || log.die "Must be run as root."
}

tpm-reseal.run() {
	tpm-reseal.require_root
	[[ ${1:-} == --wipe-all-tpm2 ]] || {
		cat >&2 <<-'EOF'
			Refusing to remove existing TPM2 enrollments.

			This operation removes every systemd TPM2 token, including tokens
			created by another installed operating system. It does not remove
			password or recovery-key slots.

			To continue intentionally, run:

			    tpm-reseal --wipe-all-tpm2
		EOF
		return 2
	}
	(($# == 1)) || log.die "Usage: tpm-reseal --wipe-all-tpm2"
	command -v tpm-enroll >/dev/null 2>&1 || log.die "Required command not found: tpm-enroll"
	log.warn "Destructive TPM2 token replacement explicitly requested."
	tpm-reseal.enroll
}

tpm-reseal.enroll() {
	tpm-enroll --wipe-existing-tpm2
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	tpm-reseal.run "$@"
fi
