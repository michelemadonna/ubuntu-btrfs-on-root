#!/usr/bin/env bash
# Configuration variables are inherited from install-uki/setup.conf.
# TPM policy variables are loaded dynamically from the installed configuration.
# shellcheck disable=SC2153,SC2154

set -Eeuo pipefail
umask 077

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="${repository_root:-$(cd -- "$script_dir/../.." && pwd)}"
# shellcheck disable=SC1090,SC1091
source "$repository_root/lib/common.sh"

INSTALL_TPM_CONFIG=/etc/tpm.conf
INSTALL_TPM_CMDLINE=/etc/kernel/cmdline

install-tpm.validate_configuration() {
	common.require_nonempty root_dev "${root_dev:-}"
	[[ $root_dev != */* && $root_dev != *..* ]] || log.die "root_dev must be relative to /dev."
}

install-tpm.build_kernel_option() {
	local tpm_device=$1

	printf '%s\n' \
		"rd.luks.options=tpm2-device=${tpm_device},tpm2-measure-pcr=yes,tpm2-pin=yes"
}

install-tpm.merge_kernel_option() {
	local cmdline=$1 option=$2 token
	local -a tokens=()

	for token in $cmdline; do
		[[ $token == rd.luks.options=tpm2-device=* ]] || tokens+=("$token")
	done
	tokens+=("$option")
	printf '%s\n' "${tokens[*]}"
}

install-tpm.install_runtime() {
	log.info "Install TPM configuration at $INSTALL_TPM_CONFIG"
	install -d -m 0755 /etc/uki /usr/sbin
	install -m 0644 "$repository_root/tpm/config/tpm.conf" "$INSTALL_TPM_CONFIG"
	sed -i "s|^LUKS_DEVICE=.*|LUKS_DEVICE=\"/dev/${root_dev}\"|" "$INSTALL_TPM_CONFIG"
	install -m 0755 "$repository_root/tpm/scripts/tpm-enroll" /usr/sbin/tpm-enroll
	install -m 0755 "$repository_root/tpm/scripts/tpm-reseal" /usr/sbin/tpm-reseal
	install -m 0755 "$repository_root/tpm/scripts/tpm-status" /usr/sbin/tpm-status
	rm -f \
		/usr/local/sbin/tpm-enroll \
		/usr/local/sbin/tpm-reseal \
		/usr/local/sbin/tpm-status
}

install-tpm.write_boot_configuration() {
	local option cmdline
	# shellcheck source=/dev/null
	source "$INSTALL_TPM_CONFIG"
	option="$(install-tpm.build_kernel_option "$TPM_DEVICE")"
	cmdline="$(<"$INSTALL_TPM_CMDLINE")"
	install-tpm.merge_kernel_option "$cmdline" "$option" >"$INSTALL_TPM_CMDLINE"
	chmod 0644 "$INSTALL_TPM_CMDLINE"
	log.info "Configured initramfs TPM2 support and kernel option: $option"
	cat >/etc/dracut.conf.d/99_tpm2.conf <<-'EOF'
		add_dracutmodules+=" tpm2-tss crypt "
	EOF
}

install-tpm.print_summary() {
	log.section "TPM integration summary"
	log.summary_item "Status" "installed; enrollment not executed"
	log.summary_item "LUKS device" "/dev/$root_dev"
	log.summary_item "Configuration" "$INSTALL_TPM_CONFIG"
	log.summary_item "PCR public key" "/etc/uki/keys/pcr-public.pem"
	log.summary_item "Enrollment" "/usr/sbin/tpm-enroll"
	log.summary_item "Destructive reseal" "tpm-reseal --wipe-all-tpm2"
	log.warn "Verify a normal LUKS passphrase before TPM enrollment."
	log.success "TPM integration installed without changing LUKS tokens"
}

install-tpm.validate_result() {
	local option
	local TPM_DEVICE

	log.section "Post-summary validation"
	common.require_readable_file "$INSTALL_TPM_CONFIG" "Installed TPM configuration"
	# shellcheck source=/dev/null
	source "$INSTALL_TPM_CONFIG"
	common.require_readable_file /etc/uki/keys/pcr-public.pem "Installed PCR public key"
	[[ -x /usr/sbin/tpm-enroll && -x /usr/sbin/tpm-reseal && -x /usr/sbin/tpm-status ]] ||
		log.die "One or more standalone TPM commands are missing or not executable."
	option="$(install-tpm.build_kernel_option "$TPM_DEVICE")"
	grep -Fq "$option" "$INSTALL_TPM_CMDLINE" || log.die "Kernel command line does not contain the required TPM option."
	log.success "Validated TPM configuration, PCR key, standalone commands and kernel option"
	log.section_end
}

install-tpm.run() {
	local luks_device
	common.require_root
	install-tpm.validate_configuration
	common.require_commands apt-get cryptsetup grep install sed

	log.section "TPM2 LUKS integration"
	log.info "Install systemd cryptenroll and TPM2 runtime dependencies"
	local -a tpm_packages=(systemd-cryptsetup cryptsetup-bin tpm2-tools tpm2-tss libtss2-tcti-tabrmd0)
	if [[ ${suite_type:-ubuntu} == kali ]]; then
		tpm_packages+=(libtss2-esys-3.0.2-0 libtss2-mu-4.0.1-0 libtss2-rc0)
	else
		tpm_packages+=(libtss2-esys-3.0.2-0t64 libtss2-mu-4.0.1-0t64 libtss2-rc0t64)
	fi
	apt-get install -y "${tpm_packages[@]}"

	luks_device="/dev/$root_dev"
	[[ -b $luks_device ]] || log.die "Invalid block device: $luks_device"
	cryptsetup isLuks "$luks_device" || log.die "Device is not a valid LUKS volume: $luks_device"
	common.require_readable_file /etc/uki/keys/pcr-public.pem "UKI PCR public key"
	common.require_readable_file "$INSTALL_TPM_CMDLINE" "UKI kernel command line"

	install-tpm.install_runtime
	install-tpm.write_boot_configuration
	install-tpm.print_summary
	install-tpm.validate_result
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	install-tpm.run
fi
