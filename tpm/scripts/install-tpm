#!/usr/bin/env bash
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || {
    echo "Run install-tpm as root." >&2
    exit 1
}

repository_root="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." &&
        pwd
)"

apt-get install -y \
    systemd-cryptsetup \
    cryptsetup-bin \
    tpm2-tools \
    tpm2-tss \
    libtss2-esys-3.0.2-0t64 \
    libtss2-mu-4.0.1-0t64 \
    libtss2-rc0t64 \
    libtss2-tcti-tabrmd0

luks_device=/dev/$root_dev

#read -r -p "Physical LUKS2 device [/dev/nvme0n1p3]: " luks_device
#luks_device="${luks_device:-/dev/nvme0n1p3}"

[[ -b "$luks_device" ]] || {
    echo "Invalid block device: $luks_device" >&2
    exit 1
}

cryptsetup isLuks "$luks_device" || {
    echo "The device does not contain a valid LUKS volume." >&2
    exit 1
}

[[ -r /etc/uki/keys/pcr-public.pem ]] || {
    echo "Install the UKI component first. The PCR public key is missing." >&2
    exit 1
}

install -d -m 0755 /etc/uki
install -d -m 0755 /usr/local/sbin

install \
    -m 0644 \
    "$repository_root/tpm/config/tpm.conf" \
    /etc/uki/tpm.conf

sed -i \
    "s|^LUKS_DEVICE=.*|LUKS_DEVICE=\"${luks_device}\"|" \
    /etc/uki/tpm.conf

install \
    -m 0755 \
    "$repository_root/tpm/scripts/tpm-enroll" \
    /usr/local/sbin/tpm-enroll

install \
    -m 0755 \
    "$repository_root/tpm/scripts/tpm-reseal" \
    /usr/local/sbin/tpm-reseal

install \
    -m 0755 \
    "$repository_root/tpm/scripts/tpm-status" \
    /usr/local/sbin/tpm-status

echo 'add_dracutmodules+=" tpm2-tss crypt "' > /etc/dracut.conf.d/99_tpm2.conf
if grep -qE 'rd.luks.options=tpm2-device=auto,tpm2-measure-pcr=yes' /etc/kernel/cmdline; then
    echo "The kernel command line already contains the TPM2 options."
else
    echo "Appending TPM2 options to the kernel command line."
    echo "rd.luks.options=tpm2-device=auto,tpm2-measure-pcr=yes" >> /etc/kernel/cmdline
fi

echo
echo "TPM support installed."
echo
echo "Verify a normal LUKS passphrase before enrollment:"
echo "  cryptsetup open --test-passphrase ${luks_device}"
echo
echo "Then run:"
echo "  /usr/local/sbin/tpm-enroll"
echo
echo "Dual-boot note:"
echo "  tpm-enroll preserves existing TPM2 tokens by default."
echo "  Keep TPM_LITERAL_PCRS=\"7\" unless PCR 14 was verified equal on both systems."


