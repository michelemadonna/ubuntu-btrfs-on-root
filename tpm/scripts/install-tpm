#!/usr/bin/env bash
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || {
    echo "Run install-tpm as root." >&2
    exit 1
}

repository_root="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." &&
        pwd
)"

apt-get update

apt-get install -y \
    systemd-cryptsetup \
    cryptsetup-bin

read -r -p "Physical LUKS2 device [/dev/nvme0n1p3]: " luks_device
luks_device="${luks_device:-/dev/nvme0n1p3}"

[[ -b "$luks_device" ]] || {
    echo "Invalid block device: $luks_device" >&2
    exit 1
}

cryptsetup isLuks "$luks_device" || {
    echo "The device does not contain a valid LUKS volume." >&2
    exit 1
}

[[ -r /etc/ubuntu-uki/keys/pcr-public.pem ]] || {
    echo "Install the UKI component first. The PCR public key is missing." >&2
    exit 1
}

install -d -m 0755 /etc/ubuntu-uki
install -d -m 0755 /usr/local/sbin

install \
    -m 0644 \
    "$repository_root/config/tpm.conf" \
    /etc/ubuntu-uki/tpm.conf

sed -i \
    "s|^LUKS_DEVICE=.*|LUKS_DEVICE=\"${luks_device}\"|" \
    /etc/ubuntu-uki/tpm.conf

install \
    -m 0755 \
    "$repository_root/scripts/tpm-enroll" \
    /usr/local/sbin/tpm-enroll

install \
    -m 0755 \
    "$repository_root/scripts/tpm-reseal" \
    /usr/local/sbin/tpm-reseal

install \
    -m 0755 \
    "$repository_root/scripts/tpm-status" \
    /usr/local/sbin/tpm-status

install \
    -m 0755 \
    "$repository_root/scripts/uninstall-tpm" \
    /usr/local/sbin/uninstall-tpm

echo
echo "TPM support installed."
echo
echo "Verify a normal LUKS passphrase before enrollment:"
echo "  cryptsetup open --test-passphrase ${luks_device}"
echo
echo "Then run:"
echo "  /usr/local/sbin/tpm-enroll"
echo
echo "Dual-boot note:"
echo "  tpm-enroll preserves existing TPM2 tokens by default."
echo "  Keep TPM_LITERAL_PCRS=\"7\" unless PCR 14 was verified equal on both systems."

===== tpm/scripts/tpm-enroll =====

#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

source /etc/ubuntu-uki/tpm.conf

log() {
    printf '[tpm] %s\n' "$*"
}

die() {
    printf '[tpm] ERROR: %s\n' "$*" >&2
    exit 1
}

for command in systemd-cryptenroll cryptsetup date grep install; do
    command -v "$command" >/dev/null 2>&1 ||
        die "Required command not found: $command"
done

[[ -b "$LUKS_DEVICE" ]] ||
    die "LUKS_DEVICE is not a block device: $LUKS_DEVICE"

[[ -r "$PCR_PUBLIC_KEY" ]] ||
    die "PCR public key is not readable: $PCR_PUBLIC_KEY"

cryptsetup isLuks "$LUKS_DEVICE" ||
    die "The configured device does not contain a valid LUKS volume"

install -d -m 0700 "$LUKS_HEADER_BACKUP_DIR"

backup_file="$(
    printf '%s/%s-%s.img' \
        "$LUKS_HEADER_BACKUP_DIR" \
        "$(basename "$LUKS_DEVICE")" \
        "$(date +%Y%m%d-%H%M%S)"
)"

log "Backing up the LUKS header to ${backup_file}"

cryptsetup luksHeaderBackup \
    "$LUKS_DEVICE" \
    --header-backup-file "$backup_file"

chmod 0600 "$backup_file"

enroll_arguments=(
    "$LUKS_DEVICE"
    "--tpm2-device=${TPM_DEVICE}"
    "--tpm2-pcrs=${TPM_LITERAL_PCRS}"
    "--tpm2-public-key=${PCR_PUBLIC_KEY}"
    "--tpm2-public-key-pcrs=${TPM_SIGNED_PCRS}"
)

case "$TPM_WIPE_EXISTING" in
    yes)
        log "WARNING: removing all existing TPM2 enrollments first"
        enroll_arguments+=("--wipe-slot=tpm2")
        ;;

    no)
        log "Preserving existing TPM2 enrollments"
        ;;

    *)
        die "TPM_WIPE_EXISTING must be either 'yes' or 'no'"
        ;;
esac

log "Enrolling literal PCRs ${TPM_LITERAL_PCRS} and signed PCRs ${TPM_SIGNED_PCRS}"

systemd-cryptenroll "${enroll_arguments[@]}"

cryptsetup luksDump "$LUKS_DEVICE" |
    grep -qi 'systemd-tpm2' ||
    die "No systemd-tpm2 token was found after enrollment"

log "TPM enrollment completed"
log "Password, recovery-key, and pre-existing TPM2 slots were preserved unless TPM_WIPE_EXISTING=yes"
