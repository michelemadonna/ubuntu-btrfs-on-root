#!/usr/bin/env bash

set -Eeuo pipefail

TPM_CONFIG="${TPM_CONFIG:-/etc/tpm.conf}"

log.die() {
	local previous_status=$?
	local message=${1:-Fatal error}
	local command_error=${2:-}
	local status=${3:-$previous_status}
	[[ $status =~ ^[0-9]+$ ]] || status=1
	printf '\033[1;31m✖ [ERROR]\033[0m %s\n' "$message" >&2
	((status == 0)) || printf '\033[1;31m✖ [ERROR]\033[0m Command exit status: %s\n' "$status" >&2
	[[ -z $command_error ]] || printf '\033[1;31m✖ [ERROR]\033[0m Command error: %s\n' "$command_error" >&2
	((status != 0)) || status=1
	exit "$status"
}

tpm-status.require_root() {
	((EUID == 0)) || log.die "Must be run as root."
}

log.summary_item() {
	local label=$1 value=$2
	printf '  \033[1;36m• %-22s\033[0m %s\n' "$label:" "$value"
}

log.section() {
	printf '\n\033[1;35m◆ ========== %s ==========\033[0m\n' "$*"
}

tpm-status.run() {
	tpm-status.require_root
	[[ -r $TPM_CONFIG ]] || log.die "TPM configuration not found or not readable: $TPM_CONFIG"
	# shellcheck source=/dev/null
	source "$TPM_CONFIG"
	command -v cryptsetup >/dev/null 2>&1 || log.die "Required command not found: cryptsetup"
	command -v systemd-cryptenroll >/dev/null 2>&1 || log.die "Required command not found: systemd-cryptenroll"
	[[ -b $LUKS_DEVICE ]] || log.die "LUKS_DEVICE is invalid: $LUKS_DEVICE"

	log.section "TPM2 LUKS status"
	log.summary_item "LUKS device" "$LUKS_DEVICE"
	log.summary_item "TPM device" "$TPM_DEVICE"
	log.summary_item "Literal PCRs" "$TPM_LITERAL_PCRS"
	log.summary_item "Signed PCRs" "$TPM_SIGNED_PCRS"
	log.summary_item "TPM PIN" "$TPM_USE_PIN"
	log.summary_item "PCR public key" "$PCR_PUBLIC_KEY"
	log.section "Post-summary validation"
	systemd-cryptenroll "$LUKS_DEVICE"
	printf '\n'
	cryptsetup luksDump "$LUKS_DEVICE"
	log.success "Validated access to systemd enrollment metadata and the LUKS header"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	tpm-status.run
fi
