#!/bin/sh

CONFIG="/etc/snapshot-menu.conf"

LISTENER="/usr/libexec/snapshot-key-listener"
PIDFILE="/run/snapshot-key-listener.pid"
MARKER="/run/snapshot-menu-requested"

DEFAULT_TRIGGER="ALT"
DEFAULT_WINDOW_TICKS=20
DEFAULT_RESULT_TICKS=10
DEFAULT_PROBE_TICKS=5
DEFAULT_TTY="/dev/tty1"

#
# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------
#

if [ -r "$CONFIG" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG"
fi

trigger="${SNAPSHOT_TRIGGER:-$DEFAULT_TRIGGER}"
window_ticks="${SNAPSHOT_TRIGGER_WINDOW_TICKS:-$DEFAULT_WINDOW_TICKS}"
result_ticks="${SNAPSHOT_TRIGGER_RESULT_TICKS:-$DEFAULT_RESULT_TICKS}"
probe_ticks="${SNAPSHOT_TRIGGER_PROBE_TICKS:-$DEFAULT_PROBE_TICKS}"
menu_tty="${TTY:-$DEFAULT_TTY}"

case "$window_ticks" in
    ''|*[!0-9]*)
        window_ticks="$DEFAULT_WINDOW_TICKS"
        ;;
esac

case "$result_ticks" in
    ''|*[!0-9]*)
        result_ticks="$DEFAULT_RESULT_TICKS"
        ;;
esac

case "$probe_ticks" in
    ''|*[!0-9]*)
        probe_ticks="$DEFAULT_PROBE_TICKS"
        ;;
esac

if [ -z "$trigger" ]; then
    trigger="$DEFAULT_TRIGGER"
fi

if [ ! -c "$menu_tty" ]; then
    menu_tty="/dev/console"
fi

#
# With no interactive window, retain a minimal interval in which
# the C listener can inspect EVIOCGKEY.
#
if [ "$window_ticks" -eq 0 ] &&
   [ "$probe_ticks" -eq 0 ]; then

    probe_ticks=1
fi

#
# ------------------------------------------------------------
# Silent mode
# ------------------------------------------------------------
#

silent_mode=0

if [ "$window_ticks" -eq 0 ] &&
   [ "$result_ticks" -eq 0 ]; then

    silent_mode=1
fi

#
# ------------------------------------------------------------
# Plymouth
# ------------------------------------------------------------
#

plymouth_active=0
current_message=""

if [ "$silent_mode" -eq 0 ] &&
   command -v plymouth >/dev/null 2>&1 &&
   plymouth --ping >/dev/null 2>&1; then

    plymouth_active=1
fi

#
# ------------------------------------------------------------
# Message helpers
# ------------------------------------------------------------
#

hide_message()
{
    if [ "$silent_mode" -eq 1 ]; then
        return 0
    fi

    if [ "$plymouth_active" -eq 1 ]; then

        if [ -n "$current_message" ]; then
            plymouth hide-message \
                --text="$current_message" \
                >/dev/null 2>&1 || :
        fi

    elif [ -c "$menu_tty" ]; then

        printf '\r\033[2K' \
            >"$menu_tty" 2>/dev/null || :
    fi

    current_message=""
}

show_message()
{
    message="$1"

    if [ "$silent_mode" -eq 1 ]; then
        return 0
    fi

    hide_message
    current_message="$message"

    if [ "$plymouth_active" -eq 1 ]; then

        plymouth display-message \
            --text="$message" \
            >/dev/null 2>&1 || :

    elif [ -c "$menu_tty" ]; then

        printf '\r\033[2K%s' "$message" \
            >"$menu_tty" 2>/dev/null || :
    fi
}

#
# ------------------------------------------------------------
# Listener lifecycle
# ------------------------------------------------------------
#

listener_pid=""

stop_listener()
{
    if [ -z "$listener_pid" ]; then
        rm -f "$PIDFILE"
        return 0
    fi

    if kill -0 "$listener_pid" 2>/dev/null; then

        kill -TERM "$listener_pid" 2>/dev/null || :

        #
        # Give the listener up to 500 ms to run cleanup(), release
        # EVIOCGRAB and close every evdev descriptor.
        #
        count=0

        while kill -0 "$listener_pid" 2>/dev/null &&
              [ "$count" -lt 50 ]; do

            sleep 0.01
            count=$((count + 1))
        done

        #
        # Never allow cryptsetup to start while the listener still
        # owns an EVIOCGRAB. Force termination if cleanup stalled.
        #
        if kill -0 "$listener_pid" 2>/dev/null; then
            kill -KILL "$listener_pid" 2>/dev/null || :
        fi
    fi

    #
    # Reap the child. When the process is dead, the kernel has
    # necessarily closed its evdev descriptors and released every
    # EVIOCGRAB, even if SIGKILL was required.
    #
    wait "$listener_pid" 2>/dev/null || :

    listener_pid=""

    rm -f "$PIDFILE"

    #
    # Small settling interval before systemd-cryptsetup creates its
    # password request. Do not read from the TTY here.
    #
    sleep 0.05
}

#
# ------------------------------------------------------------
# External termination
# ------------------------------------------------------------
#

cleanup_and_exit()
{
    hide_message
    stop_listener
    exit 0
}

trap cleanup_and_exit HUP INT TERM

#
# ------------------------------------------------------------
# Start listener
# ------------------------------------------------------------
#

rm -f "$PIDFILE"

if [ ! -e "$MARKER" ] &&
   [ -x "$LISTENER" ]; then

    "$LISTENER" "$trigger" \
        </dev/null \
        >/dev/null \
        2>&1 &

    listener_pid=$!
fi

#
# ------------------------------------------------------------
# Held-key probe
# ------------------------------------------------------------
#

if [ "$window_ticks" -eq 0 ] &&
   [ ! -e "$MARKER" ] &&
   [ -n "$listener_pid" ]; then

    tick=0

    while [ "$tick" -lt "$probe_ticks" ]; do

        if [ -e "$MARKER" ]; then
            break
        fi

        if ! kill -0 "$listener_pid" 2>/dev/null; then
            break
        fi

        sleep 0.1
        tick=$((tick + 1))
    done
fi

#
# ------------------------------------------------------------
# Interactive trigger window
# ------------------------------------------------------------
#

if [ "$window_ticks" -gt 0 ] &&
   [ ! -e "$MARKER" ]; then

    tick=0

    while [ "$tick" -lt "$window_ticks" ]; do

        if [ -e "$MARKER" ]; then
            break
        fi

        if [ -z "$listener_pid" ] ||
           ! kill -0 "$listener_pid" 2>/dev/null; then

            break
        fi

        remaining_ticks=$((window_ticks - tick))
        remaining_seconds=$((remaining_ticks / 10))
        remaining_tenths=$((remaining_ticks % 10))

        show_message \
            "Press ${trigger} for snapshot menu: ${remaining_seconds}.${remaining_tenths}s"

        sleep 0.1
        tick=$((tick + 1))
    done
fi

#
# ------------------------------------------------------------
# Final result
# ------------------------------------------------------------
#
# Keep EVIOCGRAB active while displaying the result so repeated
# trigger characters cannot enter the future password prompt.
#

if [ "$silent_mode" -eq 0 ]; then

    if [ -e "$MARKER" ]; then
        show_message "Snapshot menu ENABLED"
    else
        show_message "Snapshot menu not requested"
    fi

    if [ "$result_ticks" -gt 0 ]; then

        tick=0

        while [ "$tick" -lt "$result_ticks" ]; do
            sleep 0.1
            tick=$((tick + 1))
        done
    fi

    hide_message
fi

#
# ------------------------------------------------------------
# Release keyboard before cryptsetup
# ------------------------------------------------------------
#

stop_listener

if [ "$silent_mode" -eq 0 ] &&
   [ "$plymouth_active" -eq 0 ] &&
   [ -c "$menu_tty" ]; then

    printf '\n' \
        >"$menu_tty" 2>/dev/null || :
fi

exit 0