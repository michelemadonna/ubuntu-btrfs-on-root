#!/bin/bash

CONFIG="/etc/snapshot-menu.conf"

LISTENER="/usr/libexec/snapshot-key-listener"
PIDFILE="/run/snapshot-key-listener.pid"
MARKER="/run/snapshot-menu-requested"

DEFAULT_TRIGGER="ALT"
DEFAULT_WINDOW_TICKS=20
DEFAULT_RESULT_TICKS=10
DEFAULT_PROBE_TICKS=5
DEFAULT_TTY="/dev/tty1"

snapshot-key-listener-stop.log() {
	printf '<6>snapshot-menu: listener-stop: %s\n' "$1" \
		2>/dev/null >/dev/kmsg || :
}

#
# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------
#

if [ -r "$CONFIG" ]; then
	# shellcheck disable=SC1090
	. "$CONFIG"
fi

trigger="${SNAPSHOT_TRIGGER:-$DEFAULT_TRIGGER}"
window_ticks="${SNAPSHOT_TRIGGER_WINDOW_TICKS:-$DEFAULT_WINDOW_TICKS}"
result_ticks="${SNAPSHOT_TRIGGER_RESULT_TICKS:-$DEFAULT_RESULT_TICKS}"
probe_ticks="${SNAPSHOT_TRIGGER_PROBE_TICKS:-$DEFAULT_PROBE_TICKS}"
menu_tty="${TTY:-$DEFAULT_TTY}"
plymouth_key_fallback="${SNAPSHOT_PLYMOUTH_KEY_FALLBACK:-no}"

#
# ------------------------------------------------------------
# Validate configuration
# ------------------------------------------------------------
#

case "$window_ticks" in
'' | *[!0-9]*)
	window_ticks="$DEFAULT_WINDOW_TICKS"
	;;
esac

case "$result_ticks" in
'' | *[!0-9]*)
	result_ticks="$DEFAULT_RESULT_TICKS"
	;;
esac

case "$probe_ticks" in
'' | *[!0-9]*)
	probe_ticks="$DEFAULT_PROBE_TICKS"
	;;
esac

if [ -z "$trigger" ]; then
	trigger="$DEFAULT_TRIGGER"
fi

if [ ! -c "$menu_tty" ]; then
	menu_tty="/dev/console"
fi

case "$plymouth_key_fallback" in
yes | true | 1)
	plymouth_key_fallback=yes
	;;
*)
	plymouth_key_fallback=no
	;;
esac

#
# A zero interactive window must still allow the C listener to
# inspect the current keyboard state.
#
# Enforce at least one 100 ms probe tick.
#
if [ "$window_ticks" -eq 0 ] &&
	[ "$probe_ticks" -eq 0 ]; then

	probe_ticks=1
fi

#
# ------------------------------------------------------------
# Silent mode
# ------------------------------------------------------------
#
# If both visual timers are zero:
#
#   - do not query or interact with Plymouth;
#   - do not write anything to the console;
#   - still run the C listener for probe_ticks;
#   - detect a trigger already being held.
#

silent_mode=0

if [ "$window_ticks" -eq 0 ] &&
	[ "$result_ticks" -eq 0 ]; then

	silent_mode=1
fi

#
# ------------------------------------------------------------
# Plymouth
# ------------------------------------------------------------
#

plymouth_active=0
current_message=""

if [ "$silent_mode" -eq 0 ] &&
	command -v plymouth >/dev/null 2>&1 &&
	plymouth --ping >/dev/null 2>&1; then

	plymouth_active=1
fi

snapshot-key-listener-stop.log \
	"started trigger=${trigger} window_ticks=${window_ticks} result_ticks=${result_ticks} plymouth_active=${plymouth_active} plymouth_key_fallback=${plymouth_key_fallback} marker_present=$([ -e "$MARKER" ] && printf yes || printf no)"

#
# ------------------------------------------------------------
# Display helpers
# ------------------------------------------------------------
#

snapshot-key-listener-stop.hide_message() {
	if [ "$silent_mode" -eq 1 ]; then
		return 0
	fi

	if [ "$plymouth_active" -eq 1 ]; then

		if [ -n "$current_message" ]; then
			plymouth hide-message \
				--text="$current_message" \
				>/dev/null 2>&1 || :
		fi

	elif [ -c "$menu_tty" ]; then

		printf '\r\033[2K' \
			>"$menu_tty" 2>/dev/null || :
	fi

	current_message=""
}

snapshot-key-listener-stop.show_message() {
	message="$1"

	if [ "$silent_mode" -eq 1 ]; then
		return 0
	fi

	snapshot-key-listener-stop.hide_message
	current_message="$message"

	if [ "$plymouth_active" -eq 1 ]; then

		plymouth display-message \
			--text="$message" \
			>/dev/null 2>&1 || :

	elif [ -c "$menu_tty" ]; then

		printf '\r\033[2K%s' "$message" \
			>"$menu_tty" 2>/dev/null || :
	fi
}

#
# ------------------------------------------------------------
# Listener lifecycle
# ------------------------------------------------------------
#

listener_pid=""
plymouth_watch_pid=""

snapshot-key-listener-stop.stop_plymouth_watch() {
	if [ -n "$plymouth_watch_pid" ] &&
		kill -0 "$plymouth_watch_pid" 2>/dev/null; then

		kill -TERM "$plymouth_watch_pid" 2>/dev/null || :
	fi

	if [ -n "$plymouth_watch_pid" ]; then
		wait "$plymouth_watch_pid" 2>/dev/null || :
	fi

	plymouth_watch_pid=""
}

snapshot-key-listener-stop.stop_listener() {
	listener_status="not-started"

	if [ -n "$listener_pid" ] &&
		kill -0 "$listener_pid" 2>/dev/null; then

		snapshot-key-listener-stop.log \
			"stopping listener pid=${listener_pid}"
		kill -TERM "$listener_pid" 2>/dev/null || :

		count=0

		while kill -0 "$listener_pid" 2>/dev/null &&
			[ "$count" -lt 20 ]; do

			sleep 0.01
			count=$((count + 1))
		done
	fi

	if [ -n "$listener_pid" ]; then
		if wait "$listener_pid" 2>/dev/null; then
			listener_status=0
		else
			listener_status=$?
		fi
	fi

	snapshot-key-listener-stop.log \
		"listener finished status=${listener_status} marker_present=$([ -e "$MARKER" ] && printf yes || printf no)"

	listener_pid=""
	rm -f "$PIDFILE"
}

#
# ------------------------------------------------------------
# External termination
# ------------------------------------------------------------
#

# Invoked indirectly by signal traps.
# shellcheck disable=SC2329
snapshot-key-listener-stop.cleanup_and_exit() {
	snapshot-key-listener-stop.stop_listener
	snapshot-key-listener-stop.stop_plymouth_watch
	snapshot-key-listener-stop.hide_message
	exit 0
}

trap snapshot-key-listener-stop.cleanup_and_exit HUP INT TERM

#
# ------------------------------------------------------------
# Start listener
# ------------------------------------------------------------
#
# Do not delete MARKER: it may contain a valid request already
# detected during this boot.
#

rm -f "$PIDFILE"

if [ ! -e "$MARKER" ] &&
	[ -x "$LISTENER" ]; then

	"$LISTENER" "$trigger" \
		</dev/null \
		>/dev/null \
		2>&1 &

	listener_pid=$!
	snapshot-key-listener-stop.log \
		"listener started pid=${listener_pid}"
elif [ -e "$MARKER" ]; then
	snapshot-key-listener-stop.log \
		"listener not started because request marker already exists"
else
	snapshot-key-listener-stop.log \
		"listener not started because executable is missing"
fi

if [ "$plymouth_key_fallback" = yes ] &&
	[ "$plymouth_active" -eq 1 ] &&
	[ ! -e "$MARKER" ]; then

	plymouth watch-keystroke \
		--keys="bB" \
		--command="touch ${MARKER}" \
		</dev/null \
		>/dev/null \
		2>&1 &

	plymouth_watch_pid=$!
	snapshot-key-listener-stop.log \
		"Plymouth key fallback started pid=${plymouth_watch_pid} keys=bB"
fi

#
# ------------------------------------------------------------
# Held-key probe
# ------------------------------------------------------------
#
# When the interactive window is disabled, the C listener is
# allowed to run briefly and inspect EVIOCGKEY.
#
# Nothing is displayed during this phase.
#

if [ "$window_ticks" -eq 0 ] &&
	[ ! -e "$MARKER" ] &&
	[ -n "$listener_pid" ]; then

	tick=0

	while [ "$tick" -lt "$probe_ticks" ]; do

		if [ -e "$MARKER" ]; then
			break
		fi

		#
		# Listener terminated without detecting the trigger.
		#
		if ! kill -0 "$listener_pid" 2>/dev/null; then
			break
		fi

		sleep 0.1
		tick=$((tick + 1))
	done
fi

#
# ------------------------------------------------------------
# Interactive trigger window
# ------------------------------------------------------------
#

if [ "$window_ticks" -gt 0 ] &&
	[ ! -e "$MARKER" ]; then

	tick=0

	while [ "$tick" -lt "$window_ticks" ]; do

		if [ -e "$MARKER" ]; then
			break
		fi

		#
		# An invalid trigger or listener failure must not hold up
		# cryptsetup for the entire configured interval.
		#
		if [ -z "$listener_pid" ] ||
			! kill -0 "$listener_pid" 2>/dev/null; then
			break
		fi

		remaining_ticks=$((window_ticks - tick))
		remaining_seconds=$((remaining_ticks / 10))
		remaining_tenths=$((remaining_ticks % 10))

		snapshot-key-listener-stop.show_message \
			"Press ${trigger} for snapshot menu: ${remaining_seconds}.${remaining_tenths}s"

		sleep 0.1
		tick=$((tick + 1))
	done
fi

#
# ------------------------------------------------------------
# Stop listener
# ------------------------------------------------------------
#

snapshot-key-listener-stop.stop_listener
snapshot-key-listener-stop.stop_plymouth_watch

#
# ------------------------------------------------------------
# Silent completion
# ------------------------------------------------------------
#
# The held-key probe has already happened. Do not touch Plymouth
# or the console when both visual timers are zero.
#

if [ "$silent_mode" -eq 1 ]; then
	exit 0
fi

#
# ------------------------------------------------------------
# Final result
# ------------------------------------------------------------
#

if [ -e "$MARKER" ]; then
	snapshot-key-listener-stop.log "snapshot menu requested"
	if [ "$plymouth_active" -eq 1 ]; then
		plymouth show-splash >/dev/null 2>&1 || :
		snapshot-key-listener-stop.log \
			"Plymouth splash restored after trigger"
	fi
	snapshot-key-listener-stop.show_message "Snapshot menu ENABLED"
else
	snapshot-key-listener-stop.log "snapshot menu not requested"
	if [ "$result_ticks" -gt 0 ]; then
		snapshot-key-listener-stop.show_message "Snapshot menu not requested"
	fi
fi

if [ "$result_ticks" -gt 0 ]; then

	tick=0

	while [ "$tick" -lt "$result_ticks" ]; do
		sleep 0.1
		tick=$((tick + 1))
	done
fi

snapshot-key-listener-stop.hide_message

if [ "$plymouth_active" -eq 0 ] &&
	[ -c "$menu_tty" ]; then

	printf '\n' \
		>"$menu_tty" 2>/dev/null || :
fi

exit 0
