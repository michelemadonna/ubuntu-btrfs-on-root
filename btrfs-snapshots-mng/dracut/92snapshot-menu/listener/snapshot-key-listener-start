#!/bin/bash

CONFIG="/etc/snapshot-menu.conf"
LISTENER="/usr/libexec/snapshot-key-listener"
PIDFILE="/run/snapshot-key-listener.pid"
READY_FILE="/run/snapshot-key-listener.ready"
MARKER="/run/snapshot-menu-requested"

# shellcheck source=/dev/null
. "$CONFIG"

trigger="${SNAPSHOT_TRIGGER:-ALT+B}"

rm -f "$PIDFILE" "$READY_FILE" "$MARKER"

"$LISTENER" "$trigger" --grab \
	</dev/null \
	>/dev/null \
	2>&1 &

listener_pid=$!
tick=0

while [ "$tick" -lt 40 ]; do
	if [ -e "$READY_FILE" ] || [ -e "$MARKER" ]; then
		exit 0
	fi

	if ! kill -0 "$listener_pid" 2>/dev/null; then
		wait "$listener_pid" 2>/dev/null || :
		exit 1
	fi

	sleep 0.05
	tick=$((tick + 1))
done

kill -TERM "$listener_pid" 2>/dev/null || :
wait "$listener_pid" 2>/dev/null || :
exit 1
