#!/usr/bin/env bash
# Configuration variables are loaded from setup.conf.
# shellcheck disable=SC2154

set -Eeuo pipefail
umask 077

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="${repository_root:-$(cd -- "$script_dir/../.." && pwd)}"
module_source="$repository_root/btrfs-snapshots-mng/dracut/92snapshot-menu"
module_target=/usr/lib/dracut/modules.d/92snapshot-menu
menu_config=/etc/snapshot-menu.conf

# shellcheck disable=SC1090,SC1091
source "$repository_root/lib/common.sh"
# shellcheck disable=SC1090,SC1091
source "${SETUP_CONFIG_FILE:-$repository_root/setup.conf}"

btrfs-snapshots-mng-setup.validate_configuration() {
	common.require_nonempty "root_sub_vol" "${root_sub_vol:-}"
	common.require_nonempty "snapshot_menu" "${snapshot_menu:-}"
	common.require_nonempty "snapshot_menu_pin" "${snapshot_menu_pin:-}"

	case $snapshot_menu in
	yes | no) ;;
	*) log.die "snapshot_menu must be either 'yes' or 'no'." ;;
	esac
	case $snapshot_menu_pin in
	yes | no) ;;
	*) log.die "snapshot_menu_pin must be either 'yes' or 'no'." ;;
	esac
	if [[ $snapshot_menu_pin == yes ]]; then
		common.require_nonempty "snapshot_menu_pin_value" "${snapshot_menu_pin_value:-}"
	fi
}

btrfs-snapshots-mng-setup.render_base_config() {
	local root_subvolume=$1
	local distribution_type=${2:-${suite_type:-ubuntu}}
	local snapshot_trigger=ALT+B

	cat <<-EOF
		ROOT_SUBVOL="${root_subvolume}"
		SNAPSHOT_DIR=".snapshots"
		TTY="/dev/tty1"
		MOUNTPOINT="/run/snapshot-menu-root"
		RESULT="/run/snapshot-menu-selected"
		CMDLINE_DIR="/etc/cmdline.d"
		SNAPSHOT_CMDLINE="/etc/cmdline.d/99-snapshot.conf"
		PAGE_SIZE=20
		DESCRIPTION_MAX_LENGTH=24
		SNAPSHOT_TRIGGER="${snapshot_trigger}"
		SNAPSHOT_TRIGGER_WINDOW_TICKS=50
		SNAPSHOT_TRIGGER_RESULT_TICKS=0
	EOF

	if [[ $distribution_type == kali ]]; then
		cat <<-'EOF'
			SNAPSHOT_INPUT_GRAB=yes
			SNAPSHOT_KEEP_ENABLED_MESSAGE=yes
		EOF
	fi
}

btrfs-snapshots-mng-setup.hash_pin() {
	local salt=$1
	local pin=$2

	printf '%s' "${salt}${pin}" | sha256sum | awk '{print $1}'
}

btrfs-snapshots-mng-setup.append_pin_config() {
	local salt=$1
	local pin_hash=$2

	cat <<-EOF

		SNAPSHOT_PIN_ENABLED=yes
		SNAPSHOT_PIN_ATTEMPTS=3
		SNAPSHOT_PIN_MAX_LENGTH=12
		SNAPSHOT_PIN_SALT="${salt}"
		SNAPSHOT_PIN_HASH="${pin_hash}"
	EOF
}

btrfs-snapshots-mng-setup.install_module() {
	local root_subvolume="$root_sub_vol/@"
	local salt
	local pin_hash

	log.section "Snapshot-menu dracut module"
	log.info "Synchronize module source $module_source to $module_target"
	install -d -m 0755 "$module_target"
	rsync -a --delete "$module_source/" "$module_target/"

	log.info "Compile the early keyboard listener with C17 warnings enabled"
	gcc \
		-O2 \
		-Wall \
		-Wextra \
		-Wpedantic \
		-std=c17 \
		-s \
		-o "$module_target/listener/snapshot-key-listener" \
		"$module_target/listener/snapshot-key-listener.c"

	chmod 0755 \
		"$module_target/module-setup.sh" \
		"$module_target/snapshot-menu-hook.sh" \
		"$module_target/snapshot-menu.sh" \
		"$module_target/listener/snapshot-key-listener" \
		"$module_target/listener/snapshot-key-listener-stop" \
		"$module_target/listener/snapshot-key-listener-start"

	log.info "Write snapshot-menu configuration for normal root $root_subvolume"
	btrfs-snapshots-mng-setup.render_base_config \
		"$root_subvolume" \
		"${suite_type:-ubuntu}" \
		>"$menu_config"
	if [[ $snapshot_menu_pin == yes ]]; then
		salt="$(openssl rand -hex 16)"
		pin_hash="$(btrfs-snapshots-mng-setup.hash_pin "$salt" "$snapshot_menu_pin_value")"
		btrfs-snapshots-mng-setup.append_pin_config "$salt" "$pin_hash" >>"$menu_config"
		log.info "Snapshot PIN enabled with three attempts; plaintext PIN is never written or logged"
	else
		log.info "Snapshot PIN disabled"
	fi
	chmod 0644 "$menu_config"

	log.info "Force inclusion of snapshot-menu and overlayfs dracut modules"
	cat >/etc/dracut.conf.d/52-snapshot-menu.conf <<-'EOF'
		force_add_dracutmodules+=" snapshot-menu "
	EOF
	cat >/etc/dracut.conf.d/99_overlayfs.conf <<-'EOF'
		add_dracutmodules+=" overlayfs "
	EOF
	log.success "Snapshot-menu dracut module installed"
}

btrfs-snapshots-mng-setup.print_summary() {
	log.section "Snapshot management summary"
	log.summary_item "Status" "completed successfully"
	log.summary_item "Snapper profiles" "root, home"
	log.summary_item "Snapshot menu" "$snapshot_menu"
	log.summary_item "Snapshot PIN" "$snapshot_menu_pin"
	if [[ $snapshot_menu == yes ]]; then
		log.summary_item "Normal root" "$root_sub_vol/@"
		log.summary_item "Module" "$module_target"
		log.summary_item "Configuration" "$menu_config"
		log.summary_item "Trigger" "ALT+B (5.0 seconds)"
		log.summary_item "Snapshot root" "read-only lower layer + tmpfs overlay"
	fi
	log.success "Btrfs snapshot management setup completed"
}

btrfs-snapshots-mng-setup.validate_result() {
	log.section "Post-summary validation"
	[[ -r /etc/snapper/configs/root ]] || log.die "Snapper root profile is missing."
	[[ -r /etc/snapper/configs/home ]] || log.die "Snapper home profile is missing."
	if [[ $snapshot_menu == yes ]]; then
		[[ -r $menu_config ]] || log.die "Snapshot-menu configuration is missing."
		[[ -x $module_target/snapshot-menu.sh ]] || log.die "Snapshot-menu executable is missing."
		[[ -x $module_target/listener/snapshot-key-listener ]] || log.die "Compiled snapshot key listener is missing."
		grep -Fqx "ROOT_SUBVOL=\"$root_sub_vol/@\"" "$menu_config" || log.die "Snapshot-menu root subvolume is incorrect."
	fi
	log.success "Validated Snapper profiles and configured snapshot-menu artifacts"
	log.section_end
}

btrfs-snapshots-mng-setup.run() {
	common.require_root
	btrfs-snapshots-mng-setup.validate_configuration
	common.require_commands apt-get install rsync

	log.section "Btrfs snapshot management"
	log.info "Install dracut module build and synchronization dependencies"
	apt-get install -y dracut binutils coreutils gcc openssl rsync
	"$script_dir/snapper-setup"

	if [[ $snapshot_menu == yes ]]; then
		common.require_commands awk gcc openssl sha256sum
		btrfs-snapshots-mng-setup.install_module
	else
		log.info "Snapshot menu disabled; skip dracut module installation"
	fi
	btrfs-snapshots-mng-setup.print_summary
	btrfs-snapshots-mng-setup.validate_result
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	btrfs-snapshots-mng-setup.run
fi
