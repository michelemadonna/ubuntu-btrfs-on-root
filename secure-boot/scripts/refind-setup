#!/usr/bin/env bash
# Configuration is supplied by the Secure Boot orchestrator.
# shellcheck disable=SC2154

set -Eeuo pipefail
umask 077

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="${repository_root:-$(cd -- "$script_dir/../.." && pwd)}"
# shellcheck disable=SC1090,SC1091
source "$repository_root/lib/common.sh"

# ============================================================
# Configuration
# ============================================================

ESP="${ESP:-/boot/efi}"

REFIND_EFI="$ESP/EFI/refind"

SHIM_DIR="${SHIM_DIR:-/usr/local/lib/secureboot/shim}"
DB_CERT="${DB_CERT:-/var/lib/sbctl/keys/db/db.pem}"

DEBIAN_SNAPSHOT="${DEBIAN_SNAPSHOT:-20260812}"
DEBIAN_SUITE="${DEBIAN_SUITE:-unstable}"

SNAPSHOT_URL="https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/"

SETUP_MODE="${SETUP_MODE:-}"

TMPROOT=""

# ============================================================
# Helpers
# ============================================================

refind-setup.read_efi_uint8() {
	local name="$1"
	local file

	file="$(
		find /sys/firmware/efi/efivars \
			-maxdepth 1 \
			-name "${name}-*" \
			-print \
			-quit 2>/dev/null
	)"

	[[ -n "$file" ]] || return 1

	od -An -j4 -N1 -t u1 "$file" |
		tr -d '[:space:]'
}

refind-setup.cleanup() {
	[[ -z "${TMPROOT:-}" ]] ||
		rm -rf "$TMPROOT"
}

refind-setup.remove_grubefi_directories() {
	local requested_root=${1:-$ESP/EFI}
	local efi_root
	local directory
	local marker
	local -a directories=()

	efi_root="$(readlink -f -- "$requested_root")"
	[[ -d $efi_root && ${efi_root##*/} == EFI && $efi_root != /EFI ]] ||
		log.die "Refusing GRUB EFI cleanup outside a validated EFI directory: $requested_root"

	while IFS= read -r -d '' directory; do
		directories+=("$directory")
	done < <(find "$efi_root" -mindepth 1 -maxdepth 1 -type d -print0)

	log.section "Obsolete grubx64.efi directory cleanup"
	for directory in "${directories[@]}"; do
		marker="$(find "$directory" -type f -name grubx64.efi -print -quit)"
		[[ -n $marker ]] || continue
		[[ $directory == "$efi_root/"* && $directory != "$efi_root" ]] ||
			log.die "Resolved cleanup target escaped the EFI directory: $directory"
		log.warn "Remove EFI directory $directory because it contains $marker"
		rm -rf -- "$directory"
		[[ ! -e $directory ]] || log.die "Unable to remove obsolete EFI directory: $directory"
		log.success "Removed obsolete EFI directory: $directory"
	done
	log.section_end
}

# ============================================================
# Dependencies
# ============================================================

refind-setup.install_dependencies() {
	apt-get update

	apt-get install -y \
		ca-certificates \
		debconf \
		efibootmgr \
		sbsigntool \
		dosfstools \
		util-linux \
		findutils \
		coreutils \
		unzip

	#
	# Prefer the distribution package.
	#
	if ! command -v refind-install >/dev/null 2>&1; then

		log.info "Try to install rEFInd from the distribution repository"

		if apt-cache show refind >/dev/null 2>&1; then
			apt-get install -y refind || true

		else

			log.info "rEFInd package unavailable in distribution repository"
			log.info "Fall back to pinned Debian Snapshot $DEBIAN_SNAPSHOT"

			refind-setup.download_debian_refind
		fi
	fi
}

# ============================================================
# Local rEFInd
# ============================================================

refind-setup.find_local_refind() {
	if command -v refind-install >/dev/null 2>&1; then
		return 0
	fi

	return 1
}

# ============================================================
# Debian Snapshot fallback
# ============================================================

refind-setup.download_debian_refind() {
	local lists
	local archives
	local sources
	local root

	TMPROOT="$(
		mktemp -d /tmp/refind-snapshot.XXXXXX
	)"

	lists="$TMPROOT/lists"
	archives="$TMPROOT/archives"
	sources="$TMPROOT/sources.list"
	root="$TMPROOT/root"

	mkdir -p \
		"$lists/partial" \
		"$archives/partial" \
		"$root"

	if [[ -r /usr/share/keyrings/debian-archive-keyring.gpg ]]; then

		cat >"$sources" <<-EOF
			deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] $SNAPSHOT_URL $DEBIAN_SUITE main
		EOF

	else

		apt-get install -y debian-archive-keyring || true

		if [[ -r /usr/share/keyrings/debian-archive-keyring.gpg ]]; then

			cat >"$sources" <<-EOF
				deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] $SNAPSHOT_URL $DEBIAN_SUITE main
			EOF

		else

			log.die "Debian archive keyring unavailable; refusing an unverified Snapshot repository."

		fi
	fi

	refind-setup.apt_snapshot() {
		apt-get \
			-o "Dir::Etc::sourcelist=$sources" \
			-o "Dir::Etc::sourceparts=-" \
			-o "Dir::State::lists=$lists" \
			-o "Dir::Cache::archives=$archives" \
			-o "Acquire::Check-Valid-Until=false" \
			"$@"
	}

	log.info "Update temporary Debian Snapshot metadata from $SNAPSHOT_URL"

	refind-setup.apt_snapshot update

	log.info "Download rEFInd from Debian Snapshot suite $DEBIAN_SUITE"

	refind-setup.apt_snapshot \
		--download-only \
		--reinstall \
		-y \
		install \
		refind

	#
	# Extract every refind package downloaded as dependency,
	# e.g. refind-common if present.
	#
	while IFS= read -r -d '' deb; do
		dpkg-deb -x \
			"$deb" \
			"$root"

	done < <(
		find "$archives" \
			-maxdepth 1 \
			-type f \
			-name 'refind*.deb' \
			-print0
	)

	[[ -f "$root/usr/sbin/refind-install" ||
		-f "$root/usr/bin/refind-install" ]] ||
		find "$root" \
			-type f \
			-name refind-install \
			-print \
			-quit |
		grep -q . ||
		log.die "refind-install not found in Debian package."

	#
	# Copy only the extracted Debian payload.
	#
	# dpkg database remains untouched.
	#
	log.info "Install the verified extracted rEFInd payload"

	cp -a "$root"/. /

	refind-setup.find_local_refind ||
		log.die "refind-install unavailable after Debian extraction."
}

# ============================================================
# Direct installation
# ============================================================

refind-setup.install_direct() {
	log.info "Install rEFInd directly on the ESP"

	refind-install --yes

	cat >>"$REFIND_EFI/refind.conf" <<-'EOF'
		#scanfor external,optical,manual
		dont_scan_dirs EFI/systemd,EFI/Linux,ESP:EFI/BOOT
		dont_scan_files shimx64.efi,grubx64.efi,mmx64.efi,fbx64.efi
		linux_prefixes ubuntu,kali
		enable_touch
		enable_mouse
		use_graphics_for osx,linux,windows
		include themes/refind-theme-regular/theme.conf
	EOF

	cp "$REFIND_EFI/refind_x64.efi" "$REFIND_EFI/../BOOT/BOOTX64.EFI"
}

# ============================================================
# Shim installation
# ============================================================

refind-setup.install_with_shim() {
	local shim="$SHIM_DIR/shimx64.efi"
	local mm="$SHIM_DIR/mmx64.efi"
	local work

	[[ -f "$shim" ]] ||
		log.die "Shim not prepared. Run shim-setup first."

	[[ -f "$mm" ]] ||
		log.die "MokManager not prepared. Run shim-setup first."

	work="$(
		mktemp -d /tmp/refind-shim.XXXXXX
	)"

	install -m 0644 \
		"$shim" \
		"$work/shimx64.efi"

	# Explicitly keep the MokManager selected by shim-setup.
	#
	install -m 0644 \
		"$mm" \
		"$work/mmx64.efi"

	log.info "Install rEFInd behind Shim using the prepared MokManager"

	refind-install \
		--shim "$work/shimx64.efi" \
		--keepname --yes

	cat >>"$REFIND_EFI/refind.conf" <<-'EOF'
		#scanfor external,optical,manual
		dont_scan_dirs EFI/systemd,EFI/Linux,ESP:EFI/BOOT
		dont_scan_files grubx64.efi,mmx64.efi,fbx64.efi
		linux_prefixes ubuntu,kali
		enable_touch
		enable_mouse
		use_graphics_for osx,linux,windows
		include themes/refind-theme-regular/theme.conf
	EOF
	cp "$REFIND_EFI/shimx64.efi" "$REFIND_EFI/../BOOT/BOOTX64.EFI"
	cp "$REFIND_EFI/mmx64.efi" "$REFIND_EFI/../BOOT/mmx64.efi"
	cp "$REFIND_EFI/grubx64.efi" "$REFIND_EFI/../BOOT/grubx64.efi"
	rm -rf "$work"
}

#
# Helpers for signing rEFInd and its drivers with sbctl.
#
refind-setup.sign_efi() {
	local file="$1"

	[[ -f "$file" ]] ||
		log.die "EFI file not found: $file"

	log.info "Sign EFI executable with sbctl: $file"

	sbctl sign \
		--save \
		"$file"
}

refind-setup.repository_signed_loader_path() {
	local enrollment_method=$1

	case $enrollment_method in
	mok) printf '%s/grubx64.efi\n' "$REFIND_EFI" ;;
	sbctl) printf '%s/refind_x64.efi\n' "$REFIND_EFI" ;;
	*) return 1 ;;
	esac
}

# ============================================================
# Verify signature
# ============================================================

refind-setup.verify() {
	local refind=""
	if [[ "$secure_boot_enrollment" == mok ]]; then
		refind="$(refind-setup.repository_signed_loader_path "$secure_boot_enrollment")"

		[[ -f "$REFIND_EFI/mmx64.efi" ]] ||
			log.die "MokManager missing from rEFInd directory."
		[[ -f "$REFIND_EFI/shimx64.efi" ]] ||
			log.die "Shim missing from rEFInd directory."
		[[ -f "$refind" ]] ||
			log.die "Shim-chain rEFInd loader missing: $refind"
	else
		refind="$(refind-setup.repository_signed_loader_path "$secure_boot_enrollment")"

		[[ -f "$REFIND_EFI/refind_x64.efi" ]] ||
			log.die "rEFInd EFI binary missing from rEFInd directory."
	fi

	log.info "Verify repository-signed rEFInd loader $refind with $DB_CERT"

	sbverify --cert "$DB_CERT" "$refind" ||
		log.die "rEFInd signature verification failed: $refind"

}

#
# rEFInd and its drivers signing with sbctl.
#
refind-setup.sign_refind() {
	local refind

	refind="$(refind-setup.repository_signed_loader_path "$secure_boot_enrollment")" ||
		log.die "Invalid Secure Boot enrollment method: $secure_boot_enrollment"

	refind-setup.sign_efi "$refind"
	if [[ "$secure_boot_enrollment" == sbctl ]]; then
		refind-setup.sign_efi "$REFIND_EFI/../BOOT/BOOTX64.EFI"
	fi

	if [[ -d "$REFIND_EFI/drivers_x64" ]]; then

		while IFS= read -r -d '' driver; do
			refind-setup.sign_efi "$driver"

		done < <(
			find "$REFIND_EFI/drivers_x64" \
				-maxdepth 1 \
				-type f \
				-name '*.efi' \
				-print0
		)
	fi

}

# ============================================================
# Main
# ============================================================

refind-setup.run() {
	common.require_root
	trap refind-setup.cleanup EXIT

	common.require_commands apt-get debconf-set-selections
	printf '%s\n' "refind refind/install_to_esp boolean false" | debconf-set-selections
	refind-setup.install_dependencies
	common.require_commands apt-cache apt-mark find grep install mktemp readlink rm sbctl sbverify unzip
	refind-setup.remove_grubefi_directories

	if [[ -f /etc/securebootmode.conf ]]; then
		SETUP_MODE="$(</etc/securebootmode.conf)"
	else
		SETUP_MODE="$(
			refind-setup.read_efi_uint8 SetupMode
		)" || log.die "Cannot read UEFI SetupMode."
	fi

	case "$secure_boot_enrollment" in

	sbctl)
		refind-setup.install_direct
		;;

	mok)
		refind-setup.install_with_shim
		;;

	*)
		log.die "Invalid Secure Boot enrollment method: $secure_boot_enrollment"
		;;
	esac

	log.info "Install rEFInd themes into $REFIND_EFI"
	unzip "$repository_root/refind_themes.zip" -d "$REFIND_EFI"

	#
	# Do NOT touch shimx64.efi or mmx64.efi.
	#
	# Sign only rEFInd and its drivers.
	#
	log.info "Sign rEFInd EFI executable and filesystem drivers with sbctl"
	refind-setup.sign_refind

	refind-setup.verify

	apt-mark hold \
		refind \
		grub-common \
		grub2-common \
		grub-pc \
		grub-pc-bin \
		grub-efi-amd64 \
		grub-efi-amd64-bin

	log.success "rEFInd installation, signing and verification completed"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	refind-setup.run
fi
