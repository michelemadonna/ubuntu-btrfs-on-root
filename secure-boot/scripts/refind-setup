#!/usr/bin/env bash

set -Eeuo pipefail


# ============================================================
# Configuration
# ============================================================

ESP="${ESP:-/boot/efi}"

REFIND_EFI="$ESP/EFI/refind"

SHIM_DIR="${SHIM_DIR:-/usr/local/lib/secureboot/shim}"

DEBIAN_SNAPSHOT="${DEBIAN_SNAPSHOT:-20260812}"
DEBIAN_SUITE="${DEBIAN_SUITE:-unstable}"

SNAPSHOT_URL="https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/"

SETUP_MODE="${SETUP_MODE:-}"

REFIND_INSTALL=""

TMPROOT=""

echo "refind refind/install_to_esp boolean false" | debconf-set-selections

# ============================================================
# Helpers
# ============================================================

log()
{
    printf '==> %s\n' "$*"
}

warn()
{
    printf 'WARNING: %s\n' "$*" >&2
}

die()
{
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

read_efi_uint8()
{
    local name="$1"
    local file

    file="$(
        find /sys/firmware/efi/efivars \
            -maxdepth 1 \
            -name "${name}-*" \
            -print \
            -quit 2>/dev/null
    )"

    [[ -n "$file" ]] || return 1

    od -An -j4 -N1 -t u1 "$file" |
        tr -d '[:space:]'
}

cleanup()
{
    [[ -z "${TMPROOT:-}" ]] ||
        rm -rf "$TMPROOT"
}

trap cleanup EXIT


# ============================================================
# Dependencies
# ============================================================

install_dependencies()
{
    apt-get update

    apt-get install -y \
        ca-certificates \
        efibootmgr \
        sbsigntool \
        dosfstools \
        util-linux \
        findutils \
        coreutils

    #
    # Prefer the distribution package.
    #
    if ! command -v refind-install >/dev/null 2>&1; then

        log "Trying to install rEFInd from distribution repository..."

		if apt-cache search refind | grep -q refind; then
			apt-get install -y refind || true

		else

			log "rEFInd package unavailable in distribution repository."
			log "Falling back to Debian Snapshot."

			download_debian_refind
		fi
    fi
}

# ============================================================
# Local rEFInd
# ============================================================

find_local_refind()
{
    if command -v refind-install >/dev/null 2>&1; then

        REFIND_INSTALL="$(
            command -v refind-install
        )"

        return 0
    fi

    return 1
}


# ============================================================
# Debian Snapshot fallback
# ============================================================

download_debian_refind()
{
    local lists
    local archives
    local sources
    local root

    TMPROOT="$(
        mktemp -d /tmp/refind-snapshot.XXXXXX
    )"

    lists="$TMPROOT/lists"
    archives="$TMPROOT/archives"
    sources="$TMPROOT/sources.list"
    root="$TMPROOT/root"

    mkdir -p \
        "$lists/partial" \
        "$archives/partial" \
        "$root"

    if [[ -r /usr/share/keyrings/debian-archive-keyring.gpg ]]; then

        cat > "$sources" <<EOF
deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] $SNAPSHOT_URL $DEBIAN_SUITE main
EOF

    else

        apt-get install -y debian-archive-keyring || true

        if [[ -r /usr/share/keyrings/debian-archive-keyring.gpg ]]; then

            cat > "$sources" <<EOF
deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] $SNAPSHOT_URL $DEBIAN_SUITE main
EOF

        else

            warn "Debian archive keyring unavailable."
            warn "Using HTTPS Snapshot with trusted=yes."

            cat > "$sources" <<EOF
deb [trusted=yes check-valid-until=no] $SNAPSHOT_URL $DEBIAN_SUITE main
EOF

        fi
    fi

    apt_snapshot()
    {
        apt-get \
            -o "Dir::Etc::sourcelist=$sources" \
            -o "Dir::Etc::sourceparts=-" \
            -o "Dir::State::lists=$lists" \
            -o "Dir::Cache::archives=$archives" \
            -o "Acquire::Check-Valid-Until=false" \
            "$@"
    }

    log "Updating temporary Debian Snapshot metadata..."

    apt_snapshot update

    log "Downloading rEFInd from Debian Snapshot..."

    apt_snapshot \
        --download-only \
        --reinstall \
        -y \
        install \
        refind

    #
    # Extract every refind package downloaded as dependency,
    # e.g. refind-common if present.
    #
    while IFS= read -r -d '' deb
    do
        dpkg-deb -x \
            "$deb" \
            "$root"

    done < <(
        find "$archives" \
            -maxdepth 1 \
            -type f \
            -name 'refind*.deb' \
            -print0
    )

    [[ -f "$root/usr/sbin/refind-install" ||
		-f "$root/usr/bin/refind-install" ]] ||
    find "$root" \
        -type f \
        -name refind-install \
        -print \
        -quit |
        grep -q . ||
        die "refind-install not found in Debian package."

    #
    # Copy only the extracted Debian payload.
    #
    # dpkg database remains untouched.
    #
    log "Installing extracted rEFInd payload..."

    cp -a "$root"/. /

    find_local_refind ||
        die "refind-install unavailable after Debian extraction."
}





# ============================================================
# Direct installation
# ============================================================

install_direct()
{
    log "Installing rEFInd directly..."

    refind-install --yes 

	cat >> "$REFIND_EFI/refind.conf" <<- EOF
		#scanfor external,optical,manual
		dont_scan_dirs EFI/systemd,EFI/Linux
		dont_scan_files shimx64.efi,grubx64.efi,mmx64.efi,fbx64.efi
		linux_prefixes ubuntu,kali
		enable_touch
		enable_mouse
		use_graphics_for osx,linux,windows
		include themes/refind-theme-regular/theme.conf
	EOF

    cp "$REFIND_EFI/refind_x64.efi" "$REFIND_EFI/../BOOT/BOOTX64.EFI"
}


# ============================================================
# Shim installation
# ============================================================

install_with_shim()
{
    local shim="$SHIM_DIR/shimx64.efi"
    local mm="$SHIM_DIR/mmx64.efi"
    local work

    [[ -f "$shim" ]] ||
        die "Shim not prepared. Run shim-setup.sh first."

    [[ -f "$mm" ]] ||
        die "MokManager not prepared. Run shim-setup.sh first."

    work="$(
        mktemp -d /tmp/refind-shim.XXXXXX
    )"

    install -m 0644 \
        "$shim" \
        "$work/shimx64.efi"

    # Explicitly keep the MokManager selected by shim-setup.
    #
    install -m 0644 \
        "$mm" \
        "$work/mmx64.efi"

    log "Installing rEFInd through Shim..."

    refind-install \
        --shim "$work/shimx64.efi" \
        --keepname --yes | die "rEFInd installation failed."
	
	cat >> /boot/efi/EFI/refind/refind.conf <<- EOF
		#scanfor external,optical,manual
		dont_scan_dirs EFI/systemd,EFI/Linux
		linux_prefixes ubuntu,kali
		enable_touch
		enable_mouse
		use_graphics_for osx,linux,windows
		include themes/refind-theme-regular/theme.conf
	EOF
    cp "$REFIND_EFI/shimx64.efi" "$REFIND_EFI/../BOOT/BOOTX64.EFI"
    cp "$REFIND_EFI/mmx64.efi" "$REFIND_EFI/../BOOT/mmx64.efi"
    cp "$REFIND_EFI/grubx64.efi" "$REFIND_EFI/../BOOT/grubx64.efi"
    rm -rf "$work"
}

#
# Helpers for signing rEFInd and its drivers with sbctl.
#
sign_efi()
{
    local file="$1"

    [[ -f "$file" ]] ||
        die "EFI file not found: $file"

    log "Signing with sbctl:"
    log "  $file"

    sbctl sign \
        --save \
        "$file"
}

# ============================================================
# Verify signature
# ============================================================

verify()
{   local refind=""
    if [[ "$SETUP_MODE" == "0" ]]; then
        refind="$REFIND_EFI/shimx64.efi"

        [[ -f "$REFIND_EFI/mmx64.efi" ]] ||
            die "MokManager missing from rEFInd directory."
        [[ -f "$REFIND_EFI/shimx64.efi" ]] ||
            die "Shim missing from rEFInd directory."

        [[ -f "$REFIND_EFI/mmx64.efi" ]] ||
            die "MokManager missing from rEFInd directory."
    else
        refind="$REFIND_EFI/refind_x64.efi"
        
        [[ -f "$REFIND_EFI/refind_x64.efi" ]] ||
            die "rEFInd EFI binary missing from rEFInd directory."
    fi

    log "Checking rEFInd signature..."

    if sbverify --cert /var/lib/sbctl/keys/db/db.pem "$refind"; then
        echo "✅ sbverify verification passed"
    else
        echo "❌ sbverify verification failed"
    fi

    
	
}


#
# rEFInd and its drivers signing with sbctl.
#
sign_refind()
{
    local refind=""

    if [[ "$SETUP_MODE" == "0" ]]; then
        refind="$REFIND_EFI/shimx64.efi"
    else
        refind="$REFIND_EFI/refind_x64.efi"
    fi

    sign_efi "$refind"
    if [[ "$SETUP_MODE" == "1" ]]; then
        sign_efi "$REFIND_EFI/../BOOT/BOOTX64.EFI"
    fi
    

    if [[ -d "$REFIND_EFI/drivers_x64" ]]; then

        while IFS= read -r -d '' driver
        do
            sign_efi "$driver"

        done < <(
            find "$REFIND_EFI/drivers_x64" \
                -maxdepth 1 \
                -type f \
                -name '*.efi' \
                -print0
        )
    fi


}



# ============================================================
# Main
# ============================================================

main()
{
    [[ $EUID -eq 0 ]] ||
        die "Run as root."

    install_dependencies

    command -v sbctl >/dev/null 2>&1 ||
        die "sbctl is required. Run sbctl-setup.sh first."

    if [[ -f /etc/securebootmode.conf ]]; then
		SETUP_MODE="$(cat /etc/securebootmode.conf)"
		cat > /etc/securebootmode.conf <<- EOF
			$SETUP_MODE
		EOF
	else
		SETUP_MODE="$(
			read_efi_uint8 SetupMode
		)" || die "Cannot read UEFI SetupMode."
	fi

    case "$SETUP_MODE" in

        1)
            install_direct
            ;;

        0)
            install_with_shim
            ;;

        *)
            die "Invalid SetupMode value: $SETUP_MODE"
            ;;
    esac

	log "Installing rEFInd themes..."
	unzip $repository_root/refind_themes.zip -d /boot/efi/EFI/refind/
	
    #
    # Do NOT touch shimx64.efi or mmx64.efi.
    #
    # Sign only rEFInd and its drivers.
    #
    log "Signing rEFInd EFI and drivers with sbctl..."
    sign_refind

    log "Verifying rEFInd signature..."
    verify
	
	apt-mark hold \
		refind \
		grub-common \
		grub2-common \
		grub-pc \
		grub-pc-bin \
		grub-efi-amd64 \
	grub-efi-amd64-bin



    log "rEFInd setup completed."
}

main "$@"