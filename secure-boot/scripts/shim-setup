#!/usr/bin/env bash

set -Eeuo pipefail


# ============================================================
# Configuration
# ============================================================

SHIM_DIR="${SHIM_DIR:-/usr/local/lib/secureboot/shim}"

SBCTL_KEYROOT="${SBCTL_KEYROOT:-/var/lib/sbctl/keys}"

DB_CERT="${DB_CERT:-$SBCTL_KEYROOT/db/db.pem}"
DB_CERT_DER="${DB_CERT_DER:-$SBCTL_KEYROOT/db/db.cer}"

DEBIAN_SNAPSHOT="${DEBIAN_SNAPSHOT:-20260812}"
DEBIAN_SUITE="${DEBIAN_SUITE:-unstable}"

SNAPSHOT_URL="https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/"

SETUP_MODE="${SETUP_MODE:-}"

TMPROOT=""


# ============================================================
# Helpers
# ============================================================

log()
{
    printf '==> %s\n' "$*"
}

warn()
{
    printf 'WARNING: %s\n' "$*" >&2
}

die()
{
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

read_efi_uint8()
{
    local name="$1"
    local file

    file="$(
        find /sys/firmware/efi/efivars \
            -maxdepth 1 \
            -name "${name}-*" \
            -print \
            -quit 2>/dev/null
    )"

    [[ -n "$file" ]] || return 1

    od -An -j4 -N1 -t u1 "$file" |
        tr -d '[:space:]'
}

cleanup()
{
    [[ -z "${TMPROOT:-}" ]] ||
        rm -rf "$TMPROOT"
}

trap cleanup EXIT


# ============================================================
# Dependencies
# ============================================================

install_dependencies()
{
    export DEBIAN_FRONTEND=noninteractive

    apt-get update

    apt-get install -y \
        ca-certificates \
        openssl \
        mokutil \
        sbsigntool \
        dpkg-dev \
        findutils \
        coreutils

    #
    # Try distro Shim first.
    #
    if ! dpkg-query -W -f='${Status}' shim-signed \
        2>/dev/null |
        grep -q 'install ok installed'
    then

        log "Trying distro shim-signed package..."

        apt-get install -y shim-signed || true
    fi
}


# ============================================================
# DER certificate
# ============================================================

create_der_certificate()
{
    [[ -f "$DB_CERT" ]] ||
        die "Missing sbctl db certificate: $DB_CERT"

    if [[ -f "$DB_CERT_DER" &&
          "$DB_CERT_DER" -nt "$DB_CERT" ]]
    then
        return
    fi

    log "Creating DER certificate for MOK..."

    openssl x509 \
        -in "$DB_CERT" \
        -outform DER \
        -out "$DB_CERT_DER"

    chmod 0644 "$DB_CERT_DER"
}


# ============================================================
# Local Shim
# ============================================================

install_local_shim()
{
    local shim=""
    local mm=""
    local candidate

    for candidate in \
        /usr/lib/shim/shimx64.efi.signed.latest \
        /usr/lib/shim/shimx64.efi.signed \
        /usr/lib/shim/shimx64.efi.dualsigned
    do
        if [[ -f "$candidate" ]]; then
            shim="$candidate"
            break
        fi
    done

    for candidate in \
        /usr/lib/shim/mmx64.efi.signed \
        /usr/lib/shim/mmx64.efi
    do
        if [[ -f "$candidate" ]]; then
            mm="$candidate"
            break
        fi
    done

    [[ -n "$shim" && -n "$mm" ]] ||
        return 1

    install -d -m 0755 "$SHIM_DIR"

    install -m 0644 \
        "$shim" \
        "$SHIM_DIR/shimx64.efi"

    install -m 0644 \
        "$mm" \
        "$SHIM_DIR/mmx64.efi"

    return 0
}


# ============================================================
# Debian Snapshot fallback
# ============================================================

download_debian_shim()
{
    local lists
    local archives
    local sources
    local root
    local shim
    local mm

    TMPROOT="$(mktemp -d /tmp/shim-snapshot.XXXXXX)"

    lists="$TMPROOT/lists"
    archives="$TMPROOT/archives"
    sources="$TMPROOT/sources.list"
    root="$TMPROOT/root"

    mkdir -p \
        "$lists/partial" \
        "$archives/partial" \
        "$root"

    if [[ -r /usr/share/keyrings/debian-archive-keyring.gpg ]]; then

        cat > "$sources" <<EOF
deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] $SNAPSHOT_URL $DEBIAN_SUITE main
EOF

    else

        #
        # Try to obtain Debian archive keys without polluting
        # the permanent sources.
        #
        apt-get install -y debian-archive-keyring || true

        if [[ -r /usr/share/keyrings/debian-archive-keyring.gpg ]]; then

            cat > "$sources" <<EOF
deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] $SNAPSHOT_URL $DEBIAN_SUITE main
EOF

        else

            warn "Debian archive keyring unavailable."
            warn "Using HTTPS Snapshot with trusted=yes."

            cat > "$sources" <<EOF
deb [trusted=yes check-valid-until=no] $SNAPSHOT_URL $DEBIAN_SUITE main
EOF

        fi
    fi

    apt_snapshot()
    {
        apt-get \
            -o "Dir::Etc::sourcelist=$sources" \
            -o "Dir::Etc::sourceparts=-" \
            -o "Dir::State::lists=$lists" \
            -o "Dir::Cache::archives=$archives" \
            -o "Acquire::Check-Valid-Until=false" \
            "$@"
    }

    log "Updating temporary Debian Snapshot metadata..."

    apt_snapshot update

    log "Downloading Shim from Debian Snapshot..."

    apt_snapshot \
        --download-only \
        --reinstall \
        -y \
        install \
        shim-signed \
        shim-helpers-amd64-signed

    while IFS= read -r -d '' deb
    do
        dpkg-deb -x "$deb" "$root"

    done < <(
        find "$archives" \
            -type f \
            -name '*.deb' \
            -print0
    )

    shim="$(
        find "$root/usr/lib/shim" \
            -maxdepth 1 \
            -type f \
            \( \
                -name 'shimx64.efi.signed.latest' \
                -o \
                -name 'shimx64.efi.signed' \
                -o \
                -name 'shimx64.efi.dualsigned' \
            \) \
            -print \
            -quit
    )"

    mm="$(
        find "$root/usr/lib/shim" \
            -maxdepth 1 \
            -type f \
            \( \
                -name 'mmx64.efi.signed' \
                -o \
                -name 'mmx64.efi' \
            \) \
            -print \
            -quit
    )"

    [[ -n "$shim" ]] ||
        die "Signed Shim not found in Debian package."

    [[ -n "$mm" ]] ||
        die "MokManager not found in Debian package."

    install -d -m 0755 "$SHIM_DIR"

    install -m 0644 \
        "$shim" \
        "$SHIM_DIR/shimx64.efi"

    install -m 0644 \
        "$mm" \
        "$SHIM_DIR/mmx64.efi"
}


# ============================================================
# Verification
# ============================================================

verify_shim()
{
    [[ -f "$SHIM_DIR/shimx64.efi" ]] ||
        die "Shim is missing."

    [[ -f "$SHIM_DIR/mmx64.efi" ]] ||
        die "MokManager is missing."

    sbverify \
        --list \
        "$SHIM_DIR/shimx64.efi" \
        >/dev/null ||
        die "Cannot verify Shim PE signature."

    sbverify \
        --list \
        "$SHIM_DIR/mmx64.efi" \
        >/dev/null ||
        die "Cannot verify MokManager PE signature."
}


# ============================================================
# MOK
# ============================================================

mok_is_enrolled()
{
    mokutil \
        --test-key \
        "$DB_CERT_DER" \
        >/dev/null 2>&1
}

enroll_mok()
{
    if mok_is_enrolled; then
        log "sbctl db certificate already enrolled as MOK."
        return
    fi

    log "Requesting MOK enrollment..."

    mokutil \
        --import \
        "$DB_CERT_DER"

    echo
    echo "Complete the MOK enrollment at the next reboot."
}


# ============================================================
# Main
# ============================================================

main()
{
    [[ $EUID -eq 0 ]] ||
        die "Run as root."

    if [[ -z "$SETUP_MODE" ]]; then
        SETUP_MODE="$(read_efi_uint8 SetupMode)"
    fi

    if [[ "$SETUP_MODE" == "1" ]]; then
        log "SetupMode=1; Shim/MOK is not required."
        exit 0
    fi

    install_dependencies

    create_der_certificate

    if install_local_shim; then

        log "Using Shim installed by the distribution."

    else

        log "shim-signed unavailable in current distribution."
        log "Falling back to Debian Snapshot."

        download_debian_shim
    fi

    verify_shim
    enroll_mok

    log "Shim prepared in $SHIM_DIR"
}

main "$@"