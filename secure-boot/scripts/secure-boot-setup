#!/usr/bin/env bash
# Configuration values are exported for child phase scripts.
# shellcheck disable=SC2154

set -Eeuo pipefail
umask 077

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="${repository_root:-$(cd -- "$script_dir/../.." && pwd)}"

# Runtime-derived paths allow direct execution and safe sourcing by tests.
# shellcheck disable=SC1090,SC1091
source "$repository_root/lib/common.sh"
# shellcheck disable=SC1090,SC1091
source "${SETUP_CONFIG_FILE:-$repository_root/setup.conf}"

export PATH="/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin:$PATH"

export ESP="${ESP:-/boot/efi}"
export SBCTL_KEYROOT="${SBCTL_KEYROOT:-/var/lib/sbctl/keys}"
export DB_KEY="${DB_KEY:-$SBCTL_KEYROOT/db/db.key}"
export DB_CERT="${DB_CERT:-$SBCTL_KEYROOT/db/db.pem}"
export DB_CERT_DER="${DB_CERT_DER:-$SBCTL_KEYROOT/db/db.cer}"
export SHIM_DIR="${SHIM_DIR:-/usr/local/lib/secureboot/shim}"
export DEBIAN_SNAPSHOT="${DEBIAN_SNAPSHOT:-20260812}"
export DEBIAN_SUITE="${DEBIAN_SUITE:-unstable}"

secure-boot-setup.read_efi_uint8() {
	local name=$1
	local file

	file="$(
		find /sys/firmware/efi/efivars \
			-maxdepth 1 \
			-name "${name}-*" \
			-print \
			-quit 2>/dev/null
	)"
	[[ -n $file ]] || return 1
	od -An -j4 -N1 -t u1 "$file" | tr -d '[:space:]'
}

secure-boot-setup.detect_firmware_state() {
	local state_file=/etc/securebootmode.conf

	SETUP_MODE="$(secure-boot-setup.read_efi_uint8 SetupMode)" ||
		log.die "Cannot read current UEFI SetupMode."
	log.info "Refresh detected UEFI SetupMode=$SETUP_MODE in $state_file"
	printf '%s\n' "$SETUP_MODE" >"$state_file"

	SECURE_BOOT="$(secure-boot-setup.read_efi_uint8 SecureBoot 2>/dev/null || printf '0\n')"
	case $SETUP_MODE in
	0 | 1) ;;
	*) log.die "Invalid SetupMode value: $SETUP_MODE" ;;
	esac
	case $SECURE_BOOT in
	0 | 1) ;;
	*) log.die "Invalid SecureBoot value: $SECURE_BOOT" ;;
	esac
	if [[ $SETUP_MODE == 1 ]]; then
		secure_boot_mode=setup
	elif [[ $SECURE_BOOT == 1 ]]; then
		secure_boot_mode=enabled
	else
		secure_boot_mode=disabled
	fi
	export secure_boot_mode
	export SETUP_MODE SECURE_BOOT
}

secure-boot-setup.trust_path() {
	local enrollment_method=$1

	case $enrollment_method in
	sbctl) printf 'direct-sbctl\n' ;;
	mok) printf 'shim-mok\n' ;;
	existing) printf 'existing-sbctl\n' ;;
	*) return 1 ;;
	esac
}

secure-boot-setup.copy_public_certificates() {
	local destination="$ESP/EFI/keys"
	local certificate destination_file
	local -a certificates=(
		"$SBCTL_KEYROOT/PK/PK.pem"
		"$SBCTL_KEYROOT/KEK/KEK.pem"
		"$SBCTL_KEYROOT/db/db.pem"
	)

	[[ -f $DB_CERT_DER ]] && certificates+=("$DB_CERT_DER")
	install -d -m 0755 "$destination"
	if find "$destination" -mindepth 1 -maxdepth 1 ! -type f -print -quit | grep -q .; then
		log.die "Public certificate directory contains an unexpected non-file entry: $destination"
	fi
	if find "$destination" -maxdepth 1 -type f \
		! -name PK.pem ! -name KEK.pem ! -name db.pem ! -name db.cer \
		-print -quit | grep -q .; then
		log.die "Public certificate directory contains an unexpected file: $destination"
	fi
	log.info "Copy public Secure Boot certificates to $destination; private keys are explicitly excluded"
	for certificate in "${certificates[@]}"; do
		common.require_readable_file "$certificate" "Public Secure Boot certificate"
		destination_file="$destination/$(basename -- "$certificate")"
		install -m 0644 "$certificate" "$destination_file"
		cmp -s "$certificate" "$destination_file" || log.die "Copied certificate validation failed: $destination_file"
	done
	if find "$destination" -maxdepth 1 -type f \( -name '*.key' -o -name '*.auth' -o -name '*.esl' \) -print -quit | grep -q .; then
		log.die "Private or enrollment key material was found in public certificate directory $destination."
	fi
	log.success "Public Secure Boot certificates are available in $destination"
}

secure-boot-setup.run_phase() {
	local phase_name=$1
	local phase_script=$2

	log.section "$phase_name"
	log.info "Execute $phase_script"
	"$phase_script"
	log.success "$phase_name completed"
}

secure-boot-setup.print_summary() {
	local trust_path

	trust_path="$(secure-boot-setup.trust_path "$secure_boot_enrollment")"
	log.section "Secure Boot setup summary"
	log.summary_item "Status" "completed successfully"
	log.summary_item "SetupMode" "$SETUP_MODE"
	log.summary_item "SecureBoot" "$SECURE_BOOT"
	log.summary_item "Configured state snapshot" "$secure_boot_mode"
	log.summary_item "Enrollment method" "$secure_boot_enrollment"
	log.summary_item "Trust path" "$trust_path"
	log.summary_item "Signing key root" "$SBCTL_KEYROOT"
	log.summary_item "ESP" "$ESP"
	log.summary_item "Public certificates" "$ESP/EFI/keys"
	log.summary_item "Shim directory" "$SHIM_DIR"
	log.summary_item "rEFInd" "$ESP/EFI/refind"
	log.success "Secure Boot configuration completed"

	if [[ $secure_boot_enrollment == mok ]]; then
		log.warn "Complete the pending MOK enrollment at the next reboot if requested"
	elif [[ $SETUP_MODE != 1 ]]; then
		log.warn "sbctl firmware enrollment was not possible because firmware was not in Setup Mode"
	fi
}

secure-boot-setup.validate_result() {
	local loader

	log.section "Post-summary validation"
	common.require_readable_file "$SBCTL_KEYROOT/db/db.pem" "Secure Boot db certificate"
	common.require_readable_file "$SBCTL_KEYROOT/db/db.key" "Secure Boot db private key"
	if [[ $secure_boot_enrollment == existing ]]; then
		log.info "Existing Secure Boot mode: no ESP loader or enrollment validation is required"
		log.success "Validated imported Secure Boot key hierarchy"
		log.section_end
		return
	fi
	if [[ $secure_boot_enrollment == mok ]]; then
		loader="$ESP/EFI/refind/grubx64.efi"
		common.require_readable_file "$ESP/EFI/refind/shimx64.efi" "Shim loader"
		common.require_readable_file "$ESP/EFI/refind/mmx64.efi" "MokManager"
	else
		loader="$ESP/EFI/refind/refind_x64.efi"
	fi
	common.require_readable_file "$loader" "Repository-signed rEFInd loader"
	for certificate in PK.pem KEK.pem db.pem; do
		common.require_readable_file "$ESP/EFI/keys/$certificate" "Copied public Secure Boot certificate"
	done
	[[ ! -e $ESP/EFI/keys/db.key ]] || log.die "Private db key must not be copied to the ESP."
	if [[ $secure_boot_enrollment == mok ]]; then
		common.require_readable_file "$ESP/EFI/keys/db.cer" "Copied public MOK DER certificate"
	fi
	sbverify --cert "$SBCTL_KEYROOT/db/db.pem" "$loader" >/dev/null || log.die "rEFInd post-summary signature validation failed: $loader"
	log.success "Validated Secure Boot keys, selected trust-path loaders and rEFInd signature"
	log.section_end
}

secure-boot-setup.run() {
	common.require_root
	common.require_commands apt-get basename cmp find grep install od tr uname
	[[ -d /sys/firmware/efi ]] ||
		log.die "System was not booted in UEFI mode."
	case $(uname -m) in
	x86_64 | amd64) ;;
	*) log.die "Only x86-64 UEFI is currently supported." ;;
	esac
	[[ ${secure_boot_enrollment:-} == sbctl || ${secure_boot_enrollment:-} == mok || ${secure_boot_enrollment:-} == existing ]] ||
		log.die "secure_boot_enrollment must be sbctl or mok."

	log.section "Secure Boot preflight"
	log.info "Install base packages required for firmware-state discovery"
	export DEBIAN_FRONTEND=noninteractive
	apt-get update
	apt-get install -y ca-certificates findutils coreutils
	secure-boot-setup.detect_firmware_state
	log.info "Detected SetupMode=$SETUP_MODE and SecureBoot=$SECURE_BOOT"
	log.info "Configured trust path: $(secure-boot-setup.trust_path "$secure_boot_enrollment")"
	if [[ $secure_boot_enrollment == sbctl && $SETUP_MODE != 1 ]]; then
		log.warn "Firmware is not in Setup Mode; sbctl enrollment cannot be completed. Continue with key creation and signing only."
	fi

	secure-boot-setup.run_phase \
		"Secure Boot key management" "$script_dir/sbctl-setup"
	if [[ $secure_boot_enrollment == mok ]]; then
		secure-boot-setup.run_phase \
			"Shim and MOK preparation" "$script_dir/shim-setup"
	elif [[ $secure_boot_enrollment == existing ]]; then
		log.info "Skip Shim/MOK preparation because Secure Boot enrollment already exists"
	else
		log.info "Skip Shim/MOK preparation because the user selected sbctl enrollment"
	fi
	if [[ $secure_boot_enrollment == existing ]]; then
		log.info "Skip rEFInd installation in the ESP for existing Secure Boot migration"
	else
		secure-boot-setup.copy_public_certificates
		secure-boot-setup.run_phase \
			"rEFInd installation and signing" "$script_dir/refind-setup"
	fi
	secure-boot-setup.run_phase \
		"fwupd configuration and signing" "$script_dir/fwupd-setup"
	secure-boot-setup.print_summary
	secure-boot-setup.validate_result
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	secure-boot-setup.run
fi
