#!/usr/bin/env bash

set -Eeuo pipefail

script="${BASH_SOURCE[0]}"
scriptname="$(basename "$script")"

repository_root="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." &&
        pwd
)"

source $repository_root/setup.conf

[[ $EUID -eq 0 ]] || {
    echo "Run $scriptname as root." >&2
    exit 1
}

export ESP="${ESP:-/boot/efi}"

export SBCTL_KEYROOT="${SBCTL_KEYROOT:-/var/lib/sbctl/keys}"
export DB_KEY="${DB_KEY:-$SBCTL_KEYROOT/db/db.key}"
export DB_CERT="${DB_CERT:-$SBCTL_KEYROOT/db/db.pem}"
export DB_CERT_DER="${DB_CERT_DER:-$SBCTL_KEYROOT/db/db.cer}"

export SHIM_DIR="${SHIM_DIR:-/usr/local/lib/secureboot/shim}"

export DEBIAN_SNAPSHOT="${DEBIAN_SNAPSHOT:-20260812}"
export DEBIAN_SUITE="${DEBIAN_SUITE:-unstable}"

log()
{
    printf '==> %s\n' "$*"
}

die()
{
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

read_efi_uint8()
{
    local name="$1"
    local file

    file="$(
        find /sys/firmware/efi/efivars \
            -maxdepth 1 \
            -name "${name}-*" \
            -print \
            -quit 2>/dev/null
    )"

    [[ -n "$file" ]] || return 1

    od -An -j4 -N1 -t u1 "$file" |
        tr -d '[:space:]'
}

install_dependencies()
{
    export DEBIAN_FRONTEND=noninteractive

    apt-get update

    apt-get install -y \
        ca-certificates \
        findutils \
        coreutils
}

main()
{
    [[ $EUID -eq 0 ]] ||
        die "Run this script as root."

    install_dependencies

    [[ -d /sys/firmware/efi ]] ||
        die "System was not booted in UEFI mode."

    case "$(uname -m)" in
        x86_64|amd64)
            ;;
        *)
            die "Only x86-64 UEFI is currently supported."
            ;;
    esac

    export SETUP_MODE="$(
        read_efi_uint8 SetupMode
    )" || die "Cannot read UEFI SetupMode."

    export SECURE_BOOT="$(
        read_efi_uint8 SecureBoot 2>/dev/null || echo 0
    )"

    log "Setup Mode  : $SETUP_MODE"
    log "Secure Boot : $SECURE_BOOT"

    #
    # Always:
    #
    # - install sbctl
    # - create PK/KEK/db
    # - firmware enrollment only when SetupMode=1
    #
    "$repository_root/secure-boot/scripts/sbctl-setup"

    #
    # Existing firmware trust:
    #
    # SetupMode=0 -> Shim + MOK
    #
    # SecureBoot may currently be either enabled or disabled.
    #
    if [[ "$SETUP_MODE" == "0" ]]; then
        "$repository_root/secure-boot/scripts/shim-setup"
    fi

    #
    # Direct rEFInd in Setup Mode.
    # rEFInd behind Shim otherwise.
    #
    "$repository_root/secure-boot/scripts/refind-setup"

    echo
    log "Secure Boot setup completed."

    if [[ "$SETUP_MODE" == "0" ]]; then
        echo
        echo "Complete the MOK enrollment at the next reboot if requested."
    fi
}

main "$@"