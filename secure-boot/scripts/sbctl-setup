#!/usr/bin/env bash

set -Eeuo pipefail


# ============================================================
# Configuration
# ============================================================

SBCTL_VERSION="${SBCTL_VERSION:-0.17}"

SBCTL_KEYROOT="${SBCTL_KEYROOT:-/var/lib/sbctl/keys}"

PK_KEY="$SBCTL_KEYROOT/PK/PK.key"
PK_CERT="$SBCTL_KEYROOT/PK/PK.pem"

KEK_KEY="$SBCTL_KEYROOT/KEK/KEK.key"
KEK_CERT="$SBCTL_KEYROOT/KEK/KEK.pem"

DB_KEY="${DB_KEY:-$SBCTL_KEYROOT/db/db.key}"
DB_CERT="${DB_CERT:-$SBCTL_KEYROOT/db/db.pem}"

PRESERVE_MICROSOFT="${PRESERVE_MICROSOFT:-true}"
PRESERVE_FIRMWARE_DEFAULTS="${PRESERVE_FIRMWARE_DEFAULTS:-true}"

SETUP_MODE="${SETUP_MODE:-}"


# ============================================================
# Helpers
# ============================================================

log()
{
    printf '==> %s\n' "$*"
}

warn()
{
    printf 'WARNING: %s\n' "$*" >&2
}

die()
{
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

require_command()
{
    command -v "$1" >/dev/null 2>&1 ||
        die "Required command not found: $1"
}

read_efi_uint8()
{
    local name="$1"
    local file

    file="$(
        find /sys/firmware/efi/efivars \
            -maxdepth 1 \
            -name "${name}-*" \
            -print \
            -quit 2>/dev/null
    )"

    [[ -n "$file" ]] || return 1

    od -An -j4 -N1 -t u1 "$file" |
        tr -d '[:space:]'
}


# ============================================================
# Dependencies
# ============================================================

install_dependencies()
{
    export DEBIAN_FRONTEND=noninteractive

    apt-get update

    apt-get install -y \
		ca-certificates \
		curl \
		git \
		golang-go \
		make \
		binutils \
		util-linux \
		e2fsprogs \
		findutils \
		coreutils

    #
    # Prefer distro package.
    #
    if ! command -v sbctl >/dev/null 2>&1; then

        log "Trying to install sbctl from distribution repository..."
        if apt-cache search sbctl | grep -q sbctl; then
            echo "sbctl package available in distribution repository."
			apt-get install -y sbctl || true
        else
			log "sbctl package unavailable in distribution repository."
			log "Trying to install sbctl from upstream GitHub releases..."
			install_sbctl_upstream
		fi	
		
    fi
}


# ============================================================
# sbctl fallback
# ============================================================

install_sbctl_upstream()
{
    
    apt-get install -y \
        ca-certificates \
        git \
        golang-go \
        make \
        asciidoc-base \
        pkgconf \
        pkgconf-bin \
        curl \
        jq \
        libpcsclite-dev \
        libpcsclite1 \
        golang-go \
        sbsigntool \
        git \
        build-essential \
        pcscd

    local tmp

    tmp="$(mktemp -d /tmp/sbctl-build.XXXXXX)"

    git clone \
        --depth 1 \
        --branch "${SBCTL_VERSION}" \
        https://github.com/Foxboron/sbctl.git \
        "$tmp/src"

    (
        cd "$tmp/src"

        go build \
            -trimpath \
            -o "$tmp/sbctl" \
            ./cmd/sbctl
    )

    file "$tmp/sbctl" |
        grep -q 'ELF' ||
        die "Built sbctl is not an ELF executable."

    install \
        -m 0755 \
        "$tmp/sbctl" \
        /usr/local/sbin/sbctl

    rm -rf "$tmp"
    trap - RETURN
}


# ============================================================
# Keys
# ============================================================

keys_exist()
{
    [[ -f "$PK_KEY" ]] &&
    [[ -f "$PK_CERT" ]] &&
    [[ -f "$KEK_KEY" ]] &&
    [[ -f "$KEK_CERT" ]] &&
    [[ -f "$DB_KEY" ]] &&
    [[ -f "$DB_CERT" ]]
}

create_keys()
{
    if keys_exist; then
        log "sbctl key hierarchy already exists."
        return
    fi

    if [[ -d "$SBCTL_KEYROOT" ]] &&
       find "$SBCTL_KEYROOT" \
            -mindepth 1 \
            -print \
            -quit 2>/dev/null |
       grep -q .
    then
        die "Incomplete sbctl key hierarchy in $SBCTL_KEYROOT."
    fi

    log "Generating Secure Boot keys..."

    sbctl create-keys
	sbctl setup --migrate || true
    keys_exist ||
        die "sbctl did not create the expected key hierarchy."

	migrate_sbctl()
	{
		log "Migrating sbctl configuration if necessary..."
	
		sbctl setup --migrate || true
	}
}


# ============================================================
# Enrollment
# ============================================================

sbctl_supports()
{
    sbctl enroll-keys --help 2>&1 |
        grep -q -- "$1"
}

efi_variable_exists()
{
    local name="$1"

    find /sys/firmware/efi/efivars \
        -maxdepth 1 \
        -name "${name}-*" \
        -print \
        -quit 2>/dev/null |
        grep -q .
}

enroll_db()
{
    local args=(
        enroll-keys
        --partial db
    )

    if efi_variable_exists db; then
        args+=(--append)
    fi

    if [[ "$PRESERVE_MICROSOFT" == "true" ]]; then
        args+=(--microsoft)
    fi

    if [[ "$PRESERVE_FIRMWARE_DEFAULTS" == "true" ]] &&
		sbctl_supports "--firmware-builtin"
    then
        args+=(--firmware-builtin db)
    fi

    #
    # IMPORTANT:
    # Previous enrollment operations may have recreated
    # EFI variables with the immutable flag.
    #
    unprotect_efi_variables

    log "Enrolling db..."

    sbctl "${args[@]}"
}

enroll_kek()
{
    local args=(
        enroll-keys
        --partial KEK
    )

    if efi_variable_exists KEK; then
        args+=(--append)
    fi

    if [[ "$PRESERVE_FIRMWARE_DEFAULTS" == "true" ]] &&
		sbctl_supports "--firmware-builtin"
    then
        args+=(--firmware-builtin KEK)
    fi
	 #
    # IMPORTANT:
    # Previous enrollment operations may have recreated
    # EFI variables with the immutable flag.
    #
    unprotect_efi_variables

    log "Enrolling KEK..."

    sbctl "${args[@]}"
}

enroll_pk()
{	
	#
    # KEK has just been rewritten and can have become
    # immutable again.
    #
    unprotect_efi_variables

    log "Enrolling PK..."

    #
    # Always last.
    #
    sbctl enroll-keys \
        --partial PK
}

unprotect_efi_variables()
{
    local var
    local file

    for var in PK KEK db; do

        while IFS= read -r file; do
            [[ -e "$file" ]] || continue

            if lsattr "$file" 2>/dev/null |
				awk '{print $1}' |
				grep -q 'i'
            then
                log "Removing immutable flag from $(basename "$file")"
                chattr -i "$file"
            fi

        done < <(
            find /sys/firmware/efi/efivars \
                -maxdepth 1 \
                -type f \
                -name "${var}-*" \
                -print 2>/dev/null
        )

    done
}

efi_protect()
{
    local var
    local file

    for var in PK KEK db; do

        while IFS= read -r file; do
            [[ -e "$file" ]] || continue

            log "Restoring immutable flag on $(basename "$file")"

            chattr +i "$file" 2>/dev/null || true

        done < <(
            find /sys/firmware/efi/efivars \
                -maxdepth 1 \
                -type f \
                -name "${var}-*" \
                -print 2>/dev/null
        )

    done
}

migrate_sbctl()
{
    log "Checking sbctl configuration..."

    if sbctl setup --migrate 2>&1 |
		tee /tmp/sbctl-migrate.log |
		grep -q 'old configuration detected'
    then
        :
    fi
}

enroll_if_setup_mode()
{
    if [[ -z "$SETUP_MODE" ]]; then
        if [[ -f /etc/securebootmode.conf ]]; then
			SETUP_MODE="$(cat /etc/securebootmode.conf)"
			cat > /etc/securebootmode.conf <<- EOF
				$SETUP_MODE
			EOF
		else
			SETUP_MODE="$(
				read_efi_uint8 SetupMode
			)" || die "Cannot read UEFI SetupMode."
		fi
    fi

    if [[ "$SETUP_MODE" != "1" ]]; then

        log "SetupMode=0."
        log "Skipping firmware enrollment."

        return
    fi

    log "SetupMode=1."
    log "Preparing EFI variables..."

    #
    # Make sure we attempt to restore protection even if
    # enrollment fails.
    #
    trap 'efi_protect' RETURN

    log "Performing Secure Boot enrollment..."

    #
    # db first.
    #
    enroll_db

    #
    # KEK second.
    #
    enroll_kek

    #
    # PK LAST.
    #
    # Installing PK exits Setup Mode.
    #
    enroll_pk

    efi_protect
    trap - RETURN

    log "Secure Boot enrollment completed."
}


# ============================================================
# Main
# ============================================================

main()
{
    [[ $EUID -eq 0 ]] ||
        die "Run as root."

    install_dependencies
    require_command sbctl
    create_keys
    enroll_if_setup_mode
	sbctl setup --migrate || true
    sbctl status || true
}

main "$@"