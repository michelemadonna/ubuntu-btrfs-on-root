#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

[[ $EUID -eq 0 ]] || {
    echo "Run install-uki as root." >&2
    exit 1
}

repository_root="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." &&
        pwd
)"

source $repository_root/setup.conf



apt-get install -y \
    dracut \
    dialog \
    systemd-ukify \
    binutils \
    rsync \
    openssl



#read -r -p "Distribution identifier [ubuntu]: " distro_id
#distro_id="${distro_id:-ubuntu}"
#
#[[ "$distro_id" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || {
#    echo "Invalid distribution identifier: $distro_id" >&2
#    exit 1
#}
#
#read -r -p "ESP mount point [/boot/efi]: " esp_directory
#esp_directory="${esp_directory:-/boot/efi}"
#
#mountpoint -q "$esp_directory" || {
#    echo "ESP is not mounted: $esp_directory" >&2
#    exit 1
#}
#
#read -r -p "Btrfs root filesystem UUID: " btrfs_uuid
#
#[[ -n "$btrfs_uuid" ]] || {
#    echo "The Btrfs UUID is required." >&2
#    exit 1
#}
#
#read -r -p "Root LUKS UUID: " luks_uuid
#
#[[ -n "$luks_uuid" ]] || {
#    echo "The LUKS UUID is required." >&2
#    exit 1
#}
#
#read -r -p "Normal root subvolume [@ubuntu]: " root_subvolume
#root_subvolume="${root_subvolume:-@ubuntu}"

export distro_id=$suite
export esp_directory=/boot/efi
export btrfs_uuid="$(blkid --output export /dev/mapper/root | grep ^UUID= | cut -c 6-)"
export luks_uuid=$(cryptsetup luksUUID /dev/$root_dev)
export root_subvolume=$root_sub_vol/@


install -d -m 0700 /etc/uki/keys
#install -d -m 0755 /etc/kernel
#install -d -m 0755 /etc/dracut.conf.d
#install -d -m 0755 /usr/local/sbin
install -d -m 0755 /usr/lib/dracut/modules.d/92snapshot-menu

cat >/etc/kernel/install.conf <<-'EOF'
    layout=uki
    initrd_generator=dracut
    uki_generator=ukify
EOF
chmod 0644 /etc/kernel/install.conf

echo $suite > /etc/kernel/entry-token
chmod 0644 /etc/kernel/entry-token

cat > /etc/kernel/uki.conf << 'EOF'
    [UKI]
    PCRBanks=sha256

    SecureBootSigningTool=sbsign
    SecureBootPrivateKey=/var/lib/sbctl/keys/db/db.key
    SecureBootCertificate=/var/lib/sbctl/keys/db/db.pem

    SignKernel=false

    [PCRSignature:initrd]
    PCRPrivateKey=/etc/uki/keys/pcr-private.pem
    PCRPublicKey=/etc/uki/keys/pcr-public.pem
    Phases=enter-initrd
EOF
chmod 600 /etc/kernel/uki.conf
ln -sf \
    /etc/kernel/uki.conf \
    /etc/systemd/ukify.conf

rsync \
    -a \
    --delete \
    $repository_root/uki"/dracut/92snapshot-menu/" \
    /usr/lib/dracut/modules.d/92snapshot-menu/

chmod 0755 \
    /usr/lib/dracut/modules.d/92snapshot-menu/module-setup.sh \
    /usr/lib/dracut/modules.d/92snapshot-menu/snapshot-menu-hook.sh \
    /usr/lib/dracut/modules.d/92snapshot-menu/snapshot-menu.sh

cat > /usr/lib/dracut/modules.d/92snapshot-menu/snapshot-menu.conf <<- EOF
    ROOT_SUBVOL="${root_subvolume}"
    SNAPSHOT_DIR=".snapshots"
    TTY="/dev/tty1"
    MOUNTPOINT="/run/snapshot-menu-root"
    RESULT="/run/snapshot-menu-selected"
    CMDLINE_DIR="/etc/cmdline.d"
    SNAPSHOT_CMDLINE="/etc/cmdline.d/99-snapshot.conf"
EOF

chmod 0644 \
    /usr/lib/dracut/modules.d/92snapshot-menu/snapshot-menu.conf

cat > /etc/dracut.conf.d/52-snapshot-menu.conf <<-'EOF'
    force_add_dracutmodules+=" snapshot-menu "
EOF

cat > /etc/dracut.conf.d/53-uki-cmdline.conf <<-'EOF'
    hostonly_cmdline="no"
EOF


if [[ ! -s /etc/uki/keys/pcr-private.pem ]]; then
    openssl genpkey \
        -algorithm RSA \
        -pkeyopt rsa_keygen_bits:2048 \
        -out /etc/uki/keys/pcr-private.pem

    openssl pkey \
        -pubout \
        -in /etc/uki/keys/pcr-private.pem \
        -out /etc/uki/keys/pcr-public.pem
fi

chmod 0600 /etc/uki/keys/pcr-private.pem
chmod 0644 /etc/uki/keys/pcr-public.pem

echo "root=UUID=${btrfs_uuid} rootfstype=btrfs rootflags=${btrfs_options},subvol=${root_subvolume} rd.luks.uuid=luks-${luks_uuid} quiet splash" > /etc/kernel/cmdline
chmod 0644 /etc/kernel/cmdline

echo 'add_dracutmodules+=" overlayfs "' | tee /etc/dracut.conf.d/99_overlayfs.conf

install -m 755 \
    "$repository_root/uki/hooks/99-refind-menu.install" \
    /usr/lib/kernel/install.d/99-refind-menu.install


if [[ $enable_tpm == "yes" ]]; then
    echo 'add_dracutmodules+=" tpm2-tss crypt "' > /etc/dracut.conf.d/99_tpm2.conf
    . $repository_root/tpm/scripts/install-tpm
    if grep -qE 'rd.luks.options=tpm2-device=auto,tpm2-measure-pcr=yes' /etc/kernel/cmdline; then
        echo "The kernel command line already contains the TPM2 options."
    else
        echo "Appending TPM2 options to the kernel command line."
        echo "rd.luks.options=tpm2-device=auto,tpm2-measure-pcr=yes" >> /etc/kernel/cmdline
    fi
fi


echo
echo "UKI support installed."
echo "UKI destination: ${esp_directory}/EFI/Linux/${distro_id}"
echo
echo "Review these files before the first build:"
echo "  /etc/kernel/cmdline"
echo "  /etc/kernel/uki.conf"
echo "  /usr/lib/dracut/modules.d/92snapshot-menu/snapshot-menu.conf"
echo

read -r -p "Generate the UKI for all installed kernel now? [Y/n]: " answer

case "$answer" in
    n|N)
        ;;

    *)
        declare -a uki_success=()
        declare -a uki_failed=()

        for kernel in /boot/vmlinuz-*; do
            [[ -f "$kernel" ]] || continue

            version="${kernel#/boot/vmlinuz-}"
            module_dir="/usr/lib/modules/${version}"
            uki="/boot/efi/EFI/Linux/${suite}-${version}.efi"

            declare -a kernel_errors=()

            echo
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "🚀 Processing kernel: ${version}"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

            if [[ ! -d "$module_dir" ]]; then
                echo "⚠️  Kernel modules not found: ${module_dir}"
                uki_failed+=("${version}: kernel modules missing")
                continue
            fi

            echo "🔧 Generating UKI..."

            if kernel-install add "$version" "$kernel"; then
                echo "✅ kernel-install completed"
            else
                echo "❌ kernel-install failed"
                kernel_errors+=("kernel-install failed")
            fi

            # ------------------------------------------------------------
            # Check generated UKI
            # ------------------------------------------------------------

            if [[ ! -f "$uki" ]]; then
                echo "❌ Generated UKI not found: ${uki}"
                kernel_errors+=("generated UKI not found")

                uki_failed+=(
                    "${version}: ${kernel_errors[*]}"
                )

                continue
            fi

            echo "📦 Generated UKI: ${uki}"

            temporary_uki="$(mktemp --tmpdir "${suite}-${version}.XXXXXX.efi")"

            if cp -- "$uki" "$temporary_uki"; then
                echo "📋 Created validation copy: ${temporary_uki}"
            else
                echo "❌ Unable to create temporary UKI copy"
                kernel_errors+=("unable to create temporary UKI copy")

                uki_failed+=(
                    "${version}: ${kernel_errors[*]}"
                )

                continue
            fi

            # ------------------------------------------------------------
            # Secure Boot signature validation
            # ------------------------------------------------------------

            echo
            echo "🔐 Validating Secure Boot signature..."

            if sbctl verify "$temporary_uki"; then
                echo "✅ sbctl verification passed"
            else
                echo "❌ sbctl verification failed"
                kernel_errors+=("sbctl signature verification failed")
            fi

            if sbverify --list "$temporary_uki"; then
                echo "✅ PE/COFF signature found"
            else
                echo "❌ Unable to validate PE/COFF signature"
                kernel_errors+=("sbverify signature verification failed")
            fi

            # ------------------------------------------------------------
            # PE section validation
            # ------------------------------------------------------------

            echo
            echo "🔍 Inspecting UKI sections..."

            if sections="$(objdump -h "$temporary_uki" 2>/dev/null)"; then

                for section in \
                    .linux \
                    .initrd \
                    .cmdline \
                    .uname \
                    .pcrpkey \
                    .pcrsig
                do
                    if grep -Fq "$section" <<<"$sections"; then
                        printf '   ✅ %-10s present\n' "$section"
                    else
                        printf '   ❌ %-10s missing\n' "$section"
                        kernel_errors+=("missing UKI section ${section}")
                    fi
                done

            else
                echo "❌ Unable to inspect generated UKI"
                kernel_errors+=("unable to inspect UKI sections")
            fi

            # ------------------------------------------------------------
            # Validate embedded kernel version
            # ------------------------------------------------------------

            echo
            echo "🏷️  Validating embedded kernel version..."

            if embedded_uname="$(
                objcopy \
                    --dump-section .uname=/dev/stdout \
                    "$temporary_uki" \
                    2>/dev/null |
                    tr -d '\0\n'
            )"; then

                if [[ "$embedded_uname" == "$version" ]]; then
                    echo "✅ Embedded kernel version: ${embedded_uname}"
                else
                    echo "❌ Embedded kernel version '${embedded_uname}' does not match '${version}'"
                    kernel_errors+=(
                        "embedded kernel version mismatch (${embedded_uname})"
                    )
                fi

            else
                echo "❌ Unable to extract embedded kernel version"
                kernel_errors+=("unable to extract .uname section")
            fi

            # ------------------------------------------------------------
            # Extract and validate initrd
            # ------------------------------------------------------------

            echo
            echo "📂 Extracting embedded initrd..."

            work_directory="$(mktemp -d)"

            if objcopy \
                --dump-section ".initrd=${work_directory}/initrd" \
                "$temporary_uki" \
                2>/dev/null
            then
                echo "✅ Embedded initrd extracted"
            else
                echo "❌ Unable to extract embedded initrd"
                kernel_errors+=("unable to extract embedded initrd")
            fi

            initrd="${work_directory}/initrd"

            if [[ -s "$initrd" ]]; then

                if initrd_listing="$(lsinitrd "$initrd" 2>/dev/null)"; then

                    echo
                    echo "📸 Validating snapshot menu inside initrd..."

                    if grep -qE 'usr/libexec/snapshot-menu$' <<<"$initrd_listing"; then
                        echo "   ✅ Snapshot menu executable"
                    else
                        echo "   ❌ Snapshot menu executable missing"
                        kernel_errors+=("snapshot menu executable missing")
                    fi

                    if grep -qE 'etc/snapshot-menu\.conf$' <<<"$initrd_listing"; then
                        echo "   ✅ Snapshot menu configuration"
                    else
                        echo "   ❌ Snapshot menu configuration missing"
                        kernel_errors+=("snapshot menu configuration missing")
                    fi

                    if grep -qE \
                        'hooks/pre-mount/.+snapshot-menu-hook\.sh$' \
                        <<<"$initrd_listing"
                    then
                        echo "   ✅ Snapshot menu pre-mount hook"
                    else
                        echo "   ❌ Snapshot menu pre-mount hook missing"
                        kernel_errors+=("snapshot menu pre-mount hook missing")
                    fi

                else
                    echo "❌ Unable to inspect embedded initrd"
                    kernel_errors+=("lsinitrd failed")
                fi

            else
                echo "❌ Extracted initrd is empty or missing"
                kernel_errors+=("embedded initrd is empty")
            fi

            # ------------------------------------------------------------
            # Cleanup
            # ------------------------------------------------------------

            rm -f -- "$temporary_uki"
            rm -rf -- "$work_directory"

            # ------------------------------------------------------------
            # Kernel result
            # ------------------------------------------------------------

            echo

            if (( ${#kernel_errors[@]} == 0 )); then
                echo "🎉 UKI ${version} generated and validated successfully"
                uki_success+=("$version")
            else
                echo "⚠️  UKI ${version} completed with ${#kernel_errors[@]} error(s):"

                for error in "${kernel_errors[@]}"; do
                    echo "   ❌ ${error}"
                done

                uki_failed+=(
                    "${version}: $(IFS='; '; echo "${kernel_errors[*]}")"
                )
            fi

        done


        # ==================================================================
        # Final report
        # ==================================================================

        echo
        echo
        echo "╔════════════════════════════════════════════════════════════╗"
        echo "║                    📊 UKI BUILD REPORT                     ║"
        echo "╚════════════════════════════════════════════════════════════╝"
        echo

        echo "✅ Successful: ${#uki_success[@]}"

        for version in "${uki_success[@]}"; do
            echo "   ✅ ${version}"
        done

        echo
        echo "❌ Failed: ${#uki_failed[@]}"

        for failure in "${uki_failed[@]}"; do
            echo "   ❌ ${failure}"
        done

        echo
        echo "────────────────────────────────────────────────────────────"

        if (( ${#uki_failed[@]} == 0 )); then
            echo "🎉 All UKIs were generated and validated successfully."
        else
            echo "⚠️  ${#uki_failed[@]} UKI(s) reported validation errors."
        fi

        echo "────────────────────────────────────────────────────────────"
        ;;
esac