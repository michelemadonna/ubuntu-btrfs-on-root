#!/usr/bin/env bash
# Configuration variables are loaded from setup.conf.
# shellcheck disable=SC2154

set -Eeuo pipefail
umask 077

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="${repository_root:-$(cd -- "$script_dir/../.." && pwd)}"
# shellcheck disable=SC1090,SC1091
source "$repository_root/lib/common.sh"
# shellcheck disable=SC1090,SC1091
source "$repository_root/setup.conf"

INSTALL_UKI_ESP=/boot/efi
INSTALL_UKI_KERNEL_CONFIG=/etc/kernel/install.conf
INSTALL_UKI_UKIFY_CONFIG=/etc/kernel/uki.conf
INSTALL_UKI_CMDLINE=/etc/kernel/cmdline
INSTALL_UKI_ENTRY_TOKEN=/etc/kernel/entry-token
INSTALL_UKI_REFIND_ICON=/etc/kernel/refind-icon

install-uki.validate_configuration() {
	common.require_nonempty suite "${suite:-}"
	common.require_nonempty suite_type "${suite_type:-}"
	common.require_nonempty root_dev "${root_dev:-}"
	common.require_nonempty root_sub_vol "${root_sub_vol:-}"
	common.require_nonempty btrfs_options "${btrfs_options:-}"
	[[ $suite =~ ^[a-z0-9][a-z0-9._-]*$ ]] || log.die "suite is not a safe UKI entry token: $suite"
	[[ $suite_type =~ ^[a-z0-9][a-z0-9._-]*$ ]] || log.die "suite_type is not a safe rEFInd icon name: $suite_type"
	[[ $root_dev != */* && $root_dev != *..* ]] || log.die "root_dev must be relative to /dev."
}

install-uki.build_cmdline() {
	local btrfs_uuid=$1 luks_uuid=$2 root_options=$3 root_subvolume=$4
	printf '%s\n' "root=UUID=${btrfs_uuid} rootfstype=btrfs rootflags=${root_options},subvol=${root_subvolume} rd.luks.uuid=luks-${luks_uuid} rd.shell=0 rd.emergency=halt quiet splash"
}

install-uki.write_kernel_install_config() {
	log.info "Write kernel-install UKI layout to $INSTALL_UKI_KERNEL_CONFIG"
	cat >"$INSTALL_UKI_KERNEL_CONFIG" <<-'EOF'
		layout=uki
		initrd_generator=dracut
		uki_generator=ukify
	EOF
	chmod 0644 "$INSTALL_UKI_KERNEL_CONFIG"
}

install-uki.write_ukify_config() {
	log.info "Write signed and measured UKI policy to $INSTALL_UKI_UKIFY_CONFIG"
	cat >"$INSTALL_UKI_UKIFY_CONFIG" <<-'EOF'
		[UKI]
		PCRBanks=sha256
		OSRelease=@/etc/os-release
		Cmdline=@/etc/kernel/cmdline
		Splash=/etc/kernel/uki-splash.bmp

		SecureBootSigningTool=sbsign
		SecureBootPrivateKey=/var/lib/sbctl/keys/db/db.key
		SecureBootCertificate=/var/lib/sbctl/keys/db/db.pem
		SignKernel=false
		PCRPKey=/etc/uki/keys/pcr-public.pem

		[PCRSignature:initrd]
		PCRPrivateKey=/etc/uki/keys/pcr-private.pem
		PCRPublicKey=/etc/uki/keys/pcr-public.pem
		Phases=enter-initrd

		[PCRSignature:system]
		Phases=enter-initrd:leave-initrd enter-initrd:leave-initrd:sysinit enter-initrd:leave-initrd:sysinit:ready
		PCRPrivateKey=/etc/uki/keys/pcr-private.pem
		PCRPublicKey=/etc/uki/keys/pcr-public.pem
	EOF
	chmod 0600 "$INSTALL_UKI_UKIFY_CONFIG"
	ln -sfn "$INSTALL_UKI_UKIFY_CONFIG" /etc/systemd/ukify.conf
}

install-uki.write_dracut_config() {
	log.info "Disable dracut host-only cmdline embedding; ukify owns the embedded cmdline"
	cat >/etc/dracut.conf.d/53-uki-cmdline.conf <<-'EOF'
		hostonly_cmdline="no"
	EOF
}

install-uki.create_splash() {
	log.info "Convert the Plymouth fallback image into the UKI BMP splash"
	python3 - <<-'PY'
		from PIL import Image

		source = "/usr/share/plymouth/themes/spinner/bgrt-fallback.png"
		destination = "/etc/kernel/uki-splash.bmp"
		Image.open(source).convert("RGB").save(destination, format="BMP")
	PY
}

install-uki.ensure_pcr_keys() {
	install -d -m 0700 /etc/uki/keys
	if [[ ! -s /etc/uki/keys/pcr-private.pem ]]; then
		log.info "Generate the RSA key pair used for UKI PCR signatures"
		openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out /etc/uki/keys/pcr-private.pem
		openssl pkey -pubout -in /etc/uki/keys/pcr-private.pem -out /etc/uki/keys/pcr-public.pem
	else
		log.info "Reuse the existing UKI PCR signing key"
	fi
	chmod 0600 /etc/uki/keys/pcr-private.pem
	chmod 0644 /etc/uki/keys/pcr-public.pem
}

install-uki.install_hooks() {
	log.info "Install Debian postinst/postrm bridge to kernel-install"
	install -m 0755 "$repository_root/uki/hooks/kernel/postinst.d/debian-kernel-install-bridge" /usr/local/libexec/debian-kernel-install-bridge
	ln -sfn /usr/local/libexec/debian-kernel-install-bridge /etc/kernel/postinst.d/zz-kernel-install
	ln -sfn /usr/local/libexec/debian-kernel-install-bridge /etc/kernel/postrm.d/zz-kernel-install

	log.info "Install the rEFInd kernel-install hook"
	install -m 0755 "$repository_root/uki/hooks/kernel/install.d/99-refind-menu.install" /usr/lib/kernel/install.d/99-refind-menu.install
	if ! grep -Fqx "include refind-linux-$suite.conf" "$INSTALL_UKI_ESP/EFI/refind/refind.conf"; then
		printf 'include refind-linux-%s.conf\n' "$suite" >>"$INSTALL_UKI_ESP/EFI/refind/refind.conf"
	fi

	log.info "Install the UKI generation and validation command"
	install -m 0755 "$repository_root/uki/scripts/generate-uki" /usr/local/sbin/generate-uki
}

install-uki.print_summary() {
	log.section "UKI setup summary"
	log.summary_item "Status" "completed successfully"
	log.summary_item "Entry token" "$suite"
	log.summary_item "rEFInd icon" "os_${suite_type}.png (generic Linux fallback)"
	log.summary_item "UKI directory" "$INSTALL_UKI_ESP/EFI/Linux"
	log.summary_item "Normal root" "$root_sub_vol/@"
	log.summary_item "Kernel install" "$INSTALL_UKI_KERNEL_CONFIG"
	log.summary_item "ukify policy" "$INSTALL_UKI_UKIFY_CONFIG"
	log.summary_item "Embedded cmdline" "$INSTALL_UKI_CMDLINE"
	log.summary_item "rEFInd menu" "$INSTALL_UKI_ESP/EFI/refind/refind-linux-$suite.conf"
	log.success "UKI support installed and all installed kernels validated"
}

install-uki.validate_result() {
	local uki
	local validated=0

	log.section "Post-summary validation"
	for uki in "$INSTALL_UKI_KERNEL_CONFIG" "$INSTALL_UKI_UKIFY_CONFIG" "$INSTALL_UKI_CMDLINE" "$INSTALL_UKI_ENTRY_TOKEN" "$INSTALL_UKI_REFIND_ICON"; do
		common.require_readable_file "$uki" "UKI configuration artifact"
	done
	[[ -x /usr/local/sbin/generate-uki ]] || log.die "Standalone generate-uki command is missing or not executable."
	[[ -x /usr/lib/kernel/install.d/99-refind-menu.install ]] || log.die "rEFInd kernel-install hook is missing or not executable."
	while IFS= read -r -d '' uki; do
		sbverify --cert /var/lib/sbctl/keys/db/db.pem "$uki" >/dev/null || log.die "UKI signature validation failed after summary: $uki"
		validated=$((validated + 1))
	done < <(find "$INSTALL_UKI_ESP/EFI/Linux" -maxdepth 1 -type f -name "$suite-*.efi" -print0)
	((validated > 0)) || log.die "No generated UKI was found for entry token $suite."
	log.success "Validated UKI configuration, installed hooks and signatures for $validated artifact(s)"
	log.section_end
}

install-uki.run() {
	local btrfs_uuid luks_uuid root_subvolume
	common.require_root
	install-uki.validate_configuration
	common.require_commands apt-get blkid cryptsetup env find grep install ln openssl python3

	log.section "Unified Kernel Image setup"
	log.info "Install dracut, ukify and UKI inspection dependencies"
	apt-get install -y dracut dialog systemd-ukify binutils rsync openssl python3-pil
	common.require_commands kernel-install lsinitrd objcopy objdump sbverify

	btrfs_uuid="$(blkid --output value --match-tag UUID /dev/mapper/root)"
	luks_uuid="$(cryptsetup luksUUID "/dev/$root_dev")"
	root_subvolume="$root_sub_vol/@"
	common.require_nonempty "Btrfs UUID" "$btrfs_uuid"
	common.require_nonempty "LUKS UUID" "$luks_uuid"
	log.info "Resolved Btrfs UUID $btrfs_uuid and LUKS UUID $luks_uuid"

	install-uki.write_kernel_install_config
	printf '%s\n' "$suite" >"$INSTALL_UKI_ENTRY_TOKEN"
	chmod 0644 "$INSTALL_UKI_ENTRY_TOKEN"
	printf '%s\n' "$suite_type" >"$INSTALL_UKI_REFIND_ICON"
	chmod 0644 "$INSTALL_UKI_REFIND_ICON"
	log.info "Configured rEFInd icon selector os_${suite_type}.png"
	install-uki.create_splash
	install-uki.write_ukify_config
	install-uki.write_dracut_config
	install-uki.ensure_pcr_keys
	install-uki.build_cmdline "$btrfs_uuid" "$luks_uuid" "$btrfs_options" "$root_subvolume" >"$INSTALL_UKI_CMDLINE"
	chmod 0644 "$INSTALL_UKI_CMDLINE"
	log.info "Embedded normal-boot cmdline written for subvolume $root_subvolume"

	if [[ $enable_tpm == yes ]]; then
		log.info "TPM support enabled; install TPM integration before generating UKIs"
		env repository_root="$repository_root" "$repository_root/tpm/scripts/install-tpm"
	else
		log.info "TPM support disabled; skip TPM integration"
	fi

	install-uki.install_hooks
	log.info "Generate and validate UKIs for every installed kernel"
	/usr/local/sbin/generate-uki --all
	install-uki.print_summary
	install-uki.validate_result
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	install-uki.run
fi
