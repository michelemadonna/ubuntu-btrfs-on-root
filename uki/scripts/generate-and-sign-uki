#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

source /etc/uki/uki.conf

kernel_version="${1:?Usage: generate-and-sign-uki <kernel-version>}"

uki_directory="${ESP_DIR}/${UKI_RELATIVE_DIR}"
final_uki="${uki_directory}/${UKI_PREFIX}-${kernel_version}.efi"
temporary_uki="${final_uki}.new"

log() {
    printf '[uki] %s\n' "$*"
}

die() {
    printf '[uki] ERROR: %s\n' "$*" >&2
    exit 1
}

for command in \
    dracut \
    ukify \
    sbctl \
    objcopy \
    objdump \
    lsinitrd \
    flock \
    find \
    sort \
    awk \
    grep \
    mountpoint
do
    command -v "$command" >/dev/null 2>&1 ||
        die "Required command not found: $command"
done

[[ -d "/usr/lib/modules/${kernel_version}" ]] ||
    die "Kernel module directory not found: /usr/lib/modules/${kernel_version}"

[[ -r "$CMDLINE_FILE" ]] ||
    die "Kernel command line is not readable: $CMDLINE_FILE"

[[ -r "$UKIFY_CONFIG" ]] ||
    die "ukify configuration is not readable: $UKIFY_CONFIG"

[[ -r "$PCR_PRIVATE_KEY" ]] ||
    die "PCR private key is not readable: $PCR_PRIVATE_KEY"

[[ -r "$PCR_PUBLIC_KEY" ]] ||
    die "PCR public key is not readable: $PCR_PUBLIC_KEY"

mountpoint -q "$ESP_DIR" ||
    die "ESP is not mounted: $ESP_DIR"

install -d -m 0755 "$uki_directory"

exec 9>"$LOCK_FILE"
flock 9

rm -f -- "$temporary_uki"

cleanup() {
    rm -f -- "$temporary_uki"

    if [[ -n "${work_directory:-}" ]]; then
        rm -rf -- "$work_directory"
    fi
}

trap cleanup EXIT

log "Generating UKI for ${kernel_version}"

dracut \
    --force \
    --uefi \
    --ukify \
    --force-add snapshot-menu \
    --kver "$kernel_version" \
    "$temporary_uki"

[[ -s "$temporary_uki" ]] ||
    die "Dracut did not generate the UKI"

log "Validating UKI sections"

sections="$(objdump -h "$temporary_uki")" || {
    die "Unable to inspect generated UKI"
}

for section in \
    .linux \
    .initrd \
    .cmdline \
    .uname \
    .pcrpkey \
    .pcrsig
do
    grep -Fq "$section" <<<"$sections" ||
        die "Required UKI section is missing: ${section}"
done

embedded_uname="$(
    objcopy \
        --dump-section .uname=/dev/stdout \
        "$temporary_uki" \
        2>/dev/null |
        tr -d '\0\n'
)"

[[ "$embedded_uname" == "$kernel_version" ]] ||
    die "Embedded kernel version '${embedded_uname}' does not match '${kernel_version}'"

work_directory="$(mktemp -d)"

objcopy \
    --dump-section ".initrd=${work_directory}/initrd" \
    "$temporary_uki"

[[ -s "${work_directory}/initrd" ]] ||
    die "Unable to extract the embedded initrd"

initrd_listing="$(lsinitrd "${work_directory}/initrd")"

log "Validating snapshot menu inside initrd"

grep -qE 'usr/libexec/snapshot-menu$' <<<"$initrd_listing" ||
    die "Snapshot menu executable is missing from the initrd"

grep -qE 'etc/snapshot-menu.conf$' <<<"$initrd_listing" ||
    die "Snapshot menu configuration is missing from the initrd"

grep -qE 'hooks/pre-mount/.+snapshot-menu-hook\.sh$' <<<"$initrd_listing" ||
    die "Snapshot menu pre-mount hook is missing from the initrd"

grep -qE '/dialog$' <<<"$initrd_listing" ||
    die "dialog is missing from the initrd"

log "Signing UKI with sbctl"

sbctl sign -s "$temporary_uki"
sbctl verify "$temporary_uki"

mv -f -- "$temporary_uki" "$final_uki"
sync

log "Installed UKI: ${final_uki}"

mapfile -t installed_ukis < <(
    find "$uki_directory" \
        -maxdepth 1 \
        -type f \
        -name "${UKI_PREFIX}-*.efi" \
        -printf '%T@ %p\n' |
        sort -rn |
        awk '{ print $2 }'
)

index=0

for obsolete_uki in "${installed_ukis[@]}"; do
    index=$((index + 1))

    if (( index > KEEP_UKIS )); then
        log "Removing obsolete UKI: ${obsolete_uki}"
        rm -f -- "$obsolete_uki"
    fi
done

trap - EXIT
cleanup

log "UKI generation and signing completed"