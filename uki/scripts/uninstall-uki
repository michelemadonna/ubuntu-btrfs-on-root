#!/usr/bin/env bash
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || {
    echo "Run uninstall-uki as root." >&2
    exit 1
}

rm -f \
    /etc/kernel/postinst.d/zz-generate-and-sign-uki \
    /etc/kernel/postrm.d/zz-remove-uki \
    /etc/dracut.conf.d/52-snapshot-menu.conf \
    /usr/local/sbin/generate-and-sign-uki \
    /usr/local/sbin/remove-uki \
    /usr/local/sbin/uninstall-uki

rm -rf /usr/lib/dracut/modules.d/92snapshot-menu

echo "UKI hooks and scripts were removed."
echo "The following items were intentionally preserved:"
echo "  /etc/ubuntu-uki"
echo "  /etc/kernel/cmdline"
echo "  /etc/kernel/uki.conf"
echo "  existing UKIs on the ESP"