#!/usr/bin/env bash
#
# /usr/lib/kernel/install.d/99-refind-icon.install
#
# Keep a single rEFInd icon associated with the newest UKI
# for the current operating system prefix.
#

set -euo pipefail

COMMAND="${1:-}"

ESP="/boot/efi"

UKI_DIR="${ESP}/EFI/Linux"
REFIND_DIR="${ESP}/EFI/refind"
REFIND_CONFIG="${REFIND_DIR}/refind.conf"
REFIND_ICON_DIR="${ESP}/EFI/refind/themes/refind-theme-regular/"
PREFIX_FILE="/etc/kernel/entry-token"

# ---------------------------------------------------------------------------
# Load UKI prefix
# ---------------------------------------------------------------------------

[[ -r "${PREFIX_FILE}" ]] || exit 0

PREFIX="$(<"${PREFIX_FILE}")"

# Trim leading and trailing whitespace.
PREFIX="${PREFIX#"${PREFIX%%[![:space:]]*}"}"
PREFIX="${PREFIX%"${PREFIX##*[![:space:]]}"}"

[[ -n "${PREFIX}" ]] || exit 0
[[ -d "${UKI_DIR}" ]] || exit 0
[[ -r "${REFIND_CONFIG}" ]] || exit 0

# ---------------------------------------------------------------------------
# Read rEFInd big_icon_size
# ---------------------------------------------------------------------------

BIG_ICON_SIZE="$(
    awk '
        /^[[:space:]]*#/ { next }

        /^[[:space:]]*big_icon_size[[:space:]]+/ {
            value = $2
        }

        END {
            if (value != "")
                print value
        }
    ' "${REFIND_CONFIG}"
)"

# rEFInd defaults to 128 when big_icon_size is not explicitly configured.
BIG_ICON_SIZE="${BIG_ICON_SIZE:-128}"

# ---------------------------------------------------------------------------
# Discover icon directory
# ---------------------------------------------------------------------------

ICON_DIR="$(
    find "${REFIND_ICON_DIR}/icons" \
        -mindepth 1 \
        -maxdepth 1 \
        -type d \
        -name "${BIG_ICON_SIZE}-*" \
        -print \
        -quit
)"

[[ -n "${ICON_DIR}" ]] || exit 0

SOURCE_ICON="${ICON_DIR}/os_${PREFIX}.png"

# Fall back to the generic Linux icon if the distribution-specific
# icon is not available.
if [[ ! -f "${SOURCE_ICON}" ]]; then
    SOURCE_ICON="${ICON_DIR}/os_linux.png"
fi

[[ -f "${SOURCE_ICON}" ]] || exit 0

# ---------------------------------------------------------------------------
# Update rEFInd icon
# ---------------------------------------------------------------------------

update_refind_icon() {
    local latest_uki
    local target_icon

    #
    # Remove previously generated icons for this UKI prefix.
    #
    find "${UKI_DIR}" \
        -maxdepth 1 \
        -type f \
        -name "${PREFIX}-*.png" \
        -delete

    #
    # Find the newest UKI for this prefix.
    #
    latest_uki="$(
        find "${UKI_DIR}" \
            -maxdepth 1 \
            -type f \
            -name "${PREFIX}-*.efi" \
            -printf '%f\n' |
        sort -V |
        tail -n 1
    )"

    #
    # No UKIs remain, for example after removing the last kernel.
    #
    [[ -n "${latest_uki}" ]] || return 0

    target_icon="${UKI_DIR}/${latest_uki%.efi}.png"

    #
    # Associate the distribution icon with the newest UKI.
    #
    cp -f "${SOURCE_ICON}" "${target_icon}"
}

# ---------------------------------------------------------------------------
# kernel-install entry point
# ---------------------------------------------------------------------------

case "${COMMAND}" in
    add|remove)
        update_refind_icon
        ;;

    *)
        exit 0
        ;;
esac

exit 0