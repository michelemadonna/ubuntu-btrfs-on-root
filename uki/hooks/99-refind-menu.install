#!/usr/bin/env bash
#
# /usr/lib/kernel/install.d/99-refind-menu.install
#
# Generate a rEFInd menu entry for the newest UKI and submenu entries
# for all older UKIs belonging to the current operating system.
#
# Each OS manages its own generated configuration file:
#
#   refind-linux-ubuntu.conf
#   refind-linux-kali.conf
#   ...
#

set -euo pipefail

COMMAND="${1:-}"

ESP="/boot/efi"
UKI_DIR="${ESP}/EFI/Linux"

REFIND_DIR="${ESP}/EFI/refind"
REFIND_CONFIG="${REFIND_DIR}/refind.conf"

REFIND_ICON_DIR="${REFIND_DIR}/themes/refind-theme-regular/"
PREFIX_FILE="/etc/kernel/entry-token"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

trim() {
    local value="${1:-}"

    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"

    printf '%s' "$value"
}


# ---------------------------------------------------------------------------
# Load UKI prefix
# ---------------------------------------------------------------------------

[[ -r "${PREFIX_FILE}" ]] || exit 0

PREFIX="$(trim "$(<"${PREFIX_FILE}")")"

[[ -n "${PREFIX}" ]] || exit 0
[[ -d "${UKI_DIR}" ]] || exit 0
[[ -d "${REFIND_DIR}" ]] || exit 0
[[ -r "${REFIND_CONFIG}" ]] || exit 0

GENERATED_CONFIG="${REFIND_DIR}/refind-linux-${PREFIX}.conf"


# ---------------------------------------------------------------------------
# Determine display name
# ---------------------------------------------------------------------------

if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release
fi

DISPLAY_NAME="${NAME:-${PREFIX^}}"


# ---------------------------------------------------------------------------
# Read rEFInd big_icon_size
# ---------------------------------------------------------------------------

BIG_ICON_SIZE="$(
    awk '
        /^[[:space:]]*#/ {
            next
        }

        /^[[:space:]]*big_icon_size[[:space:]]+/ {
            value = $2
        }

        END {
            if (value != "")
                print value
        }
    ' "${REFIND_CONFIG}"
)"

BIG_ICON_SIZE="${BIG_ICON_SIZE:-128}"


# ---------------------------------------------------------------------------
# Discover rEFInd icon directory
# ---------------------------------------------------------------------------

ICON_DIR="$(
    find "${REFIND_ICON_DIR}" \
        -type d \
        -name "${BIG_ICON_SIZE}-*" \
        -print \
        2>/dev/null |
        head -n 1
)"

ICON_PATH=""

if [[ -n "${ICON_DIR}" ]]; then

    if [[ -f "${ICON_DIR}/os_${PREFIX}.png" ]]; then
        ICON_FILE="${ICON_DIR}/os_${PREFIX}.png"

    elif [[ -f "${ICON_DIR}/os_linux.png" ]]; then
        ICON_FILE="${ICON_DIR}/os_linux.png"

    else
        ICON_FILE=""
    fi

    if [[ -n "${ICON_FILE}" ]]; then

        #
        # Convert the host-side ESP path:
        #
        #   /boot/efi/EFI/refind/...
        #
        # into the path rEFInd sees:
        #
        #   /EFI/refind/...
        #
        ICON_PATH="${ICON_FILE#"${ESP}"}"
    fi
fi


# ---------------------------------------------------------------------------
# Extract version from UKI filename
#
# ubuntu-7.0.0-29-generic.efi
#        ↓
# 7.0.0-29-generic
# ---------------------------------------------------------------------------

uki_version() {
    local filename="$1"
    local version

    version="${filename#"${PREFIX}-"}"
    version="${version%.efi}"

    printf '%s' "${version}"
}


# ---------------------------------------------------------------------------
# Generate rEFInd configuration
# ---------------------------------------------------------------------------

generate_refind_menu() {
    local tmp
    local latest_uki
    local latest_version
    local uki
    local version

    local -a ukis=()

    #
    # Find all UKIs belonging to this OS and sort newest first.
    #
    mapfile -t ukis < <(
        find "${UKI_DIR}" \
            -maxdepth 1 \
            -type f \
            -name "${PREFIX}-*.efi" \
            -printf '%f\n' |
        sort -Vr
    )

    #
    # Generate into a temporary file first so rEFInd never sees
    # a partially-written configuration.
    #
    tmp="$(mktemp "${GENERATED_CONFIG}.XXXXXX")"

    {
        echo "#"
        echo "# Automatically generated by 99-refind-menu.install"
        echo "#"
        echo "# Operating system: ${DISPLAY_NAME}"
        echo "# UKI prefix:       ${PREFIX}"
        echo "#"
        echo "# Do not edit this file manually."
        echo "#"
        echo

    } > "${tmp}"

    #
    # If no UKIs remain, install an empty generated configuration.
    #
    if (( ${#ukis[@]} == 0 )); then

        install \
            -m 0644 \
            "${tmp}" \
            "${GENERATED_CONFIG}"

        rm -f -- "${tmp}"

        return 0
    fi


    # -----------------------------------------------------------------------
    # Main entry: newest kernel
    # -----------------------------------------------------------------------

    latest_uki="${ukis[0]}"
    latest_version="$(uki_version "${latest_uki}")"

    {
        printf 'menuentry "%s %s" {\n' \
            "${DISPLAY_NAME}" \
            "${latest_version}"

        if [[ -n "${ICON_PATH}" ]]; then
            printf '    icon %s\n' "${ICON_PATH}"
        fi

        printf '    loader /EFI/Linux/%s\n' \
            "${latest_uki}"


        # -------------------------------------------------------------------
        # Submenu entries: older kernels
        # -------------------------------------------------------------------

        if (( ${#ukis[@]} > 1 )); then

            for uki in "${ukis[@]:1}"; do

                version="$(uki_version "${uki}")"

                echo

                printf '    submenuentry "%s %s" {\n' \
                    "${DISPLAY_NAME}" \
                    "${version}"

                printf '        loader /EFI/Linux/%s\n' \
                    "${uki}"

                echo '    }'

            done
        fi

        echo '}'
        echo

    } >> "${tmp}"


    # -----------------------------------------------------------------------
    # Atomically replace generated configuration
    # -----------------------------------------------------------------------

    install \
        -m 0644 \
        "${tmp}" \
        "${GENERATED_CONFIG}"

    rm -f -- "${tmp}"
}


# ---------------------------------------------------------------------------
# kernel-install entry point
# ---------------------------------------------------------------------------

case "${COMMAND}" in

    add|remove)
        generate_refind_menu
        ;;

    *)
        exit 0
        ;;

esac

exit 0