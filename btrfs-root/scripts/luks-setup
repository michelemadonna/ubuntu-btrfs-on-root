#!/usr/bin/env bash
# Configuration variables are loaded from the runtime-selected setup.conf.
# shellcheck disable=SC2154

set -Eeuo pipefail
umask 077

readonly LUKS_FILESYSTEM_LABEL=ROOT

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="${repository_root:-$(cd -- "$script_dir/../.." && pwd)}"

# Runtime-derived paths allow direct execution and sourcing from setup.sh.
# shellcheck disable=SC1090,SC1091
source "$repository_root/lib/common.sh"
# shellcheck disable=SC1090,SC1091
source "${SETUP_CONFIG_FILE:-$repository_root/setup.conf}"

luks-setup.validate_configuration() {
	common.require_nonempty "root_dev" "${root_dev:-}"
	common.require_nonempty "mp" "${mp:-}"
	common.require_nonempty "root_sub_vol" "${root_sub_vol:-}"
	common.require_nonempty "keyslot_size" "${keyslot_size:-}"
	common.require_nonempty "iter_time" "${iter_time:-}"
	common.require_nonempty "enlarge" "${enlarge:-}"
	common.require_nonempty "PASSPHRASE" "${PASSPHRASE:-}"

	[[ $root_dev != /dev/* ]] ||
		log.die "root_dev must be configured without the /dev/ prefix."
	[[ $mp == /* && $mp != / ]] ||
		log.die "mp must be an absolute path other than /."
	[[ $root_sub_vol != /* && $root_sub_vol != *..* ]] ||
		log.die "root_sub_vol must be a safe relative Btrfs path."
	[[ $iter_time =~ ^[1-9][0-9]*$ ]] ||
		log.die "iter_time must be a positive integer expressed in milliseconds."
	case $enlarge in
	yes | no) ;;
	*) log.die "enlarge must be either 'yes' or 'no'." ;;
	esac
}

luks-setup.build_crypttab_entry() {
	local luks_uuid=$1

	common.require_nonempty "LUKS UUID" "$luks_uuid"
	printf 'root UUID=%s none luks,discard\n' "$luks_uuid"
}

luks-setup.read_partition_identity() {
	local device=$1
	local -n disk_name_ref=$2
	local -n partition_number_ref=$3

	disk_name_ref="$(lsblk --noheadings --output pkname "$device" | tr -d '[:space:]')"
	partition_number_ref="$(lsblk --noheadings --output partn "$device" | tr -d '[:space:]')"
	common.require_nonempty "Parent disk" "$disk_name_ref"
	common.require_nonempty "Partition number" "$partition_number_ref"
}

luks-setup.write_crypttab() {
	local luks_device=$1
	local crypttab_file=$2
	local luks_uuid

	luks_uuid="$(blkid --match-tag UUID --output value "$luks_device")"
	common.require_nonempty "LUKS UUID" "$luks_uuid"
	log.info "Write root LUKS mapping to $crypttab_file using UUID $luks_uuid"
	luks-setup.build_crypttab_entry "$luks_uuid" >"$crypttab_file"
}

luks-setup.configure_label() {
	local luks_device=$1
	local applied_label

	log.info "Set LUKS label $LUKS_FILESYSTEM_LABEL on $luks_device"
	cryptsetup config "$luks_device" --label "$LUKS_FILESYSTEM_LABEL" ||
		log.die "Unable to set LUKS label on $luks_device."
	applied_label="$(blkid -c /dev/null -s LABEL -o value "$luks_device")"
	[[ $applied_label == "$LUKS_FILESYSTEM_LABEL" ]] ||
		log.die "LUKS label validation failed: expected $LUKS_FILESYSTEM_LABEL, found '$applied_label'."
	log.success "LUKS label validated as $LUKS_FILESYSTEM_LABEL on $luks_device"
}

luks-setup.run() {
	local source_device="/dev/$root_dev"
	local mapper_device="/dev/mapper/root"
	local disk_name
	local partition_number

	log.section "LUKS2 encryption"
	log.info "Reserve $keyslot_size at the end of the Btrfs filesystem for the LUKS2 header"
	btrfs filesystem resize "-$keyslot_size" "$mp"

	cd /
	log.info "Unmount plaintext Btrfs filesystem from $mp before in-place encryption"
	umount "$mp"

	luks-setup.read_partition_identity "$source_device" disk_name partition_number
	log.info "Resolved $source_device as partition $partition_number on /dev/$disk_name"
	log.warn "cryptsetup may report that a keyslot operation could fail during in-place encryption"
	log.info "Encrypt $source_device in place as LUKS2 using Argon2id with a ${iter_time} ms PBKDF target; passphrase is supplied through standard input and is never logged"
	printf '%s\n' "$PASSPHRASE" |
		cryptsetup reencrypt \
			--encrypt \
			--type luks2 \
			--pbkdf argon2id \
			--iter-time "$iter_time" \
			--reduce-device-size "$keyslot_size" \
			"$source_device"
	luks-setup.configure_label "$source_device"

	if [[ $enlarge == yes ]]; then
		log.info "Extend partition $partition_number on /dev/$disk_name to all available space"
		parted --script "/dev/$disk_name" resizepart "$partition_number" '100%'
	else
		log.info "Partition enlargement disabled by configuration"
	fi

	log.info "Open $source_device as LUKS mapper $mapper_device"
	printf '%s\n' "$PASSPHRASE" |
		cryptsetup open "$source_device" root
	log.info "Mount normal root subvolume $root_sub_vol/@ from $mapper_device at $mp"
	mount "$mapper_device" -o "subvol=$root_sub_vol/@" "$mp"
	log.info "Grow the Btrfs filesystem to the maximum size exposed by the mapper"
	btrfs filesystem resize max "$mp"

	luks-setup.write_crypttab "$source_device" "$mp/etc/crypttab"
	log.success "LUKS2 encryption and root mapping configured"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	common.require_root
	luks-setup.validate_configuration
	luks-setup.run
fi
