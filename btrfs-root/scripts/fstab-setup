#!/usr/bin/env bash
# Configuration variables are loaded from the runtime-selected setup.conf.
# shellcheck disable=SC2154

set -Eeuo pipefail
umask 077

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="${repository_root:-$(cd -- "$script_dir/../.." && pwd)}"

# Runtime-derived paths allow direct execution and sourcing from setup.sh.
# shellcheck disable=SC1090,SC1091
source "$repository_root/lib/common.sh"
if [[ ${FSTAB_SETUP_SKIP_CONFIG:-no} != yes ]]; then
	# shellcheck disable=SC1090,SC1091
	source "${SETUP_CONFIG_FILE:-$repository_root/setup.conf}"
fi

fstab-setup.validate_configuration() {
	common.require_nonempty "root_dev" "${root_dev:-}"
	common.require_nonempty "efi_dev" "${efi_dev:-}"
	common.require_nonempty "mp" "${mp:-}"
	common.require_nonempty "root_sub_vol" "${root_sub_vol:-}"
	common.require_nonempty "btrfs_options" "${btrfs_options:-}"

	[[ $root_dev != /dev/* ]] ||
		log.die "root_dev must be configured without the /dev/ prefix."
	[[ $mp == /* && $mp != / ]] ||
		log.die "mp must be an absolute path other than /."
	[[ $root_sub_vol != /* && $root_sub_vol != *..* ]] ||
		log.die "root_sub_vol must be a safe relative Btrfs path."
}

fstab-setup.device_uuid() {
	local device=$1
	local description=$2
	local uuid

	uuid="$(blkid -c /dev/null -s UUID -o value "$device")"
	common.require_nonempty "$description UUID" "$uuid"
	printf '%s\n' "$uuid"
}

fstab-setup.build_entries() {
	local options=$1
	local subvolume_root=$2

	cat <<-EOF
		/dev/mapper/root /home             btrfs ${options},subvol=${subvolume_root}/@home 0 2
		/dev/mapper/root /var/log          btrfs ${options},subvol=${subvolume_root}/@log 0 0
		/dev/mapper/root /var/cache        btrfs ${options},subvol=${subvolume_root}/@cache 0 0
		/dev/mapper/root /tmp              btrfs ${options},subvol=${subvolume_root}/@tmp 0 0
		/dev/mapper/root /var/lib/libvirt/ btrfs defaults,ssd,discard=async,noatime,space_cache=v2,subvol=${subvolume_root}/@libvirt 0 0
		/dev/mapper/root /var/lib/docker   btrfs defaults,ssd,discard=async,noatime,compress=zstd:1,subvol=${subvolume_root}/@docker 0 0
		/dev/mapper/root /swap             btrfs defaults,noatime,subvol=${subvolume_root}/@swap 0 0
		/swap/swapfile none                swap  defaults,pri=10 0 0
	EOF
}

fstab-setup.build_root_entry() {
	local options=$1
	local subvolume_root=$2

	printf '/dev/mapper/root / btrfs %s,subvol=%s/@ 0 1\n' \
		"$options" "$subvolume_root"
}

fstab-setup.build_fstab() {
	local root_uuid=$1
	local efi_uuid=$2
	local options=$3
	local subvolume_root=$4

	printf 'UUID=%s / btrfs %s,subvol=%s/@ 0 1\n' \
		"$root_uuid" "$options" "$subvolume_root"
	printf 'UUID=%s /boot/efi vfat umask=0077 0 1\n' "$efi_uuid"
	fstab-setup.build_entries "$options" "$subvolume_root"
}

fstab-setup.run() {
	local fstab_file="$mp/etc/fstab"
	local temporary_file
	local root_uuid
	local efi_uuid

	log.section "Persistent Btrfs mounts"
	root_uuid="$(fstab-setup.device_uuid /dev/mapper/root "Root filesystem")"
	efi_uuid="$(fstab-setup.device_uuid "/dev/$efi_dev" "EFI filesystem")"
	temporary_file="$(mktemp "${fstab_file}.XXXXXX")"
	fstab-setup.build_fstab "$root_uuid" "$efi_uuid" "$btrfs_options" "$root_sub_vol" >"$temporary_file"
	install -m 0644 "$temporary_file" "$fstab_file"
	rm -f -- "$temporary_file"
	log.info "Regenerated $fstab_file from the root and EFI filesystem UUIDs"
	log.success "Persistent Btrfs and swap mounts written to $fstab_file"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	common.require_root
	fstab-setup.validate_configuration
	fstab-setup.run
fi
