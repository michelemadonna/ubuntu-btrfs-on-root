#!/usr/bin/env bash
# Configuration variables are loaded from the runtime-selected setup.conf.
# shellcheck disable=SC2154

set -Eeuo pipefail
umask 077

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="${repository_root:-$(cd -- "$script_dir/../.." && pwd)}"

# Runtime-derived paths allow direct execution and sourcing from setup.sh.
# shellcheck disable=SC1090,SC1091
source "$repository_root/lib/common.sh"
# shellcheck disable=SC1090,SC1091
source "${SETUP_CONFIG_FILE:-$repository_root/setup.conf}"

btrfs-subvol-setup.validate_configuration() {
	common.require_nonempty "root_dev" "${root_dev:-}"
	common.require_nonempty "mp" "${mp:-}"
	common.require_nonempty "root_sub_vol" "${root_sub_vol:-}"
	common.require_nonempty "swap_size" "${swap_size:-}"

	[[ $root_dev != /dev/* ]] ||
		log.die "root_dev must be configured without the /dev/ prefix."
	[[ $mp == /* && $mp != / ]] ||
		log.die "mp must be an absolute path other than /."
	[[ $root_sub_vol != /* && $root_sub_vol != *..* ]] ||
		log.die "root_sub_vol must be a safe relative Btrfs path."
}

btrfs-subvol-setup.validate_source_filesystem() {
	local source_device="/dev/$root_dev"
	local filesystem_type
	local mounted_source

	[[ -b $source_device ]] || log.die "Configured root device is not a block device: $source_device"
	filesystem_type="$(blkid -c /dev/null -s TYPE -o value "$source_device")"
	[[ $filesystem_type == btrfs ]] ||
		log.die "Root partition must contain Btrfs before subvolume creation; detected '${filesystem_type:-unknown}' on $source_device."
	mounted_source="$(findmnt -rn -M "$mp" -o SOURCE 2>/dev/null || true)"
	mounted_source=${mounted_source%%\[*}
	[[ -n $mounted_source && $(readlink -f -- "$mounted_source") == "$(readlink -f -- "$source_device")" ]] ||
		log.die "Configured root device $source_device is not mounted at $mp."
	log.success "Validated Btrfs root source $source_device mounted at $mp"
}

btrfs-subvol-setup.copy_separate_boot() {
	local copied_root=$1
	local source_boot="$mp/boot"
	local destination_boot="$copied_root/boot"

	[[ -n ${boot_dev:-} ]] || return 0
	log.info "Copy separate /boot content from /dev/$boot_dev into $destination_boot"
	mkdir -p "$destination_boot"
	cp -a -- "$source_boot/." "$destination_boot/"
	[[ -n $(find "$destination_boot" -mindepth 1 -print -quit) ]] ||
		log.die "Separate boot partition /dev/$boot_dev contained no files to migrate."
	sync
	log.success "Copied separate /boot content into the encrypted Btrfs root"
	log.info "Unmount migrated separate boot partition from $source_boot"
	umount "$source_boot"
}

btrfs-subvol-setup.move_directory_contents() (
	local source_directory=$1
	local destination_directory=$2
	local -a entries=()

	shopt -s dotglob nullglob
	entries=("$source_directory"/*)

	if ((${#entries[@]} == 0)); then
		log.info "No existing files to move from $source_directory"
		return
	fi

	log.info "Move ${#entries[@]} entries from $source_directory to $destination_directory"
	mv -- "${entries[@]}" "$destination_directory"
)

btrfs-subvol-setup.create_data_subvolume() {
	local name=$1
	local path="$root_sub_vol/$name"

	log.info "Create Btrfs subvolume $path"
	btrfs subvolume create "$path"
}

btrfs-subvol-setup.validate_kali_sources() {
	local source_root=$1
	local name

	for name in @ @home @root @usr@local @var@log @.snapshots; do
		[[ -d $source_root/$name ]] ||
			log.die "Kali source subvolume is missing: $name"
	done
}

btrfs-subvol-setup.copy_kali_tree() {
	local source_root=$1
	local destination_root=$2

	log.info "Copy Kali root subvolume into $destination_root/@"
	rsync -aHAXx --numeric-ids "$source_root/@/." "$destination_root/@/"
	log.info "Copy Kali @root into $destination_root/@/root"
	mkdir -p "$destination_root/@/root"
	rsync -aHAXx --numeric-ids "$source_root/@root/." "$destination_root/@/root/"
	log.info "Copy Kali @usr@local into $destination_root/@/usr/local"
	mkdir -p "$destination_root/@/usr/local"
	rsync -aHAXx --numeric-ids "$source_root/@usr@local/." "$destination_root/@/usr/local/"
	log.info "Copy Kali home into $destination_root/@home"
	rsync -aHAXx --numeric-ids "$source_root/@home/." "$destination_root/@home/"
	log.info "Copy Kali cache into $destination_root/@cache"
	rsync -aHAXx --numeric-ids "$source_root/@/var/cache/." "$destination_root/@cache/"
	log.info "Copy Kali log into $destination_root/@log"
	rsync -aHAXx --numeric-ids "$source_root/@var@log/." "$destination_root/@log/"
}

btrfs-subvol-setup.remove_kali_sources() {
	local source_root=$1
	local name

	for name in @ @home @root @usr@local @var@log @.snapshots; do
		log.info "Remove migrated Kali source subvolume $name"
		btrfs subvolume delete "$source_root/$name"
	done
}

btrfs-subvol-setup.run_kali() {
	local source_device="/dev/$root_dev"
	local boot_backup=${1:-}
	local source_root="$mp"
	local destination_root="$root_sub_vol"
	local name

	log.section "Kali Btrfs layout migration"
	btrfs-subvol-setup.validate_kali_sources "$source_root"
	log.info "Create distribution container subvolume $destination_root"
	btrfs subvolume create "$destination_root"
	btrfs subvolume create "$destination_root/@"
	for name in @home @cache @log @tmp @libvirt @docker @swap; do
		btrfs-subvol-setup.create_data_subvolume "$name"
	done
	btrfs-subvol-setup.copy_kali_tree "$source_root" "$destination_root"
	if [[ -n $boot_backup ]]; then
		log.info "Copy backed-up separate /boot into $destination_root/@/boot"
		mkdir -p "$destination_root/@/boot"
		rsync -aHAXx --numeric-ids "$boot_backup/." "$destination_root/@/boot/"
	fi
	btrfs filesystem mkswapfile --size "$swap_size" "$destination_root/@swap/swapfile"
	[[ -n $(find "$destination_root/@" -mindepth 1 -print -quit) ]] ||
		log.die "Kali root copy is empty."
	btrfs-subvol-setup.remove_kali_sources "$source_root"

	cd /
	log.info "Unmount Kali top-level filesystem from $mp"
	umount "$mp"
	log.info "Mount normal root subvolume $destination_root/@ from $source_device"
	mount "$source_device" -o "subvol=$destination_root/@" "$mp"
	log.success "Kali Btrfs layout migration completed"
	log.section_end
}

btrfs-subvol-setup.run() {
	local source_device="/dev/$root_dev"
	local copied_root="$root_sub_vol/@"
	local boot_backup=''

	log.section "Btrfs subvolume layout"
	btrfs-subvol-setup.validate_source_filesystem
	log.info "Use existing source Btrfs mount $source_device at $mp"
	if [[ $suite_type == kali && -n ${boot_dev:-} ]]; then
		boot_backup="$(mktemp -d /tmp/kali-boot.XXXXXX)"
		log.info "Back up separate /boot before switching to the Kali top-level mount"
		rsync -aHAXx --numeric-ids "$mp/boot/." "$boot_backup/"
		[[ -n $(find "$boot_backup" -mindepth 1 -print -quit) ]] ||
			log.die "Separate boot partition /dev/$boot_dev contained no files to migrate."
		umount "$mp/boot"
	fi
	if [[ $suite_type == kali ]]; then
		cd /
		umount "$mp"
		mount "$source_device" -o subvolid=5 "$mp"
		btrfs-subvol-setup.run_kali "$boot_backup"
		[[ -z $boot_backup ]] || rm -Rf -- "$boot_backup"
		return
	fi
	cd "$mp"

	log.info "Create distribution container subvolume $root_sub_vol"
	btrfs subvolume create "$root_sub_vol"
	log.info "Snapshot the installed filesystem into $copied_root"
	btrfs subvolume snapshot . "$copied_root"

	log.info "Remove nested installer subvolume copy $copied_root/$root_sub_vol"
	rm -Rf -- "${copied_root:?}/${root_sub_vol:?}"
	btrfs-subvol-setup.copy_separate_boot "$copied_root"

	btrfs-subvol-setup.create_data_subvolume "@home"
	btrfs-subvol-setup.move_directory_contents "$copied_root/home" "$root_sub_vol/@home"
	btrfs-subvol-setup.create_data_subvolume "@cache"
	btrfs-subvol-setup.move_directory_contents "$copied_root/var/cache" "$root_sub_vol/@cache"
	btrfs-subvol-setup.create_data_subvolume "@log"
	btrfs-subvol-setup.move_directory_contents "$copied_root/var/log" "$root_sub_vol/@log"
	btrfs-subvol-setup.create_data_subvolume "@tmp"
	btrfs-subvol-setup.create_data_subvolume "@libvirt"
	btrfs-subvol-setup.create_data_subvolume "@docker"
	btrfs-subvol-setup.create_data_subvolume "@swap"

	log.info "Create Btrfs swapfile $root_sub_vol/@swap/swapfile with size $swap_size"
	btrfs filesystem mkswapfile \
		--size "$swap_size" \
		"$root_sub_vol/@swap/swapfile"

	log.info "Remove the original top-level installation files after snapshotting"
	find . -maxdepth 1 ! -name '@*' ! -name . -exec rm -Rf -- {} \;

	cd /
	log.info "Unmount source filesystem from $mp"
	umount "$mp"
	log.info "Mount normal root subvolume $copied_root at $mp"
	mount "$source_device" -o "subvol=$copied_root" "$mp"
	log.success "Btrfs subvolume layout created"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	common.require_root
	btrfs-subvol-setup.validate_configuration
	btrfs-subvol-setup.run
fi
