#!/usr/bin/env bash
# Cross-disk target discovery, initialization and source import.
# shellcheck disable=SC2153,SC2154

set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="${repository_root:-$(cd -- "$script_dir/../.." && pwd)}"

# shellcheck disable=SC1090,SC1091
source "$repository_root/lib/common.sh"

cross-disk-migration.partition_by_label() {
	local disk=$1 label=$2
	lsblk -nrpo PATH,PARTLABEL "$disk" | awk -v label="$label" '$2 == label { print $1 }'
}

cross-disk-migration.initialized_target() {
	local disk=$1 esp root esp_count root_count
	esp="$(cross-disk-migration.partition_by_label "$disk" ESP)"
	root="$(cross-disk-migration.partition_by_label "$disk" ROOT)"
	esp_count="$(awk 'NF { count++ } END { print count + 0 }' <<<"$esp")"
	root_count="$(awk 'NF { count++ } END { print count + 0 }' <<<"$root")"
	((esp_count == 1 && root_count == 1))
}

cross-disk-migration.require_unique_label() {
	local disk=$1 label=$2 result
	result="$(cross-disk-migration.partition_by_label "$disk" "$label")"
	[[ -n $result && $(awk 'NF { count++ } END { print count + 0 }' <<<"$result") -eq 1 ]] ||
		log.die "Disk $disk must contain exactly one partition labelled $label."
	printf '%s\n' "$result"
}

cross-disk-migration.import_checkpoint_valid() {
	local target_mount=$1 marker expected luks_uuid

	marker="$target_mount/$root_sub_vol/@/var/lib/ubuntu-btrfs-on-root/checkpoints/$suite.source-import"
	[[ -r $marker ]] || return 1
	luks_uuid="$(blkid -c /dev/null -s UUID -o value "/dev/$root_dev")"
	expected="$luks_uuid:$suite"
	[[ $(<"$marker") == "$expected" ]] ||
		log.die "Source-import checkpoint identity mismatch: $marker"
}

cross-disk-migration.ensure_target_mapper() {
	local expected_device="/dev/$root_dev"
	local mapped_device

	if [[ ! -e /dev/mapper/root ]]; then
		log.info "Open target ROOT mapper $expected_device as /dev/mapper/root"
		printf '%s' "$PASSPHRASE" | cryptsetup open --key-file=- "$expected_device" root
		return
	fi
	mapped_device="$(cryptsetup status root | awk '$1 == "device:" { print $2; exit }')"
	common.require_nonempty "Backing device for mapper root" "$mapped_device"
	[[ $(readlink -f -- "$mapped_device") == "$(readlink -f -- "$expected_device")" ]] ||
		log.die "Existing mapper root belongs to $mapped_device, not $expected_device; refusing to reuse it."
	log.info "Reuse already-open target mapper /dev/mapper/root for $expected_device"
}

cross-disk-migration.mounted_import_valid() {
	local target_mount=$1 mounted_source marker expected luks_uuid

	mountpoint -q "$target_mount" || return 1
	mounted_source="$(findmnt -rn -M "$target_mount" -o SOURCE)"
	mounted_source=${mounted_source%%\[*}
	[[ $(readlink -f -- "$mounted_source") == "$(readlink -f -- /dev/mapper/root)" ]] ||
		log.die "$target_mount is mounted from $mounted_source instead of /dev/mapper/root."
	marker="$target_mount/var/lib/ubuntu-btrfs-on-root/checkpoints/$suite.source-import"
	if [[ -r $marker ]]; then
		luks_uuid="$(blkid -c /dev/null -s UUID -o value "/dev/$root_dev")"
		expected="$luks_uuid:$suite"
		[[ $(<"$marker") == "$expected" ]] ||
			log.die "Source-import checkpoint identity mismatch: $marker"
		return 0
	fi
	[[ -f $target_mount/etc/fstab ]] &&
		grep -Fq "subvol=$root_sub_vol/@" "$target_mount/etc/fstab"
}

cross-disk-migration.available_root_mib() {
	local disk_mib=$1 esp_mib=$2 rescue_mib=$3 windows=$4
	local windows_mib=0 msr_mib=0 layout_overhead_mib=0

	if [[ $windows == yes ]]; then
		windows_mib=65536
		msr_mib=16
		# Reserve the leading 1 MiB alignment gap and trailing backup GPT area.
		layout_overhead_mib=2
	fi
	printf '%s\n' "$((disk_mib - esp_mib - rescue_mib - msr_mib - windows_mib - 1024 - layout_overhead_mib))"
}

cross-disk-migration.log_copy_inventory() {
	local label=$1 path=$2 entries usage

	[[ -d $path ]] || log.die "Copy inventory path is missing: $path"
	entries="$(find "$path" -mindepth 1 -maxdepth 1 -printf '\n' | awk 'END { print NR + 0 }')"
	usage="$(du -sh --apparent-size -- "$path" | awk '{ print $1 }')"
	log.info "$label: path=$path, direct entries=$entries, apparent size=$usage"
}

cross-disk-migration.layout() {
	local disk=$1 esp_mib=$2 root_size=$3 rescue_mib=$4 windows=$5
	local disk_mib windows_mib=0 root_mib
	disk_mib=$(($(blockdev --getsize64 "$disk") / 1024 / 1024))
	if [[ $windows == yes ]]; then
		windows_mib=65536
	fi
	if [[ $root_size == all ]]; then
		root_mib="$(cross-disk-migration.available_root_mib "$disk_mib" "$esp_mib" "$rescue_mib" "$windows")"
	else
		root_mib=$((root_size * 1024))
	fi
	cat <<-EOF
		Target disk: $disk
		ESP:         ${esp_mib} MiB, GPT type EF00, label ESP, FAT32
	EOF
	if ((rescue_mib > 0)); then
		printf '\t\tRESCUE:     %s MiB, GPT type 0700, label RESCUE/UBUNTU_LIVE, FAT32\n' "$rescue_mib"
	fi
	cat <<-EOF
		ROOT:        ${root_mib} MiB, GPT type 8300, label ROOT, LUKS2
	EOF
	if [[ $windows == yes ]]; then
		cat <<-EOF
			MSR:         16 MiB, GPT type 0C01, label MSR
			WINDOWS:     ${windows_mib} MiB, GPT type 0700, label WINDOWS, NTFS
			WINRE:       1024 MiB, GPT type 2700, label WINRE, NTFS
		EOF
	fi
	cat <<-EOF
		Warning: all existing data and partition metadata on $disk will be destroyed.
	EOF
}

cross-disk-migration.partition_new_target() {
	local disk=$1 esp_mib=$2 root_size=$3 rescue=$4 windows=$5 iter_time=$6 passphrase=$7
	local disk_mib total_mib
	local esp_dev rescue_dev windows_dev winre_dev root_dev
	local windows_mib=0 msr_mib=0 layout_overhead_mib=0 root_mib
	local next
	local -a partition_args=()

	common.require_commands awk blkid blockdev cryptsetup mkdir mkfs.btrfs mkfs.fat mount mountpoint partprobe sgdisk
	if [[ $windows == yes ]]; then
		common.require_commands mkfs.ntfs
	fi
	disk_mib=$(($(blockdev --getsize64 "$disk") / 1024 / 1024))
	[[ $esp_mib =~ ^[1-9][0-9]*$ ]] || log.die "ESP size must be a positive integer in MiB."
	[[ $rescue =~ ^[0-9]+$ ]] || log.die "Rescue size must be an integer in MiB."
	[[ $root_size == all || $root_size =~ ^[1-9][0-9]*$ ]] || log.die "ROOT size must be 'all' or a positive GiB value."
	((esp_mib >= 256)) || log.die "ESP must be at least 256 MiB."
	((disk_mib > esp_mib + 10240)) || log.die "Target disk is too small for the requested layout."
	if [[ $windows == yes ]]; then
		windows_mib=65536
		msr_mib=16
		layout_overhead_mib=2
	fi
	if [[ $root_size == all ]]; then
		root_mib="$(cross-disk-migration.available_root_mib "$disk_mib" "$esp_mib" "$rescue" "$windows")"
	else
		root_mib=$((root_size * 1024))
	fi
	((root_mib >= 10240)) || log.die "ROOT must have at least 10 GiB after reserved partitions."

	total_mib=$((esp_mib + rescue + msr_mib + windows_mib + 1024 + root_mib + layout_overhead_mib))
	((total_mib <= disk_mib)) || log.die "Requested target layout exceeds disk capacity."

	log.section "Create target GPT layout"
	log.info "Use 1 MiB / 2048-sector alignment for SSD-friendly partition boundaries"
	sgdisk -a 2048 --zap-all "$disk"
	partition_args+=(
		-n "1:0:+${esp_mib}M" -t 1:ef00 -c 1:ESP
	)
	next=2
	if ((rescue > 0)); then
		partition_args+=(
			-n "${next}:0:+${rescue}M" -t "${next}:0700" -c "${next}:RESCUE"
		)
		next=$((next + 1))
	fi
	if [[ $root_size == all && $windows != yes ]]; then
		partition_args+=(
			-n "${next}:0:0" -t "${next}:8300" -c "${next}:ROOT"
		)
	else
		partition_args+=(
			-n "${next}:0:+${root_mib}M" -t "${next}:8300" -c "${next}:ROOT"
		)
	fi
	next=$((next + 1))
	if [[ $windows == yes ]]; then
		partition_args+=(
			-n "${next}:0:+16M" -t "${next}:0C01" -c "${next}:MSR"
		)
		next=$((next + 1))
		partition_args+=(
			-n "${next}:0:+${windows_mib}M" -t "${next}:0700" -c "${next}:WINDOWS"
		)
		next=$((next + 1))
		partition_args+=(
			-n "${next}:0:+1024M" -t "${next}:2700" -c "${next}:WINRE"
		)
	fi
	sgdisk -a 2048 "${partition_args[@]}" "$disk"
	partprobe "$disk"
	esp_dev="$(cross-disk-migration.require_unique_label "$disk" ESP)"
	rescue_dev=""
	if ((rescue > 0)); then
		rescue_dev="$(cross-disk-migration.require_unique_label "$disk" RESCUE)"
	fi
	if [[ $windows == yes ]]; then
		windows_dev="$(cross-disk-migration.require_unique_label "$disk" WINDOWS)"
		winre_dev="$(cross-disk-migration.require_unique_label "$disk" WINRE)"
	fi
	root_dev="$(cross-disk-migration.require_unique_label "$disk" ROOT)"

	mkfs.fat -F32 -n ESP "$esp_dev"
	if [[ -n $rescue_dev ]]; then
		mkfs.fat -F32 -n RESCUE "$rescue_dev"
	fi
	if [[ $windows == yes ]]; then
		mkfs.ntfs -f -L WINDOWS "$windows_dev"
		mkfs.ntfs -f -L WINRE "$winre_dev"
	fi
	printf '%s' "$passphrase" | cryptsetup luksFormat --type luks2 --pbkdf argon2id --iter-time "$iter_time" --label ROOT --key-file=- "$root_dev"
	[[ ! -e /dev/mapper/root ]] || log.die "Mapper /dev/mapper/root is already open; close it before target initialization."
	printf '%s' "$passphrase" | cryptsetup open --key-file=- "$root_dev" root ||
		log.die "Unable to reopen the new ROOT LUKS container."
	if ! mkfs.btrfs /dev/mapper/root; then
		cryptsetup close root || true
		log.die "Unable to create Btrfs inside the new ROOT LUKS container."
	fi
	[[ $(blkid -c /dev/null -s TYPE -o value /dev/mapper/root) == btrfs ]] || {
		cryptsetup close root || true
		log.die "Btrfs validation failed inside the new ROOT LUKS container."
	}
	mkdir -p "$mp"
	if mountpoint -q "$mp"; then
		log.die "Target mount point is already in use: $mp"
	fi
	mount /dev/mapper/root -o "$btrfs_options,subvolid=5" "$mp"
	log.summary_item "Target ROOT" "$root_dev (LUKS2 label ROOT, Btrfs mounted at $mp)"
	log.success "Target mapper remains open and its Btrfs top level remains mounted at $mp"
	log.success "Target disk initialized; run setup.sh again to migrate the source."
	log.section_end
}

cross-disk-migration.import_source() {
	local source_root=$1 source_boot=${2:-}
	local source_mount target_mount source_boot_mount destination mapper_filesystem target_fsroot

	source_mount="$(mktemp -d /tmp/cross-disk-source.XXXXXX)"
	target_mount="$mp"
	common.require_commands awk bash blkid mount mountpoint umount btrfs mkfs.btrfs rsync cryptsetup du find findmnt grep readlink
	[[ $(blkid -c /dev/null -s TYPE -o value "/dev/$source_root") == btrfs ]] ||
		log.die "Source root /dev/$source_root must contain Btrfs."
	if [[ $suite_type == kali ]]; then
		mount -o subvolid=5 "/dev/$source_root" "$source_mount"
	else
		mount "/dev/$source_root" "$source_mount"
	fi
	cross-disk-migration.ensure_target_mapper
	mapper_filesystem="$(blkid -c /dev/null -s TYPE -o value /dev/mapper/root 2>/dev/null || true)"
	if [[ -z $mapper_filesystem ]]; then
		log.info "Initialize the empty target ROOT mapper as Btrfs"
		mkfs.btrfs /dev/mapper/root
	elif [[ $mapper_filesystem != btrfs ]]; then
		log.die "Target ROOT mapper contains unsupported filesystem '$mapper_filesystem'."
	fi
	if cross-disk-migration.mounted_import_valid "$target_mount"; then
		log.warn "Resume with the already-mounted cross-disk suite $root_sub_vol/@"
		umount "$source_mount"
		rmdir "$source_mount"
		return 0
	fi
	if mountpoint -q "$target_mount"; then
		target_fsroot="$(findmnt -rn -M "$target_mount" -o FSROOT)"
		[[ $target_fsroot == / ]] ||
			log.die "$target_mount is already mounted from Btrfs path $target_fsroot instead of the top level."
		log.info "Reuse already-mounted target Btrfs top level at $target_mount"
	else
		log.info "Mount target Btrfs top level from /dev/mapper/root at $target_mount"
		mount /dev/mapper/root -o "$btrfs_options,subvolid=5" "$target_mount"
	fi
	if [[ -e $target_mount/$root_sub_vol ]]; then
		if cross-disk-migration.import_checkpoint_valid "$target_mount" || {
			[[ -f $target_mount/$root_sub_vol/@/etc/fstab ]] &&
				grep -Fq "subvol=$root_sub_vol/@" "$target_mount/$root_sub_vol/@/etc/fstab"
		}; then
			log.warn "Resume a previously imported cross-disk suite $root_sub_vol without copying it again"
			umount "$source_mount"
			rmdir "$source_mount"
			umount "$target_mount"
			mount /dev/mapper/root -o "$btrfs_options,subvol=$root_sub_vol/@" "$target_mount"
			return 0
		fi
		log.die "Target already contains the suite container $root_sub_vol."
	fi
	btrfs subvolume create "$target_mount/$root_sub_vol"
	btrfs subvolume create "$target_mount/$root_sub_vol/@"
	for name in @home @cache @log @tmp @libvirt @docker @swap; do
		btrfs subvolume create "$target_mount/$root_sub_vol/$name"
		case $name in
		@home | @cache | @log | @libvirt) chmod 0755 "$target_mount/$root_sub_vol/$name" ;;
		@docker) chmod 0711 "$target_mount/$root_sub_vol/$name" ;;
		@tmp) chmod 1777 "$target_mount/$root_sub_vol/$name" ;;
		@swap) chmod 0700 "$target_mount/$root_sub_vol/$name" ;;
		esac
	done
	if [[ $suite_type == kali ]]; then
		for name in @ @home @root @usr@local @var@log; do
			[[ -d $source_mount/$name ]] || log.die "Kali source subvolume is missing: $name"
		done
		log.info "Copy Kali $source_mount/@ -> $target_mount/$root_sub_vol/@ (root filesystem)"
		rsync -aHAXx --numeric-ids --info=progress2 "$source_mount/@/." "$target_mount/$root_sub_vol/@/"
		mkdir -p "$target_mount/$root_sub_vol/@/root" "$target_mount/$root_sub_vol/@/usr/local"
		log.info "Copy Kali $source_mount/@root -> $target_mount/$root_sub_vol/@/root"
		rsync -aHAXx --numeric-ids --info=progress2 "$source_mount/@root/." "$target_mount/$root_sub_vol/@/root/"
		log.info "Copy Kali $source_mount/@usr@local -> $target_mount/$root_sub_vol/@/usr/local"
		rsync -aHAXx --numeric-ids --info=progress2 "$source_mount/@usr@local/." "$target_mount/$root_sub_vol/@/usr/local/"
		log.info "Copy Kali $source_mount/@home -> $target_mount/$root_sub_vol/@home"
		rsync -aHAXx --numeric-ids --info=progress2 "$source_mount/@home/." "$target_mount/$root_sub_vol/@home/"
		if [[ -d $source_mount/@/var/cache ]]; then
			log.info "Copy Kali $source_mount/@/var/cache -> $target_mount/$root_sub_vol/@cache"
			rsync -aHAXx --numeric-ids --info=progress2 "$source_mount/@/var/cache/." "$target_mount/$root_sub_vol/@cache/"
		fi
		log.info "Copy Kali $source_mount/@var@log -> $target_mount/$root_sub_vol/@log"
		rsync -aHAXx --numeric-ids --info=progress2 "$source_mount/@var@log/." "$target_mount/$root_sub_vol/@log/"
	else
		log.info "BEGIN Ubuntu root copy: $source_mount -> $target_mount/$root_sub_vol/@"
		cross-disk-migration.log_copy_inventory "Ubuntu root source" "$source_mount"
		rsync -aHAXx --numeric-ids --itemize-changes --info=progress2 "$source_mount/." "$target_mount/$root_sub_vol/@/"
		cross-disk-migration.log_copy_inventory "Ubuntu root destination" "$target_mount/$root_sub_vol/@"
		log.success "END Ubuntu root copy: $source_mount -> $target_mount/$root_sub_vol/@"
		for name in home var/cache var/log; do
			destination="$target_mount/$root_sub_vol/@$([[ $name == home ]] && printf home || [[ $name == var/cache ]] && printf cache || printf log)"
			mkdir -p "$destination"
			log.info "BEGIN Ubuntu data copy: $target_mount/$root_sub_vol/@/$name -> $destination"
			cross-disk-migration.log_copy_inventory "Ubuntu $name source" "$target_mount/$root_sub_vol/@/$name"
			if [[ $name == home && -z $(find "$target_mount/$root_sub_vol/@/$name" -mindepth 1 -print -quit) ]]; then
				log.warn "Ubuntu home is already empty immediately after the root copy; no home data can be moved to $destination"
			fi
			rsync -aHAXx --numeric-ids --itemize-changes --info=progress2 "$target_mount/$root_sub_vol/@/$name/." "$destination/"
			cross-disk-migration.log_copy_inventory "Ubuntu $name destination" "$destination"
			log.success "END Ubuntu data copy: $target_mount/$root_sub_vol/@/$name -> $destination"
			find "$target_mount/$root_sub_vol/@/$name" -mindepth 1 -maxdepth 1 -exec rm -Rf -- {} +
			log.info "Removed migrated contents from $target_mount/$root_sub_vol/@/$name"
		done
	fi
	log.info "Remove source snapshot directories before creating target Snapper profiles"
	rm -Rf -- "$target_mount/$root_sub_vol/@/.snapshots" "$target_mount/$root_sub_vol/@home/.snapshots"
	btrfs filesystem mkswapfile --size "$swap_size" "$target_mount/$root_sub_vol/@swap/swapfile"
	if [[ -n $source_boot ]]; then
		source_boot_mount="$(mktemp -d /tmp/cross-disk-boot.XXXXXX)"
		mount "/dev/$source_boot" "$source_boot_mount"
		mkdir -p "$target_mount/$root_sub_vol/@/boot"
		log.info "Copy separate boot $source_boot_mount -> $target_mount/$root_sub_vol/@/boot"
		rsync -aHAXx --numeric-ids --info=progress2 "$source_boot_mount/." "$target_mount/$root_sub_vol/@/boot/"
		umount "$source_boot_mount"
		rmdir "$source_boot_mount"
	fi
	log.warn "Source import copy completed. Opening an inspection shell before continuing."
	log.info "Source root: $source_mount"
	log.info "Target Btrfs top level: $target_mount"
	log.info "Target suite: $target_mount/$root_sub_vol"
	log.info "Run 'exit' to continue the installation."
	(
		cd "$target_mount"
		export MIGRATION_SOURCE_ROOT="$source_mount"
		export MIGRATION_TARGET_TOP_LEVEL="$target_mount"
		export MIGRATION_TARGET_SUITE="$target_mount/$root_sub_vol"
		bash --noprofile --norc -i
	)
	log.info "Inspection shell closed; continue source import finalization"
	umount "$source_mount"
	rmdir "$source_mount"
	umount "$target_mount"
	mount /dev/mapper/root -o "$btrfs_options,subvol=$root_sub_vol/@" "$target_mount"
	log.success "Source root imported into $root_sub_vol/@"
}
