setup_fstab(){
    root_uuid="$(blkid --output export "/dev/$root_dev" | grep ^UUID=)"
    echo "Patch /etc/fstab"

    sed --in-place \
        "s!^.* / btrfs defaults 0 1\$!$root_uuid / btrfs defaults,ssd,discard=async,noatime,space_cache=v2,compress=zstd:1,subvol=@ 0 1!" \
        /etc/fstab

    echo "$root_uuid /home              btrfs defaults,ssd,discard=async,noatime,space_cache=v2,compress=zstd:1,subvol=@home 0 2" >> /etc/fstab
    echo "$root_uuid /var/log           btrfs defaults,ssd,discard=async,noatime,space_cache=v2,compress=zstd:1,subvol=@log 0 0" >> /etc/fstab 
    echo "$root_uuid /var/cache         btrfs defaults,ssd,discard=async,noatime,space_cache=v2,compress=zstd:1,subvol=@cache 0 0" >> /etc/fstab
    echo "$root_uuid /tmp               btrfs defaults,ssd,discard=async,noatime,space_cache=v2,compress=zstd:1,subvol=@tmp 0 0" >> /etc/fstab
    echo "$root_uuid /var/lib/libvirt/  btrfs defaults,ssd,discard=async,noatime,space_cache=v2,subvol=@libvirt 0 0" >> /etc/fstab
    echo "$root_uuid /swap              btrfs defaults,subvol=@swap 0 0" >> /etc/fstab
    echo "/swap/swapfile   none         swap  defaults,ssd,discard=async,noatime 0 0" >> /etc/fstab

    

    update-initramfs -u    
}

