	fi
	unzip /tmp/refind_themes.zip -d /boot/efi/EFI/refind/

	cat >> /boot/efi/EFI/refind/refind.conf <<-EOF
		enable_touch
		enable_mouse
		use_graphics_for osx,linux
		include themes/refind-theme-regular/theme.conf
	EOF



