# ------------------------------
# Inner chroot execution
# ------------------------------

if [[ "$1" = "//inner" ]]; then    
	setup_snapper
	secure_boot_status=$(secureboot_state)

	echo "Secure Boot is " "$secure_boot_status"
	
	if [[ -n $boot_dev ]]; then
		echo "Config Boot partition separated"
		e2label /dev/"$boot_dev" "BOOT_UBUNTU"
		
		if [[ $only_subvols  = "yes" ]]; then
			 echo "Config NON Encrypt"
			setup_fstab
			if [[ $secure_boot_status = "enabled" ]]; then
				echo "Secure Boot enabled"
				#if secure boot is enabled and not in setup mode (we can't enroll new MOK) only Ubuntu signed grub/kernel can be used
				echo "Install $bootloader"
				setup_grub             
			elif [[ $secure_boot_status = "setup" ]]; then
				echo "Secure Boot in Setup Mode"
				echo "Install $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub
				elif [[ $bootloader = "refind" ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi
				setup_custom_secure_boot_key
			else
				echo "Secure Boot Disabled"
				echo "Install $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub                  
				elif [[ $bootloader = ""refind ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi
			fi
		else
			echo "Config Encrypt"
			setup_fstab_crpttab
			if [[ "$secure_boot_status" = enabled ]]; then
				echo "Secure Boot enabled"
				#if secure boot is enabled and not in setup mode (we can't enroll new MOK) only Ubuntu signed grub/kernel can be used
				echo "Install $bootloader"
				setup_grub
				
				if [[ $tpm_unlock = yes ]]; then
					setup_tpm_luks_auto_ulock
				fi
			elif [[ "$secure_boot_status" = custom ]]; then
				echo "Secure Boot in Setup Mode"
				echo "Install $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub
				elif [[ $bootloader = "refind" ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi

				if [[ $tpm_unlock = yes ]]; then
					setup_tpm_luks_auto_ulock
				fi

				setup_custom_secure_boot_key
			else
				echo "Secure Boot Disabled"
				echo "Install $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub
				elif [[ $bootloader = "refind" ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi
			fi
		fi
	else
		echo "Config Boot partition separated"
		fatlabel /dev/$efi_dev "BOOT_EFI"

		if [[ "$only_subvols" = "yes" ]]; then
			echo "Config NON Encrypt"
			setup_fstab
			if [[ "$secure_boot_status" = "enabled" ]]; then
				
				echo "Secure Boot enabled"
				#if secure boot is enabled and not in setup mode (we can't enroll new MOK) only Ubuntu signed grub/kernel can be used
				setup_custom_secure_boot_key
				echo "Install $bootloader"
				setup_grub
				
			elif [[ "$secure_boot_status" = "setup" ]]; then
				echo "Secure Boot in Setup Mode"
				setup_custom_secure_boot_key
				echo "Install $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub
				elif [[ $bootloader = "refind" ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi
				
			else
				echo "Secure Boot Disabled"
				echo "Install $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub
					
				elif [[ $bootloader = "refind" ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi
			fi
		else
			echo "Config Encrypt"
			setup_fstab_crpttab

			if [[ "$secure_boot_status" = "enabled" ]]; then
				echo "Secure Boot enabled and not in Setup-Mode.....Aborting"
				exit
			elif [[ "$secure_boot_status" = "setup" ]]; then
				echo "Secure Boot in Setup Mode"
				setup_custom_secure_boot_key
				echo "Install $bootloader"
				
				if [[ $bootloader = "grub" || $bootloader = "grub+refind" ]]; then
					setup_grub
					if [[ $tpm_unlock = yes ]]; then
						setup_tpm_luks_auto_ulock
					fi
				elif [[ $bootloader = "refind" || $bootloader = "grub+refind" ]]; then
					setup_refind

				fi
			else
				echo "Secure Boot Disabled"
				echo "Install $bootloader"

				if [[ $bootloader = "grub" ]]; then
					setup_grub
				elif [[ $bootloader = "refind" ]]; then
					setup_refind_grub_btrfs
				fi
			fi
		fi
	fi
	umount proc 2>/dev/null || true
	umount home 2>/dev/null || true
	exit

fi


# ------------------------------
# Help
# ------------------------------

show_help() {
	echo "Add @ and @home subvolumes to a Btrfs root partition,"
	echo "and encrypt it optionally"
	echo
	echo "Usage: btrfs-encrypt-root [options] {root-dev} {boot-dev} [{efi-dev}]"
	echo
	echo "The devices must be given without the /dev/ prefix."
	echo
	echo "  --only-subvols            do not encrypt, only create @ and @home"
	echo "  --enlarge                 enlarge root partition to maximum"
	echo
	echo "--enlarge resizes the root partition to 100%. This makes encryption"
	echo "much faster, because you make a small partition for just the"
	echo "installation of the base system, and then you call this script,"
	echo "which has to encrypt only the smaller partition. The enlargement"
	echo "covers only empty space, so no encryption is necessary there."
}

# ------------------------------
# Parse arguments
# ------------------------------


while :; do
	case "$1" in
		-h|-\?|--help)
			show_help
			exit
			;;
		--setup-custom-secure-boot)
			setup_custom_secure_boot_key
			exit
			;;
		--setup-tpm-luks-auto_ulock)
			setup_tpm_luks_auto_ulock
			exit
			;;
		--seal-luks-disk-tpm)
			seal_luks_disk_tpm_unlock_to_secure_boot
			exit
			;;
		--setup-refind)
			setup_refind
			setup_refind_btrfs_menu
			exit
			;;
		--*)
			echo "Invalid option $1. Use --help for more information."
			exit 2
			;;
		*)
			break
	esac
	shift
done

if [[ -z $root_dev ]] || [[ -z $efi_dev ]]; then
	echo "You must pass the device of the root, efi, and optionally"
	echo "Boot partition (without the /dev/) to this script."
	echo
	echo "Use --help for more information."
	exit 2
fi


# ------------------------------
# Main execution
# ------------------------------

preparation
create_subvols

if [[ $only_subvols = no ]]; then
    encrypt_and_enlarge $root_dev
fi

chroot_and_mkinitramfs
unmount_everything

echo "Finished"

