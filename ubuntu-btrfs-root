	#	  }
	#	}
	#EOF

	cat >> /boot/efi/EFI/refind/refind.conf  <<- EOF
		menuentry "Ubuntu Linux" {
			loader /EFI/direct/grubx64.efi
    	icon /EFI/refind/themes/refind-theme-regular/icons/256-96/os_ubuntu.png
    	ostype Linux
		}
	EOF

	if [[ $secure_boot_status = "setup" ]]; then
		for f in btrfs_x64.efi iso9660_x64.efi ext2_x64.efi ext4_x64.efi ; do
    	sbctl sign -s "/boot/efi/EFI/refind/drivers_x64/$f"
		done

		sbctl sign -s "/boot/efi/EFI/refind/refind_x64.efi"
		
	elif [[ $secure_boot_status = "enabled" ]]; then

			for f in btrfs_x64.efi iso9660_x64.efi ext2_x64.efi ext4_x64.efi ; do
    		sbsign --key /etc/efikeys/MOK.key \
				--cert /etc/efikeys/MOK.pem \
				"/boot/efi/EFI/refind/drivers_x64/$f" \
				--output "/boot/efi/EFI/refind/drivers_x64/$f.signed"

				mv "/boot/efi/EFI/refind/drivers_x64/$f.signed" "/boot/efi/EFI/refind/drivers_x64/$f"

			done

			sbsign --key /etc/efikeys/MOK.key \
				--cert /etc/efikeys/MOK.pem \
				/boot/efi/EFI/refind/refind_x64.efi \
				--output /boot/efi/EFI/refind/refind_x64.efi.signed

			mv /boot/efi/EFI/refind/refind_x64.efi.signed /boot/efi/EFI/refind/refind_x64.efi


	fi
	apt-mark hold refind

	cd /
}

