setup_custom_secure_boot_key(){
	
	if [[ $secure_boot_status = "enabled" ]]; then
	
		echo -e "\e[32mINFO:\e[0mEnroll a new Machine Owner Platform key using mokutil"
		mkdir -p /etc/efikeys/
		
		openssl req -new -x509 -newkey rsa:2048 -outform DER -keyout /etc/efikeys/MOK.key -out /etc/efikeys/MOK.der \
		  -nodes -days 3650 -subj "/CN=My MOK/"
		chmod 400 MOK.key
	
		mokutil --import /etc/efikeys/MOK.der
	
		openssl x509 -in /etc/efikeys/MOK.der -inform DER -outform PEM -out /etc/efikeys/MOK.pem


		echo -e "\e[32mINFO:\e[0mSign all .efi in /boot/efi/EFI"
		find /boot/efi/EFI -type f -name '*.efi' -exec bash -c '
		    sbsign --key /etc/efikeys/MOK.key \
		           --cert /etc/efikeys/MOK.pem \
		           "$1" --output "$1.signed" &&
		    mv -f "$1.signed" "$1"
		' bash {} \;

		echo -e "\e[32mINFO:\e[0mSign all kernel"
		find /boot/vmlinuz -type f -name 'vmlinuz*' -exec bash -c '
		    sbsign --key /etc/efikeys/MOK.key \
		           --cert /etc/efikeys/MOK.pem \
		           "$1" --output "$1.signed" &&
		    mv -f "$1.signed" "$1"
		' bash {} \;

		
		
	elif [[ $secure_boot_status = "setup" ]]; then
		echo -e "\e[32mINFO:\e[0mInstalling sbctl and enroll a new Machine Owner Platform key"
		
		apt install -y asciidoc-base pkgconf pkgconf-bin curl jq libpcsclite-dev libpcsclite1 golang-go sbsigntool
		if [[ $pre_download = "no" ]]; then
			go install github.com/foxboron/sbctl/cmd/sbctl@latest
		fi
		mv -f ~/go/bin/sbctl /usr/sbin/
		
		sbctl create-keys
		sbctl enroll-keys --microsoft
		sbctl status
		#sbctl setup --migrate
	
		echo -e "\e[32mINFO:\e[0mSign all .efi in /boot/efi/EFI"
		find /boot/efi/EFI -type f -name '*.efi' -exec sudo sbctl sign '{}' \;
		echo -e "\e[32mINFO:\e[0mSign all kernel"
		find /boot -type f -name 'vm*' -exec sudo sbctl sign -s '{}' \;
	fi

	cd /


	
}

setup_tpm_luks_auto_ulock(){
	echo -e "\e[32mINFO:\e[0mSetup TPM unlock..."
	root_uuid="$(blkid --output export /dev/"$root_dev" | grep ^UUID=)"

	apt install -y tpm2-tools tpm2-tss libtss2-esys-3.0.2-0t64 libtss2-mu-4.0.1-0t64 libtss2-rc0t64 libtss2-tcti-tabrmd0
	
	echo "root $root_uuid none tpm2-device=auto,tpm2-measure-pcr=yes,discard,no-read-workqueue,no-write-workqueue,nofail" > /etc/crypttab
	echo 'add_dracutmodules+=" tpm2-tss crypt "' > /etc/dracut.conf.d/crypt.conf
	dracut --regenerate-all --force -v

	cd /    
}

seal_luks_disk_tpm_unlock_to_secure_boot(){
	echo -e "\e[32mINFO:\e[0mSeal $root_dev to tpm device"
	systemd-cryptenroll --wipe-slot=tpm2 /dev/$root_dev || /bin/true
	systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs="7:sha256+11:sha256+14:sha256" /dev/$root_dev 
	
	
	cd ~
	if [[ -f /boot/efi/EFI/ubuntu/sealed.tpm ]]; then
		
		rm /boot/efi/EFI/ubuntu/sealed.tpm
		grub-protect --action=add --protector=tpm2  --tpm2key --tpm2-keyfile=/etc/luks-key/luks-key-grub --tpm2-outfile=/boot/efi/EFI/ubuntu/sealed.tpm --tpm2-pcrs=7
	else
		mkdir /etc/luks-key
		dd if=/dev/urandom of=/etc/luks-key/luks-key-grub bs=1 count=32
		chmod 0400 /etc/luks-key/luks-key-grub
		cryptsetup luksAddKey /dev/$root_dev /etc/luks-key/luks-key-grub --pbkdf=pbkdf2 --hash=sha512
		grub-protect --action=add --protector=tpm2  --tpm2key --tpm2-keyfile=/etc/luks-key/luks-key-grub --tpm2-outfile=/boot/efi/EFI/ubuntu/sealed.tpm --tpm2-pcrs=7
	fi

	cd /

	#echo "test" | cryptsetup luksDump /dev/sda2 --debug 2>&1 | grep -i token
}

