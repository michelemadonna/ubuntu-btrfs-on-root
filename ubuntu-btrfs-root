preparation() {
	echo -e "\e[32mINFO:\e[0mPrepare"
	
	umount /target/boot/efi
	if [[ -n $boot_dev ]]; then
		umount /target/boot
	fi
	umount /target/cdrom
	umount /target

	mkdir $mp
}

create_subvols() {
	
	echo -e "\e[32mINFO:\e[0mCreate subvolumes"
	mount /dev/$root_dev $mp
	cd $mp
	btrfs subvolume snapshot . $root_sub_vol
	
	btrfs subvolume create $root_sub_vol/@home
	mv $root_sub_vol/home/* $root_sub_vol/@home
	btrfs subvolume create $root_sub_vol/@cache
	mv $root_sub_vol/var/cache/* $root_sub_vol/@cache
	
	btrfs subvolume create $root_sub_vol/@log
	mv $root_sub_vol/var/log/* $root_sub_vol/@log
	btrfs subvolume create $root_sub_vol/@tmp
	btrfs subvolume create $root_sub_vol/@libvirt
	
	btrfs subvolume create $root_sub_vol/@swap
	btrfs filesystem mkswapfile --size $swap_zize $root_sub_vol/@swap/swapfile
	find . -maxdepth 1 ! -name "@*" ! -name . -exec rm -Rf {} \;
	cd /
	umount $mp
	echo -e "\e[32mINFO:\e[0mMount @ instead of /"
	mount /dev/$root_dev -o subvol=$root_sub_vol $mp
}

encrypt_and_enlarge() {

	echo -e "\e[32mINFO:\e[0mEncrypt $root_dev..."
	btrfs filesystem resize -"${keyslot_size}" $mp
	cd /
	umount $mp
	disk="$(lsblk --noheadings --output pkname /dev/$root_dev)"
	partition_number="$(lsblk --noheadings --output partn /dev/$root_dev | tr -d "[:space:]")"
	echo 'You may ignore “Warning: keyslot operation could fail …”.'
	echo 'See <https://gitlab.com/cryptsetup/cryptsetup/-/issues/896>.'
	#cryptsetup reencrypt --encrypt --type luks2 --pbkdf pbkdf2 --pbkdf-force-iterations 500000 --reduce-device-size "$keyslot_size" /dev/$root_dev
	echo "${PASSPHRASE}" | cryptsetup reencrypt --encrypt --type luks2 --pbkdf argon2id --iter-time 2000 --reduce-device-size "$keyslot_size" /dev/$root_dev
	#--pbkdf argon2id --iter-time 2000 
	if [[ $enlarge = "yes" ]]; then
		echo "Enlarge $root_dev"
		parted --script /dev/"$disk" resizepart "$partition_number" "100%"
	fi
	echo "${PASSPHRASE}" | cryptsetup open /dev/$root_dev root
	mount /dev/mapper/root -o subvol=$root_sub_vol $mp
	btrfs filesystem resize max $mp
}

prepare_chroot() {
	echo -e "\e[32mINFO:\e[0mPrepare $mp for chroot"  
	mount -t proc proc $mp/proc
	mount -t sysfs sys $mp/sys
	mount --bind /dev $mp/dev
	mount -t devpts pts $mp/dev/pts
	mount --bind /run $mp/run
#
	if [[ -n $boot_dev ]]; then
	   mount "/dev/$boot_dev" $mp/boot
	fi   
	
	mount /dev/$efi_dev $mp/boot/efi
	mkdir -p /mnt/root/sys/firmware/efi/efivars && mount --bind /sys/firmware/efi/efivars /mnt/root/sys/firmware/efi/efivars
}

chroot_and_mkinitramfs() {
	cp "$script" "$mp/usr/bin/$scriptname"
	chmod a+x "$mp/usr/bin/$scriptname"
	echo -e "\e[32mINFO:\e[0mChrooting and call the script in the other root"
	unshare --mount --fork chroot $mp "$scriptname" //inner
}

unmount_everything() {
	echo -e "\e[32mINFO:\e[0mUnmounting..."    
	cd /
	findmnt -R $mp  
	for dir in sys/firmware/efi/efivars dev/pts proc sys dev run boot/efi; do
		umount $mp/$dir
	done
	if [[ -n $boot_dev ]]; then
		umount $mp/boot
	fi
	umount "$mp"    
	if [[ $only_subvols = "no" ]]; then
		sleep 2
		cryptsetup close root
	fi
}

setup_snapper(){
	echo -e "\e[32mINFO:\e[0mInstall Snapper..."
	
	cd /
	apt install -y snapper inotify-tools 
	dbus-daemon --system --fork
	snapper -c root create-config /
	
	snapper -c root set-config 'TIMELINE_CREATE=yes'
	snapper -c root set-config 'ALLOW_GROUPS=sudo'
	snapper -c root set-config 'SYNC_ACL=yes'
	
	mount -o subvol=$root_sub_vol/@home /dev/mapper/root /home
	snapper -c home create-config /home
	
	snapper -c home set-config 'TIMELINE_CREATE=yes'
	snapper -c home set-config 'ALLOW_GROUPS=sudo'
	snapper -c home set-config 'SYNC_ACL=yes'   
	
	echo 'add_dracutmodules+=" overlayfs "' | tee /etc/dracut.conf.d/overlayfs.conf
	dracut -H --hostonly-mode=sloppy --add overlayfs --force
		
	apt-get -qq --no-install-recommends --yes install btrfs-assistant btrfsmaintenance
	
	
	cd ~
}

setup_fstab(){
	echo -e "\e[32mINFO:\e[0mPatch /etc/fstab"
	
	root_uuid="$(blkid --output export /dev/$root_dev | grep ^UUID=)"   
	
	sed --in-place \
		"s|^.* / btrfs defaults 0 1\$!$root_uuid / btrfs ${btrfs_options},subvol=${root_sub_vol} 0 1|" \
		/etc/fstab  
	
	cat >> /etc/fstab <<- EOF
		$root_uuid /home              btrfs $btrfs_options,subvol=$root_sub_vol/@home 0 2
		$root_uuid /var/log           btrfs $btrfs_options,subvol=$root_sub_vol/@log 0 0 
		$root_uuid /var/cache         btrfs $btrfs_options,subvol=$root_sub_vol/@cache 0 0
		$root_uuid /tmp               btrfs $btrfs_options,subvol=$root_sub_vol/@tmp 0 0
		$root_uuid /var/lib/libvirt/  btrfs defaults,ssd,discard=async,noatime,space_cache=v2,subvol=$root_sub_vol/@libvirt 0 0
		$root_uuid /swap              btrfs defaults,subvol=$root_sub_vol/@swap 0 0
		/swap/swapfile   none         swap  defaults,ssd,discard=async,noatime 0 0  
	EOF

	update-initramfs -u    
}

setup_fstab_crpttab(){
	echo -e "\e[32mINFO:\e[0mPatch /etc/fstab"
	
	root_uuid="$(blkid --output export /dev/$root_dev | grep ^UUID=)"
	
	sed -i \
		"s|^.* / btrfs defaults 0 1\$|/dev/mapper/root / btrfs ${btrfs_options},subvol=${root_sub_vol} 0 1|" \
		/etc/fstab  
	
	cat >> /etc/fstab <<- EOF
		/dev/mapper/root /home              btrfs $btrfs_options,subvol=$root_sub_vol/@home 0 2
		/dev/mapper/root /var/log           btrfs $btrfs_options,subvol=$root_sub_vol/@log 0 0 
		/dev/mapper/root /var/cache         btrfs $btrfs_options,subvol=$root_sub_vol/@cache 0 0
		/dev/mapper/root /tmp               btrfs $btrfs_options,subvol=$root_sub_vol/@tmp 0 0
		/dev/mapper/root /var/lib/libvirt/  btrfs defaults,ssd,discard=async,noatime,space_cache=v2,subvol=$root_sub_vol/@libvirt 0 0
		/dev/mapper/root /swap              btrfs defaults,subvol=$root_sub_vol/@swap 0 0
		/swap/swapfile   none               swap  defaults,ssd,discard=async,noatime 0 0    
	EOF
	
	echo "root $root_uuid none luks,discard,nofail" > /etc/crypttab 

	apt-get install -y cryptsetup-initramfs

}

secureboot_state() {
	local state

	command -v mokutil >/dev/null 2>&1 || {
		echo "unknown"
		return 1
	}

	state="$(mokutil --sb-state 2>/dev/null)"

	if grep -qi "Platform is in Setup Mode" <<<"$state"; then
		echo "setup"
	elif grep -qi "SecureBoot enabled" <<<"$state"; then
		echo "enabled"
	elif grep -qi "SecureBoot disabled" <<<"$state"; then
		echo "disabled"
	else
		echo "unknown"
		return 1
	fi
}

setup_refind(){
