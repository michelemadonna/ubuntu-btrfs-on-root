seal_luks_disk_tpm_unlock_to_secure_boot(){
    echo "Seal $root_dev to tpm device"
    systemd-cryptenroll --wipe-slot=tpm2 /dev/$root_dev || /bin/true
    systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs="7:sha256+11:sha256+14:sha256" /dev/$root_dev 
    
    dd if=/dev/urandom of=luks-key bs=1 count=32
    cryptsetup luksAddKey /dev/sda2 luks-key --pbkdf=pbkdf2 --hash=sha512
    grub-protect --action=add --protector=tpm2  --tpm2key --tpm2-keyfile=luks-key --tpm2-outfile=/boot/efi/EFI/ubuntu/sealed.tpm --tpm2-pcrs=7
    
    #0x44496EEE724BCA1918B962936EE20AB201423EF20B8C606507DE2C00415786237FBF4DC200A35BE5EA0C08BB1550B5B55D2E6659587B5614CEBF3551943F5668
    #echo "test" | cryptsetup luksDump /dev/sda2 --debug 2>&1 | grep -i token
}

setup_tpm_luks_auto_ulock_with_pin(){
    
    apt install -y tpm2-tools tpm2-tss libtss2-esys-3.0.2-0t64 libtss2-mu-4.0.1-0t64 libtss2-rc0t64 libtss2-tcti-tabrmd0
    root_uuid="$(blkid --output export /dev/"$root_dev" | grep ^UUID=)"

    systemd-cryptenroll --wipe-slot=tpm2 /dev/$root_dev || /bin/true
    systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs="7:sha256+11:sha256+14:sha256" --tpm2-with-pin=true /dev/$root_dev
    echo "root $root_uuid none tpm2-device=auto,tpm2-pin=yes,tpm2-measure-pcr=yes,discard,no-read-workqueue,no-write-workqueue,nofail" > /etc/crypttab
    echo 'add_dracutmodules+=" tpm2-tss crypt "' > /etc/dracut.conf.d/crypt.conf
    dracut --regenerate-all --force -v
}



