setup_grub_btrfs_snapshot_menu(){
	echo "Setup grub-btrfs"

	apt install -y gawk git make
	


	mkdir -p /opt/grub-btrfs
	cd /opt/grub-btrfs
	git clone https://github.com/Antynea/grub-btrfs.git .
	make install

	systemctl enable grub-btrfsd.service

	cat >> /etc/default/grub-btrfs/config <<- EOF
		GRUB_BTRFS_MKCONFIG_LIB=/usr/share/grub/grub-mkconfig_lib
		GRUB_BTRFS_GRUB_DIRNAME=/boot/grub
		GRUB_BTRFS_GBTRFS_DIRNAME=/boot/grub
		GRUB_BTRFS_MKCONFIG=grub-mkconfig
		GRUB_BTRFS_SCRIPT_CHECK=grub-script-check
		GRUB_BTRFS_ENABLE_CRYPTODISK="true"
		GRUB_BTRFS_SNAPSHOT_KERNEL_PARAMETERS="rd.live.overlay.overlayfs=1"
		GRUB_BTRFS_SYSTEMD_VOLATILE="true"
	EOF

	cd ~

}

setup_refind_btrfs_sanpshot_menu(){
	echo "Setup REFInd menu for snapshot entry."

	apt install asciidoc-base pkgconf pkgconf-bin curl jq libpcsclite-dev libpcsclite1 golang-go git
	
	git clone https://github.com/jmylchreest/refind-btrfs-snapshots.git
	cd refind-btrfs-snapshots
	go build -o refind-btrfs-snapshots ./cmd/refind-btrfs-snapshots
	cp refind-btrfs-snapshots /usr/bin/
	cp configs/refind-btrfs-snapshots.yaml /etc/refind-btrfs-snapshots.yaml
	cp systemd/*.{service,path} /etc/systemd/system/
	
	refind-btrfs-snapshots generate -g -y
	
	systemctl enable --now refind-btrfs-snapshots.path
	
	echo "include refind-btrfs-snapshots.conf" >> /boot/efi/EFI/refind.conf
	   
}

setup_custom_secure_boot_key(){
	
	if [[ $secure_boot_status = "enabled" ]]; then
	
		echo "Enroll a new Machine Owner Platform key using mokutil"
		mkdir -p /etc/efikeys/
		
		openssl req -new -x509 -newkey rsa:2048 -outform DER -keyout /etc/efikeys/MOK.key -out /etc/efikeys/MOK.der \
		  -nodes -days 3650 -subj "/CN=My MOK/"
		chmod 400 MOK.key
	
		mokutil --import /etc/efikeys/MOK.der
	
		openssl x509 -in /etc/efikeys/MOK.der -inform DER -outform PEM -out /etc/efikeys/MOK.pem


		echo "Sign all .efi in /boot/efi/EFI"
		find /boot/efi/EFI -type f -name '*.efi' -exec bash -c '
		    sbsign --key /etc/efikeys/MOK.key \
		           --cert /etc/efikeys/MOK.pem \
		           "$1" --output "$1.signed" &&
		    mv -f "$1.signed" "$1"
		' bash {} \;

		echo "Sign all kernel"
		find /boot/vmlinuz -type f -name 'vmlinuz*' -exec bash -c '
		    sbsign --key /etc/efikeys/MOK.key \
		           --cert /etc/efikeys/MOK.pem \
		           "$1" --output "$1.signed" &&
		    mv -f "$1.signed" "$1"
		' bash {} \;

		
		
	elif [[ $secure_boot_status = "setup" ]]; then
		echo "Installing sbctl and enroll a new Machine Owner Platform key"
		
		apt install -y asciidoc-base pkgconf pkgconf-bin curl jq libpcsclite-dev libpcsclite1 golang-go sbsigntool
		go install github.com/foxboron/sbctl/cmd/sbctl@latest
		mv -f ~/go/bin/sbctl /usr/sbin/
		
		sbctl create-keys
		sbctl enroll-keys --microsoft
		sbctl status
	
		echo "Sign all .efi in /boot/efi/EFI"
		find /boot/efi/EFI -type f -name '*.efi' -exec sudo sbctl sign '{}' \;
		echo "Sign all kernel"
		find /boot -type f -name 'vm*' -exec sudo sbctl sign -s '{}' \;
	fi

	cd ~


	
}

