preparation() {
	echo "Prepare"
	
	umount /target/boot/efi
	if [[ -n $boot_dev ]]; then
		umount /target/boot
	fi
	umount /target/cdrom
	umount /target

	mkdir $mp
}

create_subvols() {
	
	echo "Create subvolumes"
	mount /dev/$root_dev $mp
	cd $mp
	btrfs subvolume snapshot . @
	
	btrfs subvolume create @home
	mv @/home/* @home/
	btrfs subvolume create @cache
	mv @/var/cache/* @cache/
	
	btrfs subvolume create @log
	mv @/var/log/* @log/
	btrfs subvolume create @tmp
	btrfs subvolume create @libvirt
	
	btrfs subvolume create @swap
	btrfs filesystem mkswapfile --size $swap_zize @swap/swapfile
	find . -maxdepth 1 ! -name "@*" ! -name . -exec rm -Rf {} \;
	cd /
	umount $mp
	echo "Mount @ instead of /"
	mount /dev/$root_dev -o subvol=@ $mp
}

encrypt_and_enlarge() {

	echo "Encrypt $root_dev..."
	btrfs filesystem resize -"${keyslot_size}" $mp
	cd /
	umount $mp
	disk="$(lsblk --noheadings --output pkname /dev/$root_dev)"
	partition_number="$(lsblk --noheadings --output partn /dev/$root_dev | tr -d "[:space:]")"
	echo 'You may ignore “Warning: keyslot operation could fail …”.'
	echo 'See <https://gitlab.com/cryptsetup/cryptsetup/-/issues/896>.'
	#cryptsetup reencrypt --encrypt --type luks2 --pbkdf pbkdf2 --pbkdf-force-iterations 500000 --reduce-device-size "$keyslot_size" /dev/$root_dev
	cryptsetup reencrypt --encrypt --type luks2 --pbkdf argon2id --iter-time 2000 --reduce-device-size "$keyslot_size" /dev/$root_dev
	#--pbkdf argon2id --iter-time 2000 
	if [[ $enlarge = "yes" ]]; then
		echo "Enlarge $root_dev"
		parted --script /dev/"$disk" resizepart "$partition_number" "100%"
	fi
	cryptsetup open /dev/$root_dev root
	mount /dev/mapper/root -o subvol=@ $mp
	btrfs filesystem resize max $mp
}

chroot_and_mkinitramfs() {
	echo "Prepare $mp for chroot"  
	mount -t proc proc $mp/proc
	mount -t sysfs sys $mp/sys
	mount --bind /dev $mp/dev
	mount -t devpts pts $mp/dev/pts
	mount --bind /run $mp/run
#
	if [[ -n $boot_dev ]]; then
	   mount "/dev/$boot_dev" $mp/boot
	fi   
	
	mount /dev/$efi_dev $mp/boot/efi
	mkdir -p /mnt/root/sys/firmware/efi/efivars && mount --bind /sys/firmware/efi/efivars /mnt/root/sys/firmware/efi/efivars   
	
	cp "$script" "$mp/tmp/$scriptname"
	chmod a+x "$mp/tmp/$scriptname"
	echo "Chrooting and call the script in the other root"
	unshare --mount --fork chroot $mp /tmp/"$scriptname" //inner
}

unmount_everything() {
	echo "Unmounting..."    
	cd /
	findmnt -R $mp  
	for dir in sys/firmware/efi/efivars dev/pts proc sys dev run boot/efi; do
		umount $mp/$dir
	done
	if [[ -n $boot_dev ]]; then
		umount $mp/boot
	fi
	umount "$mp"    
	if [[ $only_subvols = "no" ]]; then
		sleep 2
		cryptsetup close root
	fi
}

setup_snapper(){
	echo "Install Snapper..."
	
	cd /
	apt install -y snapper inotify-tools 
	dbus-daemon --system --fork
	snapper -c root create-config /
	
	snapper -c root set-config 'TIMELINE_CREATE=yes'
	snapper -c root set-config 'ALLOW_GROUPS=sudo'
	snapper -c root set-config 'SYNC_ACL=yes'
	
	mount -o subvol=@home /dev/mapper/root /home
	snapper -c home create-config /home
	
	snapper -c home set-config 'TIMELINE_CREATE=yes'
	snapper -c home set-config 'ALLOW_GROUPS=sudo'
	snapper -c home set-config 'SYNC_ACL=yes'   
	
	echo 'add_dracutmodules+=" overlayfs "' | tee /etc/dracut.conf.d/overlayfs.conf
	dracut -H --hostonly-mode=sloppy --add overlayfs --force
		
	apt-get -qq --no-install-recommends --yes install btrfs-assistant btrfsmaintenance
	
	
	cd ~
}

setup_fstab(){
	echo "Patch /etc/fstab"
	
	root_uuid="$(blkid --output export /dev/$root_dev | grep ^UUID=)"   
	
	sed --in-place \
		"s!^.* / btrfs defaults 0 1\$!$root_uuid / btrfs defaults,ssd,discard=async,noatime,space_cache=v2,compress=zstd:1,subvol=@ 0 1!" \
		/etc/fstab  
	
	cat >> /etc/fstab <<- EOF
		$root_uuid /home              btrfs defaults,ssd,discard=async,noatime,space_cache=v2,compress=zstd:1,subvol=@home 0 2
		$root_uuid /var/log           btrfs defaults,ssd,discard=async,noatime,space_cache=v2,compress=zstd:1,subvol=@log 0 0 
		$root_uuid /var/cache         btrfs defaults,ssd,discard=async,noatime,space_cache=v2,compress=zstd:1,subvol=@cache 0 0
		$root_uuid /tmp               btrfs defaults,ssd,discard=async,noatime,space_cache=v2,compress=zstd:1,subvol=@tmp 0 0
		$root_uuid /var/lib/libvirt/  btrfs defaults,ssd,discard=async,noatime,space_cache=v2,subvol=@libvirt 0 0
		$root_uuid /swap              btrfs defaults,subvol=@swap 0 0
		/swap/swapfile   none         swap  defaults,ssd,discard=async,noatime 0 0  
	EOF

	update-initramfs -u    
}

