				else
				  search --no-floppy --fs-uuid --set=root $root_btrfs_uuid
				fi
				linux   /$root_sub_vol/boot/vmlinuz root=UUID=$root_btrfs_uuid ro rootflags=defaults,ssd,discard=async,noatime,space_cache=v2,compress=zstd:1,subvol=$root_sub_vol  quiet splash crashkernel=2G-4G:320M,4G-32G:512M,32G-64G:1024M,64G-128G:2048M,128G-:4096M
				initrd  /$root_sub_vol/boot/initrd.img

				boot
			EOF
		fi

		apt-mark hold grub-common \
                   grub2-common \
                   grub-pc \
                   grub-pc-bin \
                   grub-efi-amd64 \
                   grub-efi-amd64-bin \
