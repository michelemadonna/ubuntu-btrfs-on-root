preparation() {
    echo "Prepare"

    
    umount /target/boot/efi
    if [ -n "$boot_dev" ]; then
        umount /target/boot
    fi
    umount /target/cdrom
    umount /target

    mkdir "$mp"
}

create_subvols() {
    

    echo "Create subvolumes"
    mount "/dev/$root_dev" "$mp"

    cd "$mp"

    btrfs subvolume snapshot . @
    
    btrfs subvolume create @home
    mv @/home/* @home/

    btrfs subvolume create @cache
    mv @/var/cache/* @cache/
    
    btrfs subvolume create @log
    mv @/var/log/* @log/

    btrfs subvolume create @tmp
    btrfs subvolume create @libvirt
    
    btrfs subvolume create @swap
    btrfs filesystem mkswapfile --size 4G @swap/swapfile 

    find -maxdepth 1 ! -name "@*" ! -name . -exec rm -Rf {} \;


    cd /
    umount "$mp"

    echo "Mount @ instead of /"
    mount "/dev/$root_dev" -o subvol=@ "$mp"
}

encrypt_and_enlarge() {

    echo "Encrypt $root_dev"

    btrfs filesystem resize -"${keyslot_size}" "$mp"
    cd /
    umount "$mp"

    disk="$(lsblk --noheadings --output pkname "/dev/$root_dev")"
    partition_number="$(lsblk --noheadings --output partn "/dev/$root_dev" | tr -d "[:space:]")"

    echo 'You may ignore “Warning: keyslot operation could fail …”.'
    echo 'See <https://gitlab.com/cryptsetup/cryptsetup/-/issues/896>.'

    cryptsetup reencrypt --encrypt --type luks2 --pbkdf pbkdf2 --pbkdf-force-iterations 500000 --reduce-device-size "$keyslot_size" "/dev/$root_dev"

    if [ "$enlarge" = yes ]; then
        echo "Enlarge $root_dev"
        parted --script "/dev/$disk" resizepart "$partition_number" "100%"
    fi

    cryptsetup open "/dev/$root_dev" root
    mount /dev/mapper/root -o subvol=@ "$mp"

    btrfs filesystem resize max "$mp"
}

chroot_and_mkinitramfs() {
    echo "Prepare $mp for chroot"

    ##mkdir -p /mnt/root/run/dbus && mount --bind /run/dbus "$mp/run/dbus"
    #mkdir -p /mnt/root/etc/ && cp /run/systemd/resolve/resolv.conf /mnt/root/etc/resolv.conf && #mount --bind /run/systemd/resolve/resolv.conf "$mp/etc/resolv.conf"

    mount -t proc proc "$mp/proc"
    mount -t sysfs sys "$mp/sys"
    mount --bind /dev "$mp/dev"
    mount -t devpts pts "$mp/dev/pts"
    mount --bind /run "$mp/run"
    if [ -n "$boot_dev" ]; then
        mount "/dev/$boot_dev" "$mp/boot" #
    fi   
   
    mount "/dev/$efi_dev" "$mp/boot/efi"
    mkdir -p /mnt/root/sys/firmware/efi/efivars && mount --bind /sys/firmware/efi/efivars /mnt/root/sys/firmware/efi/efivars

     

    cp "$script" "$mp/tmp/$scriptname"
    chmod a+x "$mp/tmp/$scriptname"

    echo "Chrooting and call the script in the other root"
    unshare --mount --fork chroot "$mp" #/tmp/"$scriptname" //inner "$only_subvols" "$root_dev"
}

unmount_everything() {
    echo "Unmounting"

    cd /
    findmnt -R "$mp"

    for dir in sys/firmware/efi/efivars dev/pts proc sys dev run boot/efi; do
        umount "$mp/$dir"
    done
    if [ -n "$boot_dev" ]; then
        umount -l "$mp/boot"
    fi
    umount "$mp"

    if [ "$only_subvols" = no ]; then
        cryptsetup close root
    fi
}

