if [[ "$1" = "//inner" ]]; then
	if [[ $pre_download = "yes" ]]; then
		pre_download_all
	fi
	    
	
	setup_snapper
	secure_boot_status=$(secureboot_state)

	echo -e "\e[32mINFO:\e[0mSecure Boot is " "$secure_boot_status"
	
	if [[ -n $boot_dev ]]; then
		echo -e "\e[32mINFO:\e[0mConfig Boot partition separated"
		e2label /dev/"$boot_dev" "BOOT_UBUNTU"
		
		if [[ $only_subvols  = "yes" ]]; then
			 echo -e "\e[32mINFO:\e[0mConfig NON Encrypt"
			setup_fstab
			if [[ $secure_boot_status = "enabled" ]]; then
				echo -e "\e[32mINFO:\e[0mSecure Boot enabled"
				#if secure boot is enabled and not in setup mode (we can't enroll new MOK) only Ubuntu signed grub/kernel can be used
				echo -e "\e[32mINFO:\e[0mInstall $bootloader"
				setup_grub             
			elif [[ $secure_boot_status = "setup" ]]; then
				echo -e "\e[32mINFO:\e[0mSecure Boot in Setup Mode"
				echo -e "\e[32mINFO:\e[0mInstall $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub
				elif [[ $bootloader = "refind" ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi
				setup_custom_secure_boot_key
			else
				echo -e "\e[32mINFO:\e[0mSecure Boot Disabled"
				echo -e "\e[32mINFO:\e[0mInstall $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub                  
				elif [[ $bootloader = ""refind ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi
			fi
		else
			echo -e "\e[32mINFO:\e[0mConfig Encrypt"
			setup_fstab_crpttab
			if [[ "$secure_boot_status" = enabled ]]; then
				echo -e "\e[32mINFO:\e[0mSecure Boot enabled"
				#if secure boot is enabled and not in setup mode (we can't enroll new MOK) only Ubuntu signed grub/kernel can be used
				echo -e "\e[32mINFO:\e[0mInstall $bootloader"
				setup_grub
				
				if [[ $tpm_unlock = yes ]]; then
					setup_tpm_luks_auto_ulock
				fi
			elif [[ "$secure_boot_status" = custom ]]; then
				echo -e "\e[32mINFO:\e[0mSecure Boot in Setup Mode"
				echo -e "\e[32mINFO:\e[0mInstall $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub
				elif [[ $bootloader = "refind" ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi

				if [[ $tpm_unlock = yes ]]; then
					setup_tpm_luks_auto_ulock
				fi

				setup_custom_secure_boot_key
			else
				echo -e "\e[32mINFO:\e[0mSecure Boot Disabled"
				echo -e "\e[32mINFO:\e[0mInstall $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub
				elif [[ $bootloader = "refind" ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi
			fi
		fi
	else
		echo -e "\e[32mINFO:\e[0mConfig Boot partition separated"
		fatlabel /dev/$efi_dev "BOOT_EFI"

		if [[ "$only_subvols" = "yes" ]]; then
			echo -e "\e[32mINFO:\e[0mConfig NON Encrypt"
			setup_fstab
			if [[ "$secure_boot_status" = "enabled" ]]; then
				
				echo -e "\e[32mINFO:\e[0mSecure Boot enabled"
				#if secure boot is enabled and not in setup mode (we can't enroll new MOK) only Ubuntu signed grub/kernel can be used
				setup_custom_secure_boot_key
				echo -e "\e[32mINFO:\e[0mInstall $bootloader"
				setup_grub
				
			elif [[ "$secure_boot_status" = "setup" ]]; then
				echo -e "\e[32mINFO:\e[0mSecure Boot in Setup Mode"
				setup_custom_secure_boot_key
				echo -e "\e[32mINFO:\e[0mInstall $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub
				elif [[ $bootloader = "refind" ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi
				
			else
				echo -e "\e[32mINFO:\e[0mSecure Boot Disabled"
				echo -e "\e[32mINFO:\e[0mInstall $bootloader"
				if [[ $bootloader = "grub" ]]; then
					setup_grub
					
				elif [[ $bootloader = "refind" ]]; then
					setup_refind
					setup_refind_btrfs_sanpshot_menu
				fi
			fi
		else
			echo -e "\e[32mINFO:\e[0mConfig Encrypt"
			setup_fstab_crpttab

			if [[ "$secure_boot_status" = "enabled" ]]; then
				echo -e "\e[32mINFO:\e[0mSecure Boot enabled and not in Setup-Mode.....Aborting"
				exit
			elif [[ "$secure_boot_status" = "setup" ]]; then
				echo -e "\e[32mINFO:\e[0mSecure Boot in Setup Mode"
				setup_custom_secure_boot_key
				echo -e "\e[32mINFO:\e[0mInstall $bootloader"
				
				if [[ $bootloader = "grub" || $bootloader = "grub+refind" ]]; then
					setup_grub
					if [[ $tpm_unlock = yes ]]; then
						setup_tpm_luks_auto_ulock
					fi
				fi
				if [[ $bootloader = "refind" || $bootloader = "grub+refind" ]]; then
					setup_refind

				fi
			else
				echo -e "\e[32mINFO:\e[0mSecure Boot Disabled"
				echo -e "\e[32mINFO:\e[0mInstall $bootloader"

				if [[ $bootloader = "grub" ]]; then
					setup_grub
				elif [[ $bootloader = "refind" ]]; then
					setup_refind
				fi
			fi
		fi
	fi

	suite_selction

	umount proc 2>/dev/null || true
	umount home 2>/dev/null || true


	exit

fi


